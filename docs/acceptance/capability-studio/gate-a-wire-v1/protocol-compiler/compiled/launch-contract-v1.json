{
  "schemaVersion": "capability-studio.gate-a-protocol-projection.v1",
  "projectionId": "LAUNCH_CONTRACT",
  "authorityId": "GATE-A-PROTOCOL-AUTHORITY",
  "authorityRevision": 1,
