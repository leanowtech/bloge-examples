          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Each layer is immutable. Later receipts and signoffs bind earlier commitments; earlier commitments are never rewritten." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#455a64;" vertex="1" parent="1">
