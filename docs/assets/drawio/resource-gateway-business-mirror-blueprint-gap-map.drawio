<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram id="business-mirror-gap-map" name="Business Mirror Blueprint Gap Map">
    <mxGraphModel dx="1920" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Resource Gateway 距离客户业务能力镜像蓝图的差距地图" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1330" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="现有执行、测试和证据内核已成熟；主要断层位于业务主对象、候选能力生命周期、L0-L3 追踪和客户生产事实供给" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1340" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="score_box" value="三种成熟度必须分开看&#xa;技术内核：90-92&#xa;产品蓝图闭环：65-70&#xa;企业生产运行：50-58" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#263238;align=left;spacingLeft=12;" vertex="1" parent="1">
