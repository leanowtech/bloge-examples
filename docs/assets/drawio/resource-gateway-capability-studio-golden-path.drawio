        <mxCell id="2" value="黄金演示：费用争议处理工具，从零依赖到可验证交付" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="业务目标：在不连接订单、计费、支付和城市规则真实接口的情况下，完成特征加工、处理决策和正确性证明" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#486581;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1560" height="30" as="geometry" />
        </mxCell>

        <mxCell id="10" value="业务作者的操作" style="swimlane;startSize=38;horizontal=1;rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#0d47a1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="1560" height="260" as="geometry" />
        </mxCell>
        <mxCell id="11" value="1 选择完整样例&#xa;费用争议处理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
          <mxGeometry x="30" y="80" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="12" value="2 定义 4 个业务接口&#xa;从样例请求与响应生成边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
          <mxGeometry x="250" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="3 准备场景数据&#xa;正常、无异常、边界、超时" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
          <mxGeometry x="480" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="14" value="4 编排费用争议特征&#xa;在 DAG 上连接接口与字段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
          <mxGeometry x="710" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="15" value="5 定义处理工具&#xa;输入、输出、禁行结果和引用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
          <mxGeometry x="940" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="16" value="6 选择场景隔离试跑&#xa;逐边看数据，定位差异" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#102a43;spacing=8;" vertex="1" parent="10">
