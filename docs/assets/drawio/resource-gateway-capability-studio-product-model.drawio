      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Resource Gateway 能力设计工作台：从业务接口到可独立验证的工具" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="一条统一生产线，三类一等资产；场景数据贯穿定义、编排、验证与交付" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#486581;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="10" value="1 业务接口" style="swimlane;startSize=42;horizontal=1;rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0d47a1;container=1;pointerEvents=0;" vertex="1" parent="1">
