        <mxCell id="13" value="隔离试跑&#xa;不连接真实接口也能验证请求匹配与预期响应" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=13;fontColor=#102a43;spacing=10;" vertex="1" parent="10">
