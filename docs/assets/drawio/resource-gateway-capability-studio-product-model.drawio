        </mxCell>
        <mxCell id="12" value="准备可复现的业务表现&#xa;正常返回 · 业务错误 · 超时 · 状态变化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=13;fontColor=#102a43;spacing=10;" vertex="1" parent="10">
