        </mxCell>
        <mxCell id="inv3" value="Failure is not credential invalidity&#xa;Transport outage follows explicit FAIL_CLOSED or bounded stale policy. Invalid, oversized or expired authority documents always fail closed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontColor=#b71c1c;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariants">
