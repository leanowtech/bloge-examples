        <mxCell id="inv2" value="Bounded revocation decision&#xa;Every due authentication refreshes before verification. SLO = refresh interval + request timeout; ETag never widens it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariants">
