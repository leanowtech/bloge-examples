        <mxCell id="inv1" value="Rotation without restart&#xa;Unknown kid triggers one throttled single-flight refresh. Overlapping old/new keys support zero-downtime rollout." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariants">
