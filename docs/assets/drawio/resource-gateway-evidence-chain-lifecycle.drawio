<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram name="Evidence Chain Lifecycle">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Run Evidence Chain of Custody and Lifecycle" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1100" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Every transition is attributable, idempotent, integrity-protected, policy-controlled, and auditable." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#455a64;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="1100" height="30" as="geometry" /></mxCell>

        <mxCell id="s1" value="1. SNAPSHOT_BOUND&#xa;draft + operator + schema fingerprints&#xa;runtime binding version frozen" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="s2" value="2. EXECUTING&#xa;runId + idempotency key&#xa;deadline and cancellation propagated" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="s3" value="3. CAPTURED&#xa;node / edge / request / response facts&#xa;classification attached at source" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#fff9c4;strokeColor=#f57c00;" vertex="1" parent="1"><mxGeometry x="610" y="170" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="s4" value="4. SANITIZED_AND_SEALED&#xa;redaction manifest + content hashes&#xa;signature + immutable manifest" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3e5f5;strokeColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="890" y="170" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="s5" value="5. AVAILABLE&#xa;evidence bundle can be verified&#xa;replay authorization is evaluated" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="220" height="100" as="geometry" /></mxCell>

        <mxCell id="quarantine" value="QUARANTINED&#xa;integrity mismatch / sanitizer failure / policy violation&#xa;not consumable by publish gate" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1"><mxGeometry x="610" y="390" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="expired" value="EXPIRED&#xa;payload deleted, manifest and audit tombstone retained" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#eceff1;strokeColor=#455a64;" vertex="1" parent="1"><mxGeometry x="1190" y="390" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="hold" value="LEGAL_HOLD&#xa;retention freeze is authorized, scoped, and periodically reviewed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#fff3e0;strokeColor=#e65100;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="replay" value="REPLAY_SESSION&#xa;new runId, parentRunId, replay mode&#xa;side effects disabled unless explicitly approved" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="890" y="580" width="300" height="100" as="geometry" /></mxCell>

        <mxCell id="invariant" value="Evidence acceptance invariants" style="swimlane;startSize=32;rounded=0;html=1;fontFamily=Arial;fontSize=13;fontStyle=1;fillColor=#eceff1;strokeColor=#455a64;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="500" height="220" as="geometry" /></mxCell>
        <mxCell id="inv1" value="Identity: tenant, actor, workload and purpose are known" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariant"><mxGeometry x="20" y="45" width="450" height="26" as="geometry" /></mxCell>
        <mxCell id="inv2" value="Integrity: manifest hash and signature verify before consumption" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariant"><mxGeometry x="20" y="78" width="450" height="26" as="geometry" /></mxCell>
        <mxCell id="inv3" value="Completeness: expected node and edge facts have no unexplained gap" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariant"><mxGeometry x="20" y="111" width="450" height="26" as="geometry" /></mxCell>
        <mxCell id="inv4" value="Confidentiality: effective redaction profile and key version are recorded" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariant"><mxGeometry x="20" y="144" width="450" height="26" as="geometry" /></mxCell>
        <mxCell id="inv5" value="Accountability: every read, replay, hold and deletion is audited" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;" vertex="1" parent="invariant"><mxGeometry x="20" y="177" width="450" height="26" as="geometry" /></mxCell>

        <mxCell id="e1" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="runtime facts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="sanitize and seal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#f57c00;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#6a1b9a;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="capture gap / policy failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="s3" target="quarantine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="signature / manifest mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="s4" target="quarantine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="s5" target="replay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="520" /><mxPoint x="1220" y="520" /><mxPoint x="1220" y="630" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="new execution lineage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="replay" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="630" /><mxPoint x="580" y="330" /><mxPoint x="440" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="retention elapsed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="expired"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="authorized hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#e65100;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="340" /><mxPoint x="1040" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#e65100;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hold" target="expired"><mxGeometry relative="1" as="geometry" /></mxCell>
