        <mxCell id="e-freeze-fingerprint" value="canonical material" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2e7d32;fontColor=#1b5e20;fontFamily=Arial;fontSize=9;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="asset-freezer" target="fingerprint">
          <mxGeometry relative="1" as="geometry"/>
