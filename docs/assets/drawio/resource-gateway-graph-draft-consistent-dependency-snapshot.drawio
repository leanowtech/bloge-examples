        <mxCell id="e-compare-conflict" value="different" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c62828;fontColor=#b71c1c;fontFamily=Arial;fontSize=9;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="compare" target="conflict">
