          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="630"/><mxPoint x="1025" y="630"/><mxPoint x="1025" y="265"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-reread-compare" value="before / after" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e65100;fontColor=#bf360c;fontFamily=Arial;fontSize=9;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reread" target="compare">
