        <mxCell id="e-fingerprint-candidate" value="frozen profile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f57c00;fontColor=#e65100;fontFamily=Arial;fontSize=9;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fingerprint" target="candidate">
          <mxGeometry relative="1" as="geometry"/>
