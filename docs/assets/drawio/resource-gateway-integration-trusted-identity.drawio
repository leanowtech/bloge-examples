<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="30.0.4">
  <diagram name="Trusted Identity" id="trusted-identity">
    <mxGraphModel dx="1400" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Resource Gateway Integration 受信身份与纵深授权" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="短时 signed JWT 建立服务端 claims · 多 kid 轮换与 key/jti 撤销 · operation、purpose 与资源 scope 分层校验" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#455a64;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1250" height="30" as="geometry" />
        </mxCell>

        <mxCell id="callerLane" value="1  ANEKE Tool Studio 请求侧" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontFamily=Arial;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="280" height="500" as="geometry" />
        </mxCell>
        <mxCell id="request" value="Integration Request&#xa;Authorization: Bearer signed-JWT&#xa;X-Purpose + correlationId" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="callerLane">
          <mxGeometry x="30" y="60" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hints" value="迁移期 Claim Hints&#xa;X-Tenant / Organization / Project&#xa;Environment / Actor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;" vertex="1" parent="callerLane">
          <mxGeometry x="30" y="200" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="denied" value="稳定拒绝响应&#xa;401 未认证 · 403 越权/冲突&#xa;不泄漏 token 或跨租户对象" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;" vertex="1" parent="callerLane">
          <mxGeometry x="30" y="370" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="trustLane" value="2  Resource Gateway 身份信任边界" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="authenticator" value="IntegrationRequestAuthenticator&#xa;解析 Bearer，限制长度，统一 401/403&#xa;认证决定必须先写安全审计" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="trustLane">
          <mxGeometry x="150" y="55" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resolver" value="SignedJwt Identity Resolver&#xa;RS256 / EdDSA 严格验签&#xa;iss + aud + iat/nbf/exp + 最大 TTL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;" vertex="1" parent="trustLane">
          <mxGeometry x="40" y="190" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="Operation × Purpose Policy&#xa;身份 allowlist + endpoint allowlist&#xa;claim hint 冲突即拒绝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="trustLane">
          <mxGeometry x="310" y="190" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="identitySource" value="JWT Trust Store SPI&#xa;多 public key / kid 轮换窗口&#xa;key + jti 撤销 / 生效与失效时间&#xa;可替换 JWKS / KMS；静态 Bearer 仅 demo" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;" vertex="1" parent="trustLane">
          <mxGeometry x="40" y="340" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="auditStore" value="Integration Access Audit&#xa;ALLOWED / DENIED + reason&#xa;identity / scope / operation / purpose&#xa;kid + jti；永不保存原始 JWT" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;" vertex="1" parent="trustLane">
          <mxGeometry x="310" y="340" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="serviceLane" value="3  业务事实与资源授权" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="360" height="500" as="geometry" />
        </mxCell>
        <mxCell id="trustedContext" value="IntegrationRequestContext&#xa;tenant / org / project / environment&#xa;actor / delegatedBy / purpose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="serviceLane">
          <mxGeometry x="50" y="60" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="service" value="Tool Studio Integration Services&#xa;export · evidence · replay · gate&#xa;change feed · reconciliation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;" vertex="1" parent="serviceLane">
          <mxGeometry x="50" y="200" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="repository" value="Repository Scope Predicate&#xa;tenant + environment + immutable revision&#xa;未授权对象统一 not found" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=11;" vertex="1" parent="serviceLane">
          <mxGeometry x="50" y="340" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="principles" value="纵深原则" style="swimlane;startSize=32;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontFamily=Arial;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1300" height="100" as="geometry" />
