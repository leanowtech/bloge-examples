        <mxCell id="p1" value="弱 key / alg 替换 / JSON 歧义一律拒绝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=11;" vertex="1" parent="principles">
          <mxGeometry x="30" y="45" width="260" height="35" as="geometry" />
