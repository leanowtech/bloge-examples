        <mxCell id="p4" value="审计可关联 kid/jti，但不含 secret/token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;" vertex="1" parent="principles">
          <mxGeometry x="980" y="45" width="260" height="35" as="geometry" />
