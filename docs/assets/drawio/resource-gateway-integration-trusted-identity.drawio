        <mxCell id="p2" value="请求 purpose 必须双重 allowlist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=11;" vertex="1" parent="principles">
          <mxGeometry x="340" y="45" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Service 与 Repository 再做 scope 校验" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;" vertex="1" parent="principles">
          <mxGeometry x="650" y="45" width="280" height="35" as="geometry" />
