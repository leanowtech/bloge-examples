<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.8">
  <diagram name="Remediation command closed loop">
    <mxGraphModel dx="1500" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="“处理首个阻断”必须是一条可观察、可完成、可回归的命令" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="禁止只切换 Sheet；即使目标就在当前 Sheet，也必须聚焦控件、打开动作或明确解释为何不能继续" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="30" as="geometry" />
        </mxCell>

        <mxCell id="gap" value="Readiness Gap&#xa;code + fieldPath + severity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="descriptor" value="Remediation Descriptor&#xa;task + anchor + actionKind&#xa;completionPredicate + fallback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="动作类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="730" y="125" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="local" value="当前/其他步骤内动作&#xa;切换 task + 滚动 + 聚焦&#xa;高亮字段或打开 Picker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="200" y="330" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cross" value="跨工作区动作&#xa;Exact Deep Link Resolver&#xa;Author / Rehearsal / Correctness / ANEKE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="能力不可用或无权限&#xa;显示原因、所需 capability&#xa;提供安全 fallback；绝不无响应" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="1000" y="330" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="feedback" value="可观察反馈&#xa;aria-live 状态 + 焦点 + 高亮&#xa;command outcome + returnTo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="reevaluate" value="重新读取权威事实&#xa;重算 gaps 与 readiness&#xa;只在 completionPredicate 成立时完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1">
