        <mxCell id="kernelLane" value="Shared UX Control Plane / 必须平台化的体验内核" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#455a64;fontFamily=Arial;fontSize=13;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
