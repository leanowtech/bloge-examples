<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram id="resource-gateway-ux-round3-safety-and-task-control-plane" name="UX Round 3 Safety and Task Control Plane">
    <mxGraphModel dx="1600" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Resource Gateway UX Round 3：从表面可用回到任务安全与可恢复性" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="最新 E2 反证推翻 97 分基线：系统已经能编排、测试和演练，但作者资产仍可能静默丢失，关键动作不可逆，企业上下文和证明等级也没有成为体验不变量" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="observedLane" value="Observed Critical Breaks / 最新真实任务反例" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#fff8f7;strokeColor=#c62828;fontFamily=Arial;fontSize=13;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="obsContinuity" value="无保护的数据丢失&#xa;5 节点 / 12 连线草稿&#xa;跨工作区返回后变 0 / 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="observedLane">
          <mxGeometry x="25" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="obsMutation" value="破坏性编辑不可恢复&#xa;Delete 同步移除节点、边&#xa;fixture、测试套件与结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="observedLane">
          <mxGeometry x="325" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="obsContext" value="任务坐标与命令分裂&#xa;Author 不显示 tenant / env / role&#xa;820px 前 273px 被 chrome 占用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="observedLane">
          <mxGeometry x="625" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="obsSemantics" value="中文与证明语义泄漏&#xa;执行原型、测试结果仍是英文&#xa;raw code 进入默认业务列表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="observedLane">
          <mxGeometry x="925" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="obsResponsive" value="移动与视觉任务失真&#xa;390px Matrix 截断核心结果&#xa;重复警告和 12px 辅助语义泛滥" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="observedLane">
          <mxGeometry x="1225" y="58" width="250" height="92" as="geometry" />
        </mxCell>

        <mxCell id="causeLane" value="Root Cause / 病根" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#fffdf1;strokeColor=#f57c00;fontFamily=Arial;fontSize=13;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="causeContinuity" value="组件内 state 冒充工作区资产&#xa;无 Draft lifecycle / recovery&#xa;导航与持久化彼此不知情" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="causeLane">
          <mxGeometry x="25" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="causeMutation" value="setState 直接修改领域事实&#xa;没有 transaction / inverse / journal&#xa;副资产删除不是同一原子命令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="causeLane">
          <mxGeometry x="325" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="causeContext" value="路由、草稿、角色、环境分散&#xa;没有统一 TaskCoordinate&#xa;每个 surface 自己决定命令和 chrome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="causeLane">
          <mxGeometry x="625" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="causeSemantics" value="英文 sentence 仍是领域返回值&#xa;动态 t(variable) inventory 有盲区&#xa;证明状态和展示色未分层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="causeLane">
          <mxGeometry x="925" y="58" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="causeResponsive" value="CSS breakpoint 只管理空间&#xa;没有 TaskProjection / ChromeBudget&#xa;aux token 被当作默认正文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="causeLane">
          <mxGeometry x="1225" y="58" width="250" height="92" as="geometry" />
        </mxCell>

        <mxCell id="controlLane" value="Target UX Control Plane / 平台化根治机制" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#1565c0;fontFamily=Arial;fontSize=13;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="1520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="controlContinuity" value="WorkspaceContinuityKernel&#xa;DIRTY → SAVING → SAVED / CONFLICTED&#xa;autosave、离开保护、reload recovery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="controlLane">
          <mxGeometry x="25" y="62" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="controlMutation" value="ReversibleMutationJournal&#xa;原子 mutation + inverse + impact&#xa;Undo / Redo、soft delete、恢复回执" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="controlLane">
          <mxGeometry x="325" y="62" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="controlContext" value="TaskCoordinate + CommandAuthority&#xa;tenant / env / draft / role / subject&#xa;一个任务、一个主命令、一个 scope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="controlLane">
          <mxGeometry x="625" y="62" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="controlSemantics" value="SemanticPresentationPlane&#xa;messageId + params + rawCode&#xa;业务结论 / 证明等级 / 技术身份分层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="controlLane">
          <mxGeometry x="925" y="62" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="controlResponsive" value="ResponsiveTaskProjection + VisualBudget&#xa;移动结果摘要、Semantic Zoom&#xa;chrome ≤160px、正文与辅助语义分治" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="controlLane">
          <mxGeometry x="1225" y="62" width="250" height="96" as="geometry" />
        </mxCell>

        <mxCell id="edgeObsContinuity" value="静默丢失" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="obsContinuity" target="causeContinuity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeObsMutation" value="删除不可逆" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="obsMutation" target="causeMutation"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeObsContext" value="坐标缺失" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="obsContext" target="causeContext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeObsSemantics" value="语义泄漏" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="obsSemantics" target="causeSemantics"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeObsResponsive" value="装得下但读不懂" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="obsResponsive" target="causeResponsive"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="edgeControlContinuity" value="会话级持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="causeContinuity" target="controlContinuity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeControlMutation" value="命令级历史" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2e7d32;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="causeMutation" target="controlMutation"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeControlContext" value="统一任务坐标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="causeContext" target="controlContext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeControlSemantics" value="类型化展示" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#6a1b9a;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="causeSemantics" target="controlSemantics"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edgeControlResponsive" value="任务预算约束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#e65100;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="causeResponsive" target="controlResponsive"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="phaseLane" value="Delivery Gates / 实施顺序不可颠倒" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f7f9;strokeColor=#455a64;fontFamily=Arial;fontSize=12;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="1520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="phase0" value="S0 · P0 数据安全" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="phaseLane"><mxGeometry x="25" y="46" width="250" height="34" as="geometry" /></mxCell>
        <mxCell id="phase1" value="S1 · 可逆编辑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="phaseLane"><mxGeometry x="325" y="46" width="250" height="34" as="geometry" /></mxCell>
        <mxCell id="phase2" value="S2 · 上下文与命令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="phaseLane"><mxGeometry x="625" y="46" width="250" height="34" as="geometry" /></mxCell>
        <mxCell id="phase3" value="S3 · 语义与移动任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="phaseLane"><mxGeometry x="925" y="46" width="250" height="34" as="geometry" /></mxCell>
        <mxCell id="phase4" value="S4 · E3/E4 组织验证" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="phaseLane"><mxGeometry x="1225" y="46" width="250" height="34" as="geometry" /></mxCell>
