{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-assertion-set-changed-v1.schema.json",
  "title": "BLOGE Assertion Set Changed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "scope", "assertionSetRef", "target", "oracleRef", "lifecycle", "assertionCount", "compatibilitySupported", "evaluatorVersion", "actorId", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "bloge.assertionSetChanged.v1" },
    "eventId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "scope": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/enterpriseScope" },
    "assertionSetRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
    "target": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactTargetRef" },
    "oracleRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
    "lifecycle": { "enum": ["DRAFT", "VALID", "STALE"] },
    "assertionCount": { "type": "integer", "minimum": 0 },
    "compatibilitySupported": { "type": "boolean" },
    "evaluatorVersion": { "type": "string", "maxLength": 255 },
    "actorId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
