{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-business-oracle-approved-v1.schema.json",
  "title": "BLOGE Business Oracle Approved v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "scope", "oracleRef", "target", "ownerId", "basisCount", "reviewerId", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "bloge.businessOracleApproved.v1" },
    "eventId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "scope": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/enterpriseScope" },
    "oracleRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
    "target": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactTargetRef" },
    "ownerId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "basisCount": { "type": "integer", "minimum": 1 },
    "reviewerId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
