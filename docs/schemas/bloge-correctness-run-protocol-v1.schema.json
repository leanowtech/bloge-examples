{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-correctness-run-protocol-v1.schema.json",
  "title": "BLOGE Correctness Governed Run Protocol Bundle v1",
  "description": "Closed, payload-free contracts for preflight, governed execution, and immutable correctness evidence lineage.",
  "oneOf": [
    { "$ref": "#/$defs/preflightRequest" },
    { "$ref": "#/$defs/preflightReport" },
    { "$ref": "#/$defs/runRequest" },
    { "$ref": "#/$defs/runResponse" },
    { "$ref": "#/$defs/evidenceCompanion" },
    { "$ref": "#/$defs/storedEvidenceCompanion" }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "optionalIdentifier": { "type": "string", "maxLength": 512 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "publicationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationId", "revision", "fingerprint"],
      "properties": {
        "publicationId": { "$ref": "#/$defs/identifier" },
        "revision": { "const": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caseIds", "selectionFingerprint"],
          "properties": {
            "mode": { "const": "ALL" },
            "caseIds": { "type": "array", "maxItems": 0 },
            "selectionFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caseIds", "selectionFingerprint"],
          "properties": {
            "mode": { "const": "SELECTED" },
            "caseIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "selectionFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        }
      ]
    },
    "preflightRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "publicationRef", "selection"],
      "properties": {
        "schemaVersion": { "const": "bloge.correctnessPreflightRequest.v1" },
        "publicationRef": { "$ref": "#/$defs/publicationRef" },
        "selection": { "$ref": "#/$defs/selectionIntent" }
      }
    },
    "selectionIntent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caseIds", "expectedSelectionFingerprint"],
          "properties": {
            "mode": { "const": "ALL" },
            "caseIds": { "type": "array", "maxItems": 0 },
            "expectedSelectionFingerprint": {
              "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "const": "" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caseIds", "expectedSelectionFingerprint"],
          "properties": {
            "mode": { "const": "SELECTED" },
            "caseIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "expectedSelectionFingerprint": {
              "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "const": "" }]
            }
          }
        }
      ]
    },
    "invocationResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSiteId", "graphPath", "nodeId", "operatorRef", "resourceRef",
        "functionRef", "runtimeBindingFingerprint", "invocationKind", "sideEffectType",
        "resolution", "behavior", "boundary", "ruleRefs", "fidelity"
      ],
      "properties": {
        "invocationSiteId": { "$ref": "#/$defs/identifier" },
        "graphPath": { "$ref": "#/$defs/identifier" },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "operatorRef": { "$ref": "#/$defs/optionalIdentifier" },
        "resourceRef": { "$ref": "#/$defs/optionalIdentifier" },
        "functionRef": { "$ref": "#/$defs/optionalIdentifier" },
        "runtimeBindingFingerprint": { "$ref": "#/$defs/fingerprint" },
        "invocationKind": { "enum": ["PRIMARY", "COMPENSATION", "FUNCTION", "RESOURCE", "SUBGRAPH"] },
        "sideEffectType": { "$ref": "#/$defs/identifier" },
        "resolution": { "enum": ["REAL", "TEST_DOUBLE", "DENIED"] },
        "behavior": { "enum": ["REAL", "RETURN", "THROW", "DELAY", "TIMEOUT", "STREAM", "REPLAY", "SPY", "DENY"] },
        "boundary": { "enum": ["NODE", "TRANSPORT"] },
        "ruleRefs": { "$ref": "#/$defs/stringSet" },
        "fidelity": { "$ref": "#/$defs/identifier" }
      }
    },
    "rulePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "behavior", "boundary", "required", "minUses", "maxUses", "onUnmatched", "onExhausted", "schemaCheckMode"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identifier" },
        "behavior": { "enum": ["REAL", "RETURN", "THROW", "DELAY", "TIMEOUT", "STREAM", "REPLAY", "SPY", "DENY"] },
        "boundary": { "enum": ["NODE", "TRANSPORT"] },
        "required": { "type": "boolean" },
        "minUses": { "type": "integer", "minimum": 0 },
        "maxUses": { "type": "integer", "minimum": 0 },
        "onUnmatched": { "enum": ["FAIL", "WARN", "ALLOW_REAL"] },
        "onExhausted": { "enum": ["FAIL", "FALLBACK_TO_REAL"] },
        "schemaCheckMode": { "enum": ["STRICT", "WAIVED"] }
      }
    },
    "serviceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "mode", "available", "deterministic", "configurationFingerprint", "consumers", "certificationGaps"],
      "properties": {
        "service": { "$ref": "#/$defs/identifier" },
        "mode": { "$ref": "#/$defs/identifier" },
        "available": { "type": "boolean" },
        "deterministic": { "type": "boolean" },
        "configurationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "consumers": { "$ref": "#/$defs/stringSet" },
        "certificationGaps": { "$ref": "#/$defs/stringSet" }
      }
    },
    "casePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "caseType", "fixtureBundleRef", "executionPlanFingerprint", "invocationSites", "rulePolicies", "executionServices", "replayDependencyCount"],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "caseType": { "enum": ["GOLDEN", "NEGATIVE", "BOUNDARY", "REGRESSION", "PROPERTY"] },
        "fixtureBundleRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "executionPlanFingerprint": { "$ref": "#/$defs/fingerprint" },
        "invocationSites": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/invocationResolution" } },
        "rulePolicies": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/rulePolicy" } },
        "executionServices": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/serviceBinding" } },
        "replayDependencyCount": { "type": "integer", "minimum": 0 }
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realCount", "mockedCount", "faultCount", "replayCount", "observeCount", "deniedCount", "fallbackToRealCount", "transportBoundaryCount", "secretRequirementCount", "logicalClockConfigured", "sideEffectTypes"],
      "properties": {
        "realCount": { "type": "integer", "minimum": 0 },
        "mockedCount": { "type": "integer", "minimum": 0 },
        "faultCount": { "type": "integer", "minimum": 0 },
        "replayCount": { "type": "integer", "minimum": 0 },
        "observeCount": { "type": "integer", "minimum": 0 },
        "deniedCount": { "type": "integer", "minimum": 0 },
        "fallbackToRealCount": { "type": "integer", "minimum": 0 },
        "transportBoundaryCount": { "type": "integer", "minimum": 0 },
        "secretRequirementCount": { "type": "integer", "minimum": 0 },
        "logicalClockConfigured": { "type": "boolean" },
        "sideEffectTypes": { "$ref": "#/$defs/stringSet" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageId", "caseId"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "messageId": { "$ref": "#/$defs/identifier" },
        "caseId": { "$ref": "#/$defs/optionalIdentifier" }
      }
    },
    "preflightReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "publicationRef", "target", "compiledTestSuiteRef", "selection", "proofLevel", "cases", "riskSummary", "blockers", "preflightFingerprint"],
      "properties": {
        "schemaVersion": { "const": "bloge.correctnessPreflightReport.v1" },
        "publicationRef": { "$ref": "#/$defs/publicationRef" },
        "target": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactTargetRef" },
        "compiledTestSuiteRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "selection": { "$ref": "#/$defs/selection" },
        "proofLevel": { "enum": ["STRUCTURAL", "SIMULATED_BUSINESS", "CONTROLLED_INTEGRATION", "REPLAY_DERIVED"] },
        "cases": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/casePlan" } },
        "riskSummary": { "$ref": "#/$defs/riskSummary" },
        "blockers": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/blocker" } },
        "preflightFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "runRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "publicationRef", "selection", "preflightFingerprint", "clientRequestId", "strategy"],
      "properties": {
        "schemaVersion": { "const": "bloge.correctnessRunRequest.v1" },
        "publicationRef": { "$ref": "#/$defs/publicationRef" },
        "selection": { "$ref": "#/$defs/selection" },
        "preflightFingerprint": { "$ref": "#/$defs/fingerprint" },
        "clientRequestId": { "$ref": "#/$defs/identifier" },
        "strategy": { "enum": ["COLLECT_ALL", "FAIL_FAST"] }
      }
    },
    "exactCaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioDraftSetRef", "caseId", "caseFingerprint"],
      "properties": {
        "scenarioDraftSetRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "caseId": { "$ref": "#/$defs/identifier" },
        "caseFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "caseExecutionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "fixtureBundleRef", "executionPlanFingerprint", "status", "childRunId", "evidenceClass"],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "fixtureBundleRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "executionPlanFingerprint": { "$ref": "#/$defs/fingerprint" },
        "status": { "enum": ["PASSED", "FAILED", "PARTIAL", "NOT_SCHEDULED", "EVIDENCE_INCOMPLETE"] },
        "childRunId": { "$ref": "#/$defs/optionalIdentifier" },
        "evidenceClass": { "type": ["string", "null"], "enum": ["EXPLORATORY", "CERTIFIABLE", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "NOT_SCHEDULED" } }, "required": ["status"] },
          "then": { "properties": { "childRunId": { "const": "" }, "evidenceClass": { "type": "null" } } },
          "else": { "properties": { "childRunId": { "$ref": "#/$defs/identifier" }, "evidenceClass": { "enum": ["EXPLORATORY", "CERTIFIABLE"] } } }
        }
      ]
    },
    "attestation": {
      "oneOf": [
        { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteRunAttestation" },
        { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteRunAttestationV2" },
        { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteRunAttestationV3" },
        { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteRunAttestationV4" },
        { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteRunAttestationV5" }
      ]
    },
    "evidenceCompanion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "evidenceCompanionId", "scope", "suiteRunId",
        "suiteEvidenceFingerprint", "clientRequestFingerprint", "publicationRef", "target",
        "definitionRef", "inventoryRef", "scenarioDraftSetRef", "caseRefs", "oracleRefs",
        "assertionSetRefs", "fixtureAssetRefs", "compiledFixtureBundleRefs",
        "compiledTestSuiteRef", "selection", "caseExecutions", "sourceMap", "riskSummary",
        "dataClassifications", "verdict", "attestation", "metadata"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.correctnessEvidenceCompanion.v1" },
        "evidenceCompanionId": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/enterpriseScope" },
        "suiteRunId": { "$ref": "#/$defs/identifier" },
        "suiteEvidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "clientRequestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "publicationRef": { "$ref": "#/$defs/publicationRef" },
        "target": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactTargetRef" },
        "definitionRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "inventoryRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "scenarioDraftSetRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "caseRefs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/exactCaseRef" } },
        "oracleRefs": { "type": "array", "maxItems": 10000, "items": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" } },
        "assertionSetRefs": { "type": "array", "maxItems": 10000, "items": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" } },
        "fixtureAssetRefs": { "type": "array", "maxItems": 10000, "items": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" } },
        "compiledFixtureBundleRefs": { "type": "array", "maxItems": 100, "items": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" } },
        "compiledTestSuiteRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
        "selection": { "$ref": "#/$defs/selection" },
        "caseExecutions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/caseExecutionRef" } },
        "sourceMap": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "bloge-correctness-compilation-report-v1.schema.json#/$defs/sourceMapping" } },
        "riskSummary": { "$ref": "#/$defs/riskSummary" },
        "dataClassifications": { "$ref": "#/$defs/stringSet" },
        "verdict": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/correctnessVerdict" },
        "attestation": { "$ref": "#/$defs/attestation" },
        "metadata": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/auditMetadata" }
      }
    },
    "storedEvidenceCompanion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "companionFingerprint", "companion"],
      "properties": {
        "schemaVersion": { "const": "bloge.storedCorrectnessEvidenceCompanion.v1" },
        "companionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "companion": { "$ref": "#/$defs/evidenceCompanion" }
      }
    },
    "runResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "status", "suiteExecution", "evidenceCompanion"],
          "properties": {
            "schemaVersion": { "const": "bloge.correctnessRunResponse.v1" },
            "status": { "const": "RUNNING" },
            "suiteExecution": { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteExecutionResponse" },
            "evidenceCompanion": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "status", "suiteExecution", "evidenceCompanion"],
          "properties": {
            "schemaVersion": { "const": "bloge.correctnessRunResponse.v1" },
            "status": { "const": "EVIDENCE_AVAILABLE" },
            "suiteExecution": { "$ref": "resource-gateway-testing/testing-control-plane-v1.schema.json#/$defs/testSuiteExecutionResponse" },
            "evidenceCompanion": { "$ref": "#/$defs/storedEvidenceCompanion" }
          }
        }
      ]
    }
  }
}
