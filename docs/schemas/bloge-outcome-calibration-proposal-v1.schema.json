{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-outcome-calibration-proposal-v1.schema.json",
  "title": "BLOGE Outcome Calibration Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "scope", "publicationRef", "suiteRunId", "evidenceCompanionRef", "target", "caseRefs", "oracleRefs", "mismatchKind", "reasonCode", "businessRationale", "proposedRegressionTitle", "status", "owner", "correlationId", "metadata"],
  "properties": {
    "schemaVersion": { "const": "bloge.outcomeCalibrationProposal.v1" },
    "proposalId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "scope": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/enterpriseScope" },
    "publicationRef": { "$ref": "bloge-correctness-run-protocol-v1.schema.json#/$defs/publicationRef" },
    "suiteRunId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "evidenceCompanionRef": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
    "target": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactTargetRef" },
    "caseRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "bloge-correctness-run-protocol-v1.schema.json#/$defs/exactCaseRef" } },
    "oracleRefs": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" } },
    "mismatchKind": { "enum": ["EXPECTED_OUTCOME_DIFFERED", "FORBIDDEN_OUTCOME_OBSERVED", "MISSING_BUSINESS_BRANCH", "STALE_BUSINESS_ASSUMPTION", "OTHER"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "businessRationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "proposedRegressionTitle": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "const": "PROPOSED" },
    "owner": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/principalRef" },
    "correlationId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "metadata": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/auditMetadata" }
  }
}
