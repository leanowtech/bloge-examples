{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-scenario-closure-report-v1.schema.json",
  "title": "BLOGE Scenario Closure Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "phase", "complete", "checks"],
  "properties": {
    "schemaVersion": { "const": "bloge.scenarioClosureReport.v1" },
    "scenarioId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "phase": { "enum": ["REVIEW_READY", "CANONICAL"] },
    "complete": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/closureCheck" }
    }
  },
  "$defs": {
    "closureCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "assetKind", "assetRef", "childId", "status", "reasonCode"],
      "properties": {
        "checkId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
        "assetKind": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
        "assetRef": {
          "oneOf": [
            { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/exactAssetRef" },
            { "type": "null" }
          ]
        },
        "childId": { "type": "string", "maxLength": 512 },
        "status": { "enum": ["VERIFIED", "MISSING", "STALE", "WRONG_STATE", "INCOMPATIBLE"] },
        "reasonCode": { "type": "string", "maxLength": 256 }
      }
    }
  }
}
