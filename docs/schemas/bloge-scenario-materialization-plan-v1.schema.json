{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-scenario-materialization-plan-v1.schema.json",
  "title": "BLOGE Scenario Materialization Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "source", "target", "contractFingerprint", "bindings",
    "valueSemantics", "mappingFingerprint", "rowSelection", "rowIdentityPolicy",
    "conflictPolicy", "budget", "planFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "bloge.scenarioMaterializationPlan.v1" },
    "source": { "$ref": "#/$defs/source" },
    "target": { "$ref": "bloge-scenario-draft-set-v1.schema.json#/$defs/target" },
    "contractFingerprint": { "$ref": "#/$defs/fingerprint" },
    "bindings": {
      "type": "array", "maxItems": 100,
      "items": { "$ref": "#/$defs/binding" }
    },
    "valueSemantics": {
      "type": "object", "maxProperties": 100,
      "additionalProperties": { "$ref": "#/$defs/valueSemantics" }
    },
    "mappingFingerprint": { "$ref": "#/$defs/fingerprint" },
    "rowSelection": {
      "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "rowIdentityPolicy": { "$ref": "#/$defs/rowIdentityPolicy" },
    "conflictPolicy": { "enum": ["FAIL", "APPEND", "REPLACE_EXACT_ID"] },
    "budget": { "$ref": "#/$defs/budget" },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
    "valueSemantics": { "enum": ["VALUE", "NULL", "MISSING", "EMPTY", "DEFAULT"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fingerprint", "encoding", "delimiter", "parser", "classification"],
      "properties": {
        "kind": { "enum": ["CSV", "JSON"] },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "encoding": { "const": "UTF-8" },
        "delimiter": { "type": "string", "maxLength": 1 },
        "parser": { "enum": ["papaparse-v5", "json-standard-v1"] },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "bindingId", "sourcePath", "target", "confidence", "reason", "confirmed",
        "converter", "valueSemantics"
      ],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourcePath": { "type": "string", "pattern": "^/", "maxLength": 512 },
        "target": { "$ref": "#/$defs/target" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "enum": ["EXACT_PATH", "EXACT_NAME", "NORMALIZED_NAME", "MANUAL"] },
        "confirmed": { "type": "boolean" },
        "converter": { "enum": ["IDENTITY", "STRING", "NUMBER", "BOOLEAN", "JSON"] },
        "valueSemantics": { "$ref": "#/$defs/valueSemantics" },
        "defaultValue": true
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["targetId", "group", "label", "path", "kind"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "group": { "enum": ["CASE", "GIVEN", "DEPENDENCY", "THEN"] },
        "label": { "type": "string", "maxLength": 512 },
        "path": { "type": "string", "maxLength": 1024 },
        "kind": { "enum": ["NAME", "CASE_TYPE", "TAGS", "GIVEN", "DEPENDENCY_OUTPUT", "ASSERTION_EXPECTED"] },
        "valuePath": {
          "type": "array", "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "dependencyId": { "type": "string", "maxLength": 256 },
        "assertionId": { "type": "string", "maxLength": 256 }
      }
    },
    "rowIdentityPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sourcePath"],
      "properties": {
        "kind": { "enum": ["CANONICAL_ROW_HASH", "SOURCE_COLUMN"] },
        "sourcePath": { "type": "string", "maxLength": 512 }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxBytes", "maxRows", "maxColumns"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "maxColumns": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
