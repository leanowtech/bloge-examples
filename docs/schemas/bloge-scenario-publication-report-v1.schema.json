{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-scenario-publication-report-v1.schema.json",
  "title": "BLOGE Scenario Publication Report v1",
  "description": "Payload-free durable state of one governed Scenario publication saga.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationId",
    "scope",
    "source",
    "runtimeTarget",
    "status",
    "attempt",
    "fixtures",
    "suite",
    "diagnostics",
    "failure",
    "startedAt",
    "updatedAt",
    "completedAt",
    "actor"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.scenarioPublicationReport.v1"
    },
    "publicationId": {
      "$ref": "#/$defs/id"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "runtimeTarget": {
      "$ref": "#/$defs/runtimeTarget"
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "PARTIAL",
        "FAILED",
        "PUBLISHED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fixtures": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "suite": {
      "anyOf": [
        {
          "$ref": "#/$defs/asset"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/machineCode"
      }
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "machineCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "organizationId",
        "projectId",
        "environment",
        "region"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "environment": {
          "enum": [
            "test",
            "staging"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioDraftSetId",
        "revision",
        "fingerprint",
        "targetFingerprint",
        "contractFingerprint",
        "compilerSchemaVersion",
        "compilationPlanFingerprint"
      ],
      "properties": {
        "scenarioDraftSetId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "targetKind": {
          "enum": [
            "",
            "GRAPH",
            "OPERATOR"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "targetFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "contractFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "compilerSchemaVersion": {
          "const": "bloge.scenarioGovernedCompilationPlan.v1"
        },
        "compilationPlanFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "fingerprint"
      ],
      "properties": {
        "kind": {
          "enum": [
            "GRAPH",
            "OPERATOR"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIXTURE_BUNDLE",
            "TEST_SUITE"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "code",
        "retryable"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Z0-9_]*$"
        },
        "code": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Z][A-Z0-9_.-]*$|^$"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
