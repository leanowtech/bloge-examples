{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-table-suite-run-batch-v1.schema.json",
  "title": "BLOGE Table Suite Run Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "requestId", "requestFingerprint", "scope", "target", "scenarioDraftSetId", "scenarioDraftSetRevision", "scenarioDraftSetFingerprint", "contractFingerprint", "selection", "preflight", "baselineBatchId", "status", "revision", "cancelRequested", "rows", "counts", "promotion", "events", "createdAt", "startedAt", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "bloge.tableSuiteRunBatch.v1" },
    "batchId": { "type": "string", "minLength": 1, "maxLength": 96 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
    "scope": { "$ref": "#/$defs/scope" },
    "target": { "$ref": "#/$defs/target" },
    "scenarioDraftSetId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "scenarioDraftSetRevision": { "type": "integer", "minimum": 0 },
    "scenarioDraftSetFingerprint": { "$ref": "#/$defs/fingerprint" },
    "contractFingerprint": { "$ref": "#/$defs/fingerprint" },
    "selection": { "$ref": "#/$defs/selection" },
    "preflight": { "$ref": "bloge-table-suite-run-command-v1.schema.json#/$defs/preflight" },
    "baselineBatchId": { "type": "string", "maxLength": 96 },
    "status": { "$ref": "#/$defs/batchStatus" },
    "revision": { "type": "integer", "minimum": 1 },
    "cancelRequested": { "type": "boolean" },
    "rows": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/row" } },
    "counts": { "$ref": "#/$defs/counts" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "events": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/event" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "organizationId", "projectId", "environment", "region"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "region": { "type": "string", "maxLength": 128 }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "const": "GRAPH" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "caseIds", "fingerprint", "fullSuite"],
      "properties": {
        "mode": { "enum": ["ALL", "SELECTED", "FAILED", "CHANGED", "AFFECTED"] },
        "caseIds": { "type": "array", "uniqueItems": true, "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "fullSuite": { "type": "boolean" }
      }
    },
    "batchStatus": { "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "BUDGET_STOPPED"] },
    "rowStatus": { "enum": ["QUEUED", "RUNNING", "SUCCESS", "ASSERTION_FAILED", "COMPILE_ERROR", "RUNTIME_ERROR", "TIMEOUT", "CANCELLED", "BUDGET_STOPPED"] },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "caseFingerprint", "status", "attempts", "flaky", "baseline"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "status": { "$ref": "#/$defs/rowStatus" },
        "attempts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/attempt" } },
        "flaky": { "type": "boolean" },
        "baseline": { "$ref": "#/$defs/baseline" }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "status", "assertions", "proofStrength", "durationMs", "runFingerprint", "firstFailure", "assertionEvidence", "startedAt", "completedAt"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/rowStatus" },
        "assertions": { "enum": ["NONE", "PASSED", "FAILED", "INCONCLUSIVE"] },
        "proofStrength": { "enum": ["SCHEMA", "MOCK", "RUNTIME"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "runFingerprint": { "anyOf": [{ "$ref": "#/$defs/fingerprint" }, { "const": "" }] },
        "firstFailure": { "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] },
        "assertionEvidence": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/assertion" } },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "code", "target", "summary"],
      "properties": {
        "category": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 256 },
        "target": { "type": "string", "maxLength": 4096 },
        "summary": { "type": "string", "maxLength": 4096 }
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["assertionId", "path", "passed", "expectedFingerprint", "actualFingerprint", "diagnosticCode"],
      "properties": {
        "assertionId": { "type": "string", "maxLength": 256 },
        "path": { "type": "string", "maxLength": 4096 },
        "passed": { "type": "boolean" },
        "expectedFingerprint": { "$ref": "#/$defs/fingerprint" },
        "actualFingerprint": { "$ref": "#/$defs/fingerprint" },
        "diagnosticCode": { "type": "string", "maxLength": 256 }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineBatchId", "baselineStatus", "outcome"],
      "properties": {
        "baselineBatchId": { "type": "string", "maxLength": 96 },
        "baselineStatus": { "anyOf": [{ "$ref": "#/$defs/rowStatus" }, { "type": "null" }] },
        "outcome": { "enum": ["NONE", "SAME", "IMPROVED", "REGRESSED", "CHANGED_INPUT", "NEW"] }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "queued", "running", "succeeded", "failed", "cancelled", "budgetStopped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "queued": { "type": "integer", "minimum": 0 },
        "running": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "budgetStopped": { "type": "integer", "minimum": 0 }
      }
    },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": { "eligible": { "type": "boolean" }, "reason": { "type": "string", "maxLength": 256 } }
    },
    "eventType": { "enum": ["BATCH_ADMITTED", "BATCH_STARTED", "BATCH_RETRY_STARTED", "ROW_RUNNING", "ROW_TERMINAL", "CANCEL_REQUESTED", "BATCH_TERMINAL"] },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "type", "caseId", "row", "observedAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "type": { "$ref": "#/$defs/eventType" },
        "caseId": { "type": "string", "maxLength": 256 },
        "row": { "anyOf": [{ "$ref": "#/$defs/row" }, { "type": "null" }] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
