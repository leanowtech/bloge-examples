{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-authoring-function-test-run-request-v1.schema.json",
  "title": "BLOGE Visual Authoring Function Test Run Request",
  "description": "Ephemeral function tests against one exact draft and one bounded runtime inventory profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite"],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualAuthoringFunctionTestRunRequest.v1"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "functionRef", "cases"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualAuthoringFunctionTestSuite.v1"
        },
        "functionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "args",
        "assertion",
        "expect"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualAuthoringFunctionTestCase.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "kind": {
          "enum": ["GOLDEN", "NEGATIVE", "BOUNDARY", "REGRESSION"]
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": true
        },
        "assertion": {
          "enum": ["EQUALS", "RETURN_TYPE", "EXPECT_ERROR"]
        },
        "expect": {},
        "expectError": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
