{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-visual-authoring-function-worker-invocation-request-v1.schema.json",
  "title": "BLOGE Visual Authoring Function Worker Invocation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "functionName",
    "expectedRuntimeFingerprint",
    "args"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualAuthoringFunctionWorkerInvocationRequest.v1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "functionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expectedRuntimeFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "args": {
      "type": "array",
      "maxItems": 32
    }
  }
}
