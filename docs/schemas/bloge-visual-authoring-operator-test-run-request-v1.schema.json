{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-authoring-operator-test-run-request-v1.schema.json",
  "title": "BLOGE Visual Authoring Operator Test Run Request",
  "description": "Ephemeral schema-contract checks against one exact uncommitted authoring draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite"],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualAuthoringOperatorTestRunRequest.v1"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operatorRef", "cases"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualOperatorContractTestSuiteRequest.v1"
        },
        "operatorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "name",
        "description",
        "inputs",
        "config",
        "mockedOutputs",
        "outputAssertions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualOperatorContractTestCase.v1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "inputs": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "mockedOutputs": {
          "type": "object"
        },
        "outputAssertions": {
          "type": "object"
        }
      }
    }
  }
}
