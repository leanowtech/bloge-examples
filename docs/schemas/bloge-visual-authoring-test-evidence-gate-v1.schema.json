{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-authoring-test-evidence-gate-v1.schema.json",
  "title": "BLOGE Visual Authoring Test Evidence Gate v1",
  "description": "A live fail-closed TEST_EVIDENCED baseline for every operator and built-in function in one exact authoring draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "draftId",
    "authoringRevision",
    "authoringFingerprint",
    "canonicalFingerprint",
    "policyVersion",
    "status",
    "achievedMaturity",
    "requiredAssets",
    "satisfiedAssets",
    "reasons",
    "assets",
    "evaluatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualAuthoringTestEvidenceGate.v1"
    },
    "scope": {"$ref": "#/$defs/scope"},
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "authoringRevision": {"type": "integer", "minimum": 1},
    "authoringFingerprint": {"$ref": "#/$defs/fingerprint"},
    "canonicalFingerprint": {"$ref": "#/$defs/fingerprint"},
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {"enum": ["PASSED", "BLOCKED"]},
    "achievedMaturity": {"enum": ["DESIGN_READY", "TEST_EVIDENCED"]},
    "requiredAssets": {"type": "integer", "minimum": 0},
    "satisfiedAssets": {"type": "integer", "minimum": 0},
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gateReason"}
    },
    "assets": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/assetGate"}
    },
    "evaluatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "organizationId",
        "projectId",
        "environmentId",
        "region"
      ],
      "properties": {
        "tenantId": {"$ref": "#/$defs/identity"},
        "organizationId": {"$ref": "#/$defs/identity"},
        "projectId": {"$ref": "#/$defs/identity"},
        "environmentId": {"$ref": "#/$defs/identity"},
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "gateReason": {
      "enum": [
        "DRAFT_NOT_IMPORTABLE",
        "MISSING_EVIDENCE",
        "EVIDENCE_STALE",
        "LATEST_RUN_FAILED",
        "INSUFFICIENT_CASE_COVERAGE",
        "INSUFFICIENT_ASSERTION_COVERAGE",
        "FUNCTION_NOT_BOUND"
      ]
    },
    "assetGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetKind",
        "assetRef",
        "status",
        "reasons",
        "evidenceRunId",
        "evidenceFingerprint",
        "freshness",
        "requiredCases",
        "observedCases",
        "observedAssertions",
        "proofMode"
      ],
      "properties": {
        "assetKind": {"enum": ["OPERATOR", "FUNCTION"]},
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "status": {"enum": ["PASSED", "BLOCKED"]},
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gateReason"}
        },
        "evidenceRunId": {
          "type": "string",
          "maxLength": 160
        },
        "evidenceFingerprint": {
          "oneOf": [
            {"const": ""},
            {"$ref": "#/$defs/fingerprint"}
          ]
        },
        "freshness": {"enum": ["CURRENT", "STALE"]},
        "requiredCases": {"type": "integer", "minimum": 1, "maximum": 50},
        "observedCases": {"type": "integer", "minimum": 0, "maximum": 50},
        "observedAssertions": {"type": "integer", "minimum": 0},
        "proofMode": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
