{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/bloge-visual-authoring-workspace-bundle-v1.schema.json",
  "title": "BLOGE Visual Authoring Workspace Bundle v1",
  "description": "Secret-safe portable Graph, Contract, Scenario, operator-coordinate, and publication-reference workspace for browser and VS Code authoring hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "classification",
    "graphDraft",
    "contractProjection",
    "scenarioDraftSet",
    "operatorSnapshotRefs",
    "publicationRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualAuthoringWorkspaceBundle.v1"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "graphDraft": {
      "type": "object",
      "required": [
        "schemaVersion",
        "graphName",
        "nodes",
        "edges"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualGraphDraft.v1"
        },
        "graphName": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        }
      }
    },
    "contractProjection": {
      "$ref": "bloge-scenario-contract-projection-v1.schema.json"
    },
    "scenarioDraftSet": {
      "$ref": "bloge-scenario-draft-set-v1.schema.json"
    },
    "operatorSnapshotRefs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/operatorSnapshotRef"
      }
    },
    "publicationRefs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/publicationAssetRef"
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operatorSnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "operatorRef"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operatorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "publicationAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIXTURE_BUNDLE",
            "TEST_SUITE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  }
}
