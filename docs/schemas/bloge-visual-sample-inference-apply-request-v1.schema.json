{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-sample-inference-apply-request-v1.schema.json",
  "title": "BLOGE Visual Sample Inference Apply Request",
  "description": "Replays one ephemeral inference request and atomically promotes an explicit decision for every current confirmation. Raw samples are processed for this request only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inference",
    "evidenceFingerprint",
    "decisions",
    "actor"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualSampleInferenceApplyRequest.v1"
    },
    "inference": {
      "$ref": "#/$defs/inference"
    },
    "evidenceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "actor": {
      "type": "string",
      "maxLength": 255
    }
  },
  "$defs": {
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "target",
        "samples",
        "options",
        "idempotencyKey"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualSampleInferenceRequest.v1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": true
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetKind",
        "assetRef",
        "portDirection",
        "portName"
      ],
      "properties": {
        "assetKind": {
          "const": "OPERATOR"
        },
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "portDirection": {
          "enum": [
            "INPUT",
            "OUTPUT"
          ]
        },
        "portName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestEnums",
        "suggestFormats",
        "persistPayload"
      ],
      "properties": {
        "suggestEnums": {
          "type": "boolean"
        },
        "suggestFormats": {
          "type": "boolean"
        },
        "persistPayload": {
          "const": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmationId",
        "value"
      ],
      "properties": {
        "confirmationId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
