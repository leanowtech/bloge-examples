{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-sample-inference-request-v1.schema.json",
  "title": "BLOGE Visual Sample Inference Request",
  "description": "Ephemeral sample input for deterministic observed-fact inference. Raw payload persistence is not authorized by this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "samples",
    "options",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualSampleInferenceRequest.v1"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": true
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetKind",
        "assetRef",
        "portDirection",
        "portName"
      ],
      "properties": {
        "assetKind": {
          "const": "OPERATOR"
        },
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "portDirection": {
          "enum": [
            "INPUT",
            "OUTPUT"
          ]
        },
        "portName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestEnums",
        "suggestFormats",
        "persistPayload"
      ],
      "properties": {
        "suggestEnums": {
          "type": "boolean"
        },
        "suggestFormats": {
          "type": "boolean"
        },
        "persistPayload": {
          "const": false
        }
      }
    }
  }
}
