{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.leanowtech.com/schemas/bloge-visual-sample-inference-result-v1.schema.json",
  "title": "BLOGE Visual Sample Inference Result",
  "description": "Payload-free observed facts, conservative schema candidate, and explicit promotion confirmations for one exact authoring revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "authoringRevision",
    "target",
    "evidenceFingerprint",
    "inferencerVersion",
    "redactionProfileVersion",
    "sampleCount",
    "candidate",
    "observations",
    "confirmationRequests",
    "diagnostics",
    "payloadPersisted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.visualSampleInferenceResult.v1"
    },
    "draftId": {
      "type": "string",
      "minLength": 1
    },
    "authoringRevision": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "evidenceFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "inferencerVersion": {
      "type": "string",
      "minLength": 1
    },
    "redactionProfileVersion": {
      "type": "string",
      "minLength": 1
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "candidate": {
      "$ref": "#/$defs/typeNode"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "confirmationRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/confirmation"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "payloadPersisted": {
      "const": false
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetKind",
        "assetRef",
        "portDirection",
        "portName"
      ],
      "properties": {
        "assetKind": {
          "const": "OPERATOR"
        },
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "portDirection": {
          "enum": [
            "INPUT",
            "OUTPUT"
          ]
        },
        "portName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "typeNode": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "additionalProperties"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "maxProperties": 2000,
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\??$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/typeNode"
              }
            },
            "additionalProperties": {
              "const": true
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "authoringPath",
        "sourceLevel",
        "suggestedType",
        "sampleCount",
        "presenceCount",
        "nullCount",
        "distinctCount",
        "sensitive",
        "requiredCandidate",
        "nullableCandidate",
        "formatCandidate",
        "enumCandidates",
        "conflictTypes",
        "widenReasons"
      ],
      "properties": {
        "factId": {
          "$ref": "#/$defs/fingerprint"
        },
        "authoringPath": {
          "type": "string",
          "pattern": "^/"
        },
        "sourceLevel": {
          "const": "OBSERVED"
        },
        "suggestedType": {
          "type": "string"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "presenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "nullCount": {
          "type": "integer",
          "minimum": 0
        },
        "distinctCount": {
          "type": "integer",
          "minimum": 0
        },
        "sensitive": {
          "type": "boolean"
        },
        "requiredCandidate": {
          "type": "boolean"
        },
        "nullableCandidate": {
          "type": "boolean"
        },
        "formatCandidate": {
          "type": "string"
        },
        "enumCandidates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "conflictTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "widenReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmationId",
        "factId",
        "code",
        "authoringPath",
        "question",
        "recommendedValue",
        "allowedValues",
        "blocking"
      ],
      "properties": {
        "confirmationId": {
          "$ref": "#/$defs/fingerprint"
        },
        "factId": {
          "$ref": "#/$defs/fingerprint"
        },
        "code": {
          "type": "string",
          "pattern": "^RG\\.AUTHORING\\.INFERENCE_"
        },
        "authoringPath": {
          "type": "string",
          "pattern": "^/"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "recommendedValue": {
          "type": "string",
          "minLength": 1
        },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "code",
        "message",
        "authoringPath",
        "canonicalPath",
        "offset",
        "fixes",
        "metadata"
      ],
      "properties": {
        "level": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "authoringPath": {
          "type": "string",
          "pattern": "^/"
        },
        "canonicalPath": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": -1
        },
        "fixes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label",
              "target"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
