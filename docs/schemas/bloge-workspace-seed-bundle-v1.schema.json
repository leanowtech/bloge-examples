{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/bloge-workspace-seed-bundle-v1.schema.json",
  "title": "BLOGE Workspace Seed Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "template", "graphDraft", "scenarioDraftSets", "fixtureRefs",
    "runtimeProfile", "proofStrength", "capabilities", "missingCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": "bloge.workspaceSeedBundle.v1" },
    "template": { "$ref": "#/$defs/templateIdentity" },
    "graphDraft": { "$ref": "bloge-visual-graph-draft-v1.schema.json" },
    "scenarioDraftSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "bloge-scenario-draft-set-v1.schema.json" }
    },
    "fixtureRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "runtimeProfile": { "$ref": "#/$defs/runtimeProfile" },
    "proofStrength": {
      "enum": ["EXPLORATORY", "REPLAYABLE", "GOVERNED"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "missingCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "$defs": {
    "templateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "version", "label"],
      "properties": {
        "templateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 255 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sandboxRunnable", "liveDependencies", "mockedOperatorRefs"],
      "properties": {
        "mode": { "enum": ["SANDBOX_MOCK", "SANDBOX_MIXED", "LIVE_TEST"] },
        "sandboxRunnable": { "type": "boolean" },
        "liveDependencies": { "type": "boolean" },
        "mockedOperatorRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
