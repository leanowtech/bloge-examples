{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-agent-tdd-codex-certification-v1.schema.json",
  "title": "Resource Gateway Agent TDD Codex certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certifiedAt",
    "repositoryCommit",
    "codexVersion",
    "runtimeIdentity",
    "transport",
    "journey",
    "correlation",
    "assertions",
    "result",
    "certificateFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "rg.agentTddCodexCertification.v1" },
    "certifiedAt": { "type": "string", "format": "date-time" },
    "repositoryCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "codexVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "instanceNonceFingerprint",
        "repositoryCommit",
        "jarSha256",
        "processOwnershipVerified",
        "verifiedBeforeAndAfterTurn"
      ],
      "properties": {
        "schemaVersion": { "const": "rg.agentTddCertificationInstance.v1" },
        "instanceNonceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "repositoryCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "jarSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "processOwnershipVerified": { "const": true },
        "verifiedBeforeAndAfterTurn": { "const": true }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "endpointClass", "serverCount"],
      "properties": {
        "kind": { "const": "HTTP_MCP" },
        "endpointClass": { "const": "LOOPBACK" },
        "serverCount": { "const": 4 }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "requiredSequence", "successfulPositions", "observedCalls"],
      "properties": {
        "phase": { "const": "AUTHORING_TO_HUMAN_GOLDEN_REVIEW" },
        "requiredSequence": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            { "const": "rg.capability.list" },
            { "const": "rg.contract.get" },
            { "const": "rg.dsl.reference.get" },
            { "const": "rg.dsl.preview" },
            { "const": "rg.gate.check" },
            { "const": "rg.tool.compose" },
            { "const": "rg.tool.setInstruction" },
            { "const": "rg.scenario.upsertCases" }
          ],
          "items": false
        },
        "successfulPositions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 1 }
        },
        "observedCalls": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "server", "tool", "status"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "server": { "enum": ["rg_read", "rg_author", "rg_execute", "rg_govern"] },
              "tool": { "type": "string", "pattern": "^rg\\." },
              "status": { "enum": ["completed", "failed", "cancelled", "unknown"] }
            }
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "candidate",
        "authoringContext",
        "authoringReceipt",
        "tool",
        "caseSet",
        "cases"
      ],
      "properties": {
        "method": { "const": "EPHEMERAL_HMAC_SHA256" },
        "candidate": { "$ref": "#/$defs/opaqueCorrelationFingerprint" },
        "authoringContext": { "$ref": "#/$defs/opaqueCorrelationFingerprint" },
        "authoringReceipt": { "$ref": "#/$defs/opaqueCorrelationFingerprint" },
        "tool": { "$ref": "#/$defs/opaqueCorrelationFingerprint" },
        "caseSet": { "$ref": "#/$defs/opaqueCorrelationFingerprint" },
        "cases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueCorrelationFingerprint" }
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codexTurnCompleted",
        "onlyMcpExternalActionsObserved",
        "requiredAuthoringOrder",
        "caseSetBoundToTool",
        "dependencyBehaviorDefined",
        "businessOracleProposed",
        "stoppedBeforeExecutionGovernanceAndPublication",
        "finalSummaryBusinessOnly",
        "selfRepairObserved",
        "firstPassAccepted",
        "selfRepairOrFirstPassAccepted",
        "boundedRepairPolicyRespected",
        "sameCandidateReceiptAndAssets",
        "businessDecisionTableAuthored",
        "sameToolBoardProjectionObserved",
        "businessFlowSummaryProjected",
        "sameCasesVisibleOnBoard",
        "rawArgumentsResultsAndMessagesOmitted",
        "spawnedRuntimeIdentityVerified"
      ],
      "properties": {
        "codexTurnCompleted": { "const": true },
        "onlyMcpExternalActionsObserved": { "const": true },
        "requiredAuthoringOrder": { "const": true },
        "caseSetBoundToTool": { "const": true },
        "dependencyBehaviorDefined": { "const": true },
        "businessOracleProposed": { "const": true },
        "stoppedBeforeExecutionGovernanceAndPublication": { "const": true },
        "finalSummaryBusinessOnly": { "const": true },
        "selfRepairObserved": { "type": "boolean" },
        "firstPassAccepted": { "type": "boolean" },
        "selfRepairOrFirstPassAccepted": { "const": true },
        "boundedRepairPolicyRespected": { "const": true },
        "sameCandidateReceiptAndAssets": { "const": true },
        "businessDecisionTableAuthored": { "const": true },
        "sameToolBoardProjectionObserved": { "const": true },
        "businessFlowSummaryProjected": { "const": true },
        "sameCasesVisibleOnBoard": { "const": true },
        "rawArgumentsResultsAndMessagesOmitted": { "const": true },
        "spawnedRuntimeIdentityVerified": { "const": true }
      }
    },
    "result": { "const": "CERTIFIED" },
    "certificateFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "opaqueCorrelationFingerprint": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    }
  }
}
