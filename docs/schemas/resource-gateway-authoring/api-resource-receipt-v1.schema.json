{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/api-resource-receipt-v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.apiResourceSaveReceipt.v1" },
    "connection": { "type": "object", "properties": { "connectionId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "revision": { "$ref": "common-v1.schema.json#/$defs/revision" } }, "required": ["connectionId", "revision"], "additionalProperties": false },
    "resource": { "$ref": "common-v1.schema.json#/$defs/apiResourceRef" },
    "defaultFixture": { "type": "object", "properties": { "fixtureSetId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "revision": { "$ref": "common-v1.schema.json#/$defs/revision" }, "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" }, "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "exampleName": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" } }, "required": ["exampleName", "caseId"], "additionalProperties": false } } }, "required": ["fixtureSetId", "revision", "fingerprint", "cases"], "additionalProperties": false },
    "projections": { "type": "object", "properties": { "descriptor": { "const": "READY" }, "designContract": { "const": "READY" }, "operator": { "const": "READY" } }, "required": ["descriptor", "designContract", "operator"], "additionalProperties": false }
  },
  "required": ["schemaVersion", "connection", "resource", "projections"],
  "additionalProperties": false
}
