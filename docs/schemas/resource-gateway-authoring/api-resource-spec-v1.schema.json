{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/api-resource-spec-v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.apiResourceSpec.v1" },
    "resourceId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" },
    "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" },
    "description": { "type": "string", "maxLength": 2000 },
    "connectionId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "operation": { "$ref": "api-resource-command-v1.schema.json#/$defs/operation" },
    "contract": { "$ref": "api-resource-command-v1.schema.json#/$defs/contract" },
    "response": { "$ref": "api-resource-command-v1.schema.json#/$defs/response" },
    "effect": { "$ref": "api-resource-command-v1.schema.json#/$defs/effect" },
    "examples": { "type": "array", "minItems": 1, "items": { "$ref": "api-resource-command-v1.schema.json#/$defs/example" } },
    "status": { "enum": ["DRAFT", "ACTIVE", "DEPRECATED", "DISABLED"] }
  },
  "required": ["schemaVersion", "resourceId", "revision", "fingerprint", "displayName", "connectionId", "operation", "contract", "response", "effect", "examples", "status"],
  "additionalProperties": false
}
