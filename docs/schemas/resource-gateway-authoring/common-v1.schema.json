{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/common-v1.schema.json",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "secretRef": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^vault://[A-Za-z0-9][A-Za-z0-9._:/~-]*$" },
    "headerName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
      "not": { "anyOf": [
        { "pattern": "^[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]$" },
        { "pattern": "^[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]$" },
        { "pattern": "^[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Ee][Nn][Tt][Ii][Cc][Aa][Tt][Ee]$" },
        { "pattern": "^[Cc][Oo][Oo][Kk][Ii][Ee]$" },
        { "pattern": "^[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]$" },
        { "pattern": "^[Hh][Oo][Ss][Tt]$" },
        { "pattern": "^[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Ll][Ee][Nn][Gg][Tt][Hh]$" },
        { "pattern": "^[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Ii][Oo][Nn]$" },
        { "pattern": "^[Kk][Ee][Ee][Pp]-[Aa][Ll][Ii][Vv][Ee]$" },
        { "pattern": "^[Tt][Ee]$" },
        { "pattern": "^[Tt][Rr][Aa][Ii][Ll][Ee][Rr]$" },
        { "pattern": "^[Tt][Rr][Aa][Nn][Ss][Ff][Ee][Rr]-[Ee][Nn][Cc][Oo][Dd][Ii][Nn][Gg]$" },
        { "pattern": "^[Uu][Pp][Gg][Rr][Aa][Dd][Ee]$" },
        { "pattern": "^[Ff][Oo][Rr][Ww][Aa][Rr][Dd][Ee][Dd]$" },
        { "pattern": "^[Xx]-[Ff][Oo][Rr][Ww][Aa][Rr][Dd][Ee][Dd]-.*$" }
      ] }
    },
    "fixtureStatus": { "enum": ["PRIVATE_DRAFT", "SHARING_PENDING", "TEAM_AVAILABLE", "STALE", "REVOKED"] },
    "schemaEnvelope": {
      "type": "object",
      "properties": {
        "format": { "const": "json-schema" },
        "version": { "const": "2020-12" },
        "schema": {}
      },
      "required": ["format", "version", "schema"],
      "additionalProperties": false
    },
    "apiResourceRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "API_RESOURCE" },
        "resourceId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "required": ["kind", "resourceId", "revision", "fingerprint"],
      "additionalProperties": false
    },
    "flowDraftRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "FLOW_DRAFT" },
        "draftId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "required": ["kind", "draftId", "revision", "fingerprint"],
      "additionalProperties": false
    },
    "flowVersionRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "FLOW_VERSION" },
        "publicationId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "required": ["kind", "publicationId", "revision", "fingerprint"],
      "additionalProperties": false
    },
    "exactSubjectRef": {
      "oneOf": [
        { "$ref": "#/$defs/apiResourceRef" },
        { "$ref": "#/$defs/flowDraftRef" },
        { "$ref": "#/$defs/flowVersionRef" }
      ]
    },
    "operatorVersionRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "OPERATOR_VERSION" },
        "libraryId": { "$ref": "#/$defs/identifier" },
        "libraryRevision": { "$ref": "#/$defs/revision" },
        "operatorRef": { "$ref": "#/$defs/identifier" },
        "contractFingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "required": ["kind", "libraryId", "libraryRevision", "operatorRef", "contractFingerprint"],
      "additionalProperties": false
    },
    "builtinFunctionVersionRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "BUILTIN_FUNCTION_VERSION" },
        "catalogId": { "$ref": "#/$defs/identifier" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "functionName": { "$ref": "#/$defs/identifier" },
        "signatureFingerprint": { "$ref": "#/$defs/fingerprint" },
        "runtimeFingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "required": ["kind", "catalogId", "catalogRevision", "functionName", "signatureFingerprint", "runtimeFingerprint"],
      "additionalProperties": false
    },
    "exactSubjectRefV2": {
      "oneOf": [
        { "$ref": "#/$defs/apiResourceRef" },
        { "$ref": "#/$defs/flowDraftRef" },
        { "$ref": "#/$defs/flowVersionRef" },
        { "$ref": "#/$defs/operatorVersionRef" },
        { "$ref": "#/$defs/builtinFunctionVersionRef" }
      ]
    },
    "composableRef": {
      "oneOf": [
        { "$ref": "#/$defs/apiResourceRef" },
        { "$ref": "#/$defs/flowVersionRef" }
      ]
    },
    "secretWrite": {
      "oneOf": [
        {
          "type": "object", "properties": { "mode": { "const": "VALUE" }, "value": { "type": "string", "minLength": 1 } },
          "required": ["mode", "value"], "additionalProperties": false
        },
        {
          "type": "object", "properties": { "mode": { "const": "SECRET_REF" }, "ref": { "$ref": "#/$defs/secretRef" } },
          "required": ["mode", "ref"], "additionalProperties": false
        },
        {
          "type": "object", "properties": { "mode": { "const": "KEEP_EXISTING" } },
          "required": ["mode"], "additionalProperties": false
        }
      ]
    },
    "safeHeaderMap": {
      "type": "object",
      "patternProperties": { "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$": { "type": "string", "maxLength": 2048 } },
      "propertyNames": { "$ref": "#/$defs/headerName" },
      "additionalProperties": false
    }
  }
}
