{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/fixture-set-command-v2.schema.json",
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "path": { "$ref": "#/$defs/path" }, "operator": { "const": "EQ" }, "value": {} },
          "required": ["path", "operator", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": { "$ref": "#/$defs/path" }, "operator": { "const": "IN" },
            "values": { "type": "array", "minItems": 1, "maxItems": 32, "items": {} }
          },
          "required": ["path", "operator", "values"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "path": { "$ref": "#/$defs/path" }, "operator": { "const": "PRESENT" } },
          "required": ["path", "operator"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "path": { "$ref": "#/$defs/path" }, "operator": { "const": "ABSENT" } },
          "required": ["path", "operator"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": { "$ref": "#/$defs/path" }, "operator": { "const": "NUMBER_RANGE" },
            "minimum": { "type": "number" }, "maximum": { "type": "number" }
          },
          "required": ["path", "operator", "minimum"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": { "$ref": "#/$defs/path" }, "operator": { "const": "NUMBER_RANGE" },
            "maximum": { "type": "number" }
          },
          "required": ["path", "operator", "maximum"],
          "additionalProperties": false
        }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^\\$(?:\\.[A-Za-z0-9_-]+){0,16}$",
      "maxLength": 512
    },
    "condition": {
      "type": "object",
      "properties": {
        "conditionId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "all": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/predicate" } }
      },
      "required": ["conditionId", "all"],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "name": { "$ref": "common-v1.schema.json#/$defs/displayName" },
        "driverInput": {},
        "when": { "$ref": "#/$defs/condition" },
        "controls": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "fixture-set-command-v1.schema.json#/$defs/control" }
        },
        "expect": {
          "type": "object",
          "properties": { "output": {} },
          "required": ["output"],
          "additionalProperties": false
        }
      },
      "required": ["caseId", "name", "controls"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.fixtureSetCommand.v2" },
    "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" },
    "subject": { "$ref": "common-v1.schema.json#/$defs/exactSubjectRefV2" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/case" } }
  },
  "required": ["schemaVersion", "displayName", "subject", "cases"],
  "additionalProperties": false
}
