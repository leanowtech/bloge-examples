{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/fixture-set-summary-v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.fixtureSetSummary.v1" },
    "fixtureSetId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" },
    "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" },
    "subject": { "$ref": "common-v1.schema.json#/$defs/exactSubjectRef" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "name": { "$ref": "common-v1.schema.json#/$defs/displayName" } }, "required": ["caseId", "name"], "additionalProperties": false } },
    "status": { "$ref": "common-v1.schema.json#/$defs/fixtureStatus" },
    "statusRevision": { "$ref": "common-v1.schema.json#/$defs/revision" }
  },
  "required": ["schemaVersion", "fixtureSetId", "revision", "fingerprint", "displayName", "subject", "cases", "status", "statusRevision"],
  "additionalProperties": false
}
