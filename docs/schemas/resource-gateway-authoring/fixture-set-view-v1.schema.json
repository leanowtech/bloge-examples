{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/fixture-set-view-v1.schema.json",
  "type": "object",
  "properties": { "schemaVersion": { "const": "bloge.fixtureSet.v1" }, "fixtureSetId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "revision": { "$ref": "common-v1.schema.json#/$defs/revision" }, "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" }, "statusRevision": { "$ref": "common-v1.schema.json#/$defs/revision" }, "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" }, "subject": { "$ref": "common-v1.schema.json#/$defs/exactSubjectRef" }, "cases": { "type": "array", "minItems": 1, "items": { "$ref": "fixture-set-command-v1.schema.json#/$defs/case" } }, "status": { "enum": ["PRIVATE_DRAFT", "SHARING_PENDING", "TEAM_AVAILABLE", "STALE", "REVOKED"] } },
  "required": ["schemaVersion", "fixtureSetId", "revision", "fingerprint", "statusRevision", "displayName", "subject", "cases", "status"], "additionalProperties": false
}
