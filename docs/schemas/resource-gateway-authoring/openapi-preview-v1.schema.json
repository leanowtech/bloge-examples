{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/openapi-preview-v1.schema.json",
  "$defs": {
    "source": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "INLINE" }, "documentText": { "type": "string", "minLength": 1, "maxLength": 10485760 } }, "required": ["kind", "documentText"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "REMOTE" }, "url": { "type": "string", "pattern": "^https://[^\\s]+$" }, "connectionId": { "$ref": "common-v1.schema.json#/$defs/identifier" } }, "required": ["kind", "url"], "additionalProperties": false }
      ]
    },
    "operation": {
      "type": "object",
      "properties": { "operationId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "method": { "enum": ["GET", "POST", "PUT", "DELETE"] }, "path": { "type": "string", "pattern": "^/" }, "suggestedResource": { "$ref": "api-resource-command-v1.schema.json#/$defs/resourceCommand" }, "diagnostics": { "type": "array", "items": { "type": "object", "properties": { "code": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "message": { "type": "string", "minLength": 1 } }, "required": ["code", "message"], "additionalProperties": false } } },
      "required": ["operationId", "method", "path", "suggestedResource", "diagnostics"], "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.openApiPreviewCommand.v1" },
    "source": { "$ref": "#/$defs/source" },
    "operationIds": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/identifier" } },
    "discoveryId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
  },
  "required": ["schemaVersion", "source"],
  "additionalProperties": false
}
