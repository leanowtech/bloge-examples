{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/reusable-flow-command-v1.schema.json",
  "$defs": {
    "contract": {
      "type": "object",
      "properties": { "input": { "$ref": "common-v1.schema.json#/$defs/schemaEnvelope" }, "output": { "$ref": "common-v1.schema.json#/$defs/schemaEnvelope" } },
      "required": ["input", "output"], "additionalProperties": false
    },
    "mappingSource": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "FLOW_INPUT" }, "path": { "type": "string", "pattern": "^\\$" } }, "required": ["kind", "path"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "NODE_OUTPUT" }, "nodeId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "path": { "type": "string", "pattern": "^\\$" } }, "required": ["kind", "nodeId", "path"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "CONSTANT" }, "value": {} }, "required": ["kind", "value"], "additionalProperties": false }
      ]
    },
    "node": {
      "type": "object",
      "properties": { "nodeId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "label": { "$ref": "common-v1.schema.json#/$defs/displayName" }, "use": { "$ref": "common-v1.schema.json#/$defs/composableRef" }, "inputs": { "type": "array", "items": { "type": "object", "properties": { "to": { "type": "string", "pattern": "^\\$" }, "from": { "$ref": "#/$defs/mappingSource" } }, "required": ["to", "from"], "additionalProperties": false } } },
      "required": ["nodeId", "label", "use", "inputs"], "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": { "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }, "output": { "type": "object", "properties": { "nodeId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "path": { "type": "string", "pattern": "^\\$" } }, "required": ["nodeId", "path"], "additionalProperties": false } },
      "required": ["nodes", "output"], "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": { "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" }, "kind": { "enum": ["TOOL", "SOLUTION"] }, "description": { "type": "string", "maxLength": 2000 }, "contract": { "$ref": "#/$defs/contract" }, "graph": { "$ref": "#/$defs/graph" }, "layout": { "$ref": "#/$defs/layout" } },
      "required": ["displayName", "kind", "description", "contract", "graph", "layout"], "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": { "nodes": { "type": "object", "patternProperties": { "^[A-Za-z0-9][A-Za-z0-9._:-]*$": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "required": ["x", "y"], "additionalProperties": false } }, "additionalProperties": false } },
      "required": ["nodes"], "additionalProperties": false
    }
  },
  "type": "object",
  "properties": { "schemaVersion": { "const": "bloge.reusableFlowSaveCommand.v1" }, "flow": { "$ref": "#/$defs/flow" } },
  "required": ["schemaVersion", "flow"], "additionalProperties": false
}
