{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/reusable-flow-version-v1.schema.json",
  "type": "object",
  "properties": { "schemaVersion": { "const": "bloge.reusableFlowVersion.v1" }, "publicationId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "revision": { "$ref": "common-v1.schema.json#/$defs/revision" }, "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" }, "source": { "type": "object", "properties": { "draftId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "revision": { "$ref": "common-v1.schema.json#/$defs/revision" }, "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" } }, "required": ["draftId", "revision", "fingerprint"], "additionalProperties": false }, "flowId": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "displayName": { "$ref": "common-v1.schema.json#/$defs/displayName" }, "kind": { "enum": ["TOOL", "SOLUTION"] }, "description": { "type": "string", "maxLength": 2000 }, "contract": { "$ref": "reusable-flow-command-v1.schema.json#/$defs/contract" }, "graph": { "$ref": "reusable-flow-command-v1.schema.json#/$defs/graph" }, "publishedAt": { "type": "string", "format": "date-time" }, "publishedBy": { "$ref": "common-v1.schema.json#/$defs/identifier" }, "status": { "const": "PUBLISHED" } },
  "required": ["schemaVersion", "publicationId", "revision", "fingerprint", "source", "flowId", "displayName", "kind", "description", "contract", "graph", "publishedAt", "publishedBy", "status"], "additionalProperties": false
}
