{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-authoring/simulation-command-v2.schema.json",
  "$defs": {
    "exactFixtureSetRef": {
      "type": "object",
      "properties": {
        "fixtureSetId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
        "fingerprint": { "$ref": "common-v1.schema.json#/$defs/fingerprint" }
      },
      "required": ["fixtureSetId", "revision", "fingerprint"],
      "additionalProperties": false
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "INLINE" }, "value": {} },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "CASE_INPUT" },
            "fixtureSet": { "$ref": "#/$defs/exactFixtureSetRef" },
            "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" }
          },
          "required": ["kind", "fixtureSet", "caseId"],
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "SUBJECT" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "NODE_PATH" },
            "nodePath": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": { "$ref": "common-v1.schema.json#/$defs/identifier" }
            }
          },
          "required": ["kind", "nodePath"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "CALL_SITE" },
            "nodePath": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": { "$ref": "common-v1.schema.json#/$defs/identifier" }
            },
            "callSiteId": { "$ref": "common-v1.schema.json#/$defs/identifier" }
          },
          "required": ["kind", "nodePath", "callSiteId"],
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "EXACT_CASE" },
            "fixtureSet": { "$ref": "#/$defs/exactFixtureSetRef" },
            "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" }
          },
          "required": ["kind", "fixtureSet", "caseId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "MATCH_CONDITION" },
            "fixtureSet": { "$ref": "#/$defs/exactFixtureSetRef" },
            "conditionId": { "$ref": "common-v1.schema.json#/$defs/identifier" }
          },
          "required": ["kind", "fixtureSet", "conditionId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "AUTO_MATCH" },
            "fixtureSet": { "$ref": "#/$defs/exactFixtureSetRef" }
          },
          "required": ["kind", "fixtureSet"],
          "additionalProperties": false
        }
      ]
    },
    "fixturePlan": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "NONE" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "CASE_CONTROLS" },
            "fixtureSet": { "$ref": "#/$defs/exactFixtureSetRef" },
            "caseId": { "$ref": "common-v1.schema.json#/$defs/identifier" },
            "unmatched": { "enum": ["BLOCK", "REAL"] }
          },
          "required": ["kind", "fixtureSet", "caseId", "unmatched"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "BINDINGS" },
            "unmatched": { "enum": ["BLOCK", "REAL"] },
            "bindings": {
              "type": "array", "minItems": 1, "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "target": { "$ref": "#/$defs/target" },
                  "selection": { "$ref": "#/$defs/selection" }
                },
                "required": ["target", "selection"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "unmatched", "bindings"],
          "additionalProperties": false
        }
      ]
    },
    "executionPolicy": {
      "type": "object",
      "properties": {
        "externalReads": {
          "oneOf": [
            {
              "type": "object", "properties": { "kind": { "const": "DENY" } },
              "required": ["kind"], "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "ALLOW_EXACT" },
                "resources": {
                  "type": "array", "minItems": 1, "maxItems": 64,
                  "items": { "$ref": "common-v1.schema.json#/$defs/apiResourceRef" }
                },
                "justification": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "required": ["kind", "resources", "justification"],
              "additionalProperties": false
            }
          ]
        },
        "externalWrites": {
          "type": "object",
          "properties": { "kind": { "const": "DENY" } },
          "required": ["kind"],
          "additionalProperties": false
        }
      },
      "required": ["externalReads", "externalWrites"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "bloge.simulationCommand.v2" },
    "subject": { "$ref": "common-v1.schema.json#/$defs/exactSubjectRefV2" },
    "input": { "$ref": "#/$defs/input" },
    "fixturePlan": { "$ref": "#/$defs/fixturePlan" },
    "executionPolicy": {
      "$ref": "#/$defs/executionPolicy",
      "default": { "externalReads": { "kind": "DENY" }, "externalWrites": { "kind": "DENY" } }
    }
  },
  "required": ["schemaVersion", "subject", "input", "fixturePlan"],
  "additionalProperties": false
}
