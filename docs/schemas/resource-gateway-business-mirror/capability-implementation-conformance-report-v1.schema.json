{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-business-mirror/capability-implementation-conformance-report-v1.schema.json",
  "title": "Capability Implementation Conformance Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "conformanceId", "fingerprint", "scope", "proposalDraftRef", "simulationEvidenceRef", "implementationBindingRef", "targetCapabilityRef", "graphRef", "acceptanceSuiteRefs", "status", "cases", "startedAt", "completedAt", "limitations", "uncertainties"],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.capabilityImplementationConformanceReport.v1" },
    "conformanceId": { "$ref": "business-mirror-common-v1.schema.json#/$defs/identifier" },
    "fingerprint": { "$ref": "business-mirror-common-v1.schema.json#/$defs/fingerprint" },
    "scope": { "$ref": "business-mirror-common-v1.schema.json#/$defs/scope" },
    "proposalDraftRef": { "$ref": "#/$defs/proposalDraftRef" },
    "simulationEvidenceRef": { "$ref": "#/$defs/simulationEvidenceRef" },
    "implementationBindingRef": { "$ref": "#/$defs/implementationBindingRef" },
    "targetCapabilityRef": { "$ref": "#/$defs/capabilityRef" },
    "graphRef": { "$ref": "#/$defs/graphRef" },
    "acceptanceSuiteRefs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/testSuiteRef" } },
    "status": { "enum": ["PASSED", "FAILED"] },
    "cases": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/caseComparison" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "limitations": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" },
    "uncertainties": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" }
  },
  "$defs": {
    "proposalDraftRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "CAPABILITY_PROPOSAL_DRAFT" } }, "required": ["kind"] }] },
    "simulationEvidenceRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "PROPOSAL_SIMULATION_EVIDENCE" } }, "required": ["kind"] }] },
    "implementationBindingRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "PROPOSAL_IMPLEMENTATION_BINDING" } }, "required": ["kind"] }] },
    "capabilityRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "CAPABILITY" } }, "required": ["kind"] }] },
    "graphRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "GRAPH_DRAFT" } }, "required": ["kind"] }] },
    "testSuiteRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "TEST_SUITE" } }, "required": ["kind"] }] },
    "fixtureRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "FIXTURE_BUNDLE" } }, "required": ["kind"] }] },
    "mirrorEvidenceRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "MIRROR_EVIDENCE_BUNDLE" } }, "required": ["kind"] }] },
    "caseComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "caseType", "suiteRef", "fixtureRef", "baselineMirrorEvidenceBundleRef", "implementationEvidence", "baselineRunStatus", "baselineSemanticResultFingerprint", "baselineBehaviorFingerprint", "implementationBehaviorFingerprint", "comparison", "baselineTargetCallCount", "implementationTargetCallCount", "targetInvocationSiteIds", "mismatchReasons", "limitations"],
      "properties": {
        "caseId": { "$ref": "business-mirror-common-v1.schema.json#/$defs/identifier" },
        "caseType": { "enum": ["GOLDEN", "NEGATIVE", "BOUNDARY", "REGRESSION"] },
        "suiteRef": { "$ref": "#/$defs/testSuiteRef" },
        "fixtureRef": { "$ref": "#/$defs/fixtureRef" },
        "baselineMirrorEvidenceBundleRef": { "$ref": "#/$defs/mirrorEvidenceRef" },
        "implementationEvidence": { "$ref": "capability-implementation-test-evidence-v1.schema.json" },
        "baselineRunStatus": { "type": "string", "minLength": 1, "maxLength": 64 },
        "baselineSemanticResultFingerprint": { "$ref": "business-mirror-common-v1.schema.json#/$defs/fingerprint" },
        "baselineBehaviorFingerprint": { "$ref": "business-mirror-common-v1.schema.json#/$defs/fingerprint" },
        "implementationBehaviorFingerprint": { "$ref": "business-mirror-common-v1.schema.json#/$defs/fingerprint" },
        "comparison": { "enum": ["MATCH", "MISMATCH"] },
        "baselineTargetCallCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "implementationTargetCallCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "targetInvocationSiteIds": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
        "mismatchReasons": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" },
        "limitations": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" }
      }
    }
  }
}
