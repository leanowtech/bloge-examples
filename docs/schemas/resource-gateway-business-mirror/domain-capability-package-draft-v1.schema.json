{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-business-mirror/domain-capability-package-draft-v1.schema.json",
  "title": "Resource Gateway Domain Capability Package Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "revision", "scope", "businessDefinition", "packageContractRef", "capabilityRefs", "graphRefs", "proposalRefs", "stateModelRefs", "effectModelRefs", "scenarioInventoryRef", "scenarioPackRefs", "solutionRefs", "carrierRefs", "channelRefs", "fidelityInventoryRef", "outcomeDefinitionRefs", "limitations", "assumptions", "expiresAt", "provenance", "lifecycle"],
  "properties": {
    "schemaVersion": { "const": "bloge.domainCapabilityPackageDraft.v1" },
    "packageId": { "$ref": "business-mirror-common-v1.schema.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 0 },
    "scope": { "$ref": "business-mirror-common-v1.schema.json#/$defs/scope" },
    "businessDefinition": { "$ref": "business-mirror-common-v1.schema.json#/$defs/businessDefinition" },
    "packageContractRef": { "oneOf": [{ "$ref": "#/$defs/contractRef" }, { "type": "null" }] },
    "capabilityRefs": { "$ref": "#/$defs/capabilityRefs" },
    "graphRefs": { "$ref": "#/$defs/graphRefs" },
    "proposalRefs": { "$ref": "#/$defs/proposalRefs" },
    "stateModelRefs": { "$ref": "#/$defs/stateModelRefs" },
    "effectModelRefs": { "$ref": "#/$defs/effectModelRefs" },
    "scenarioInventoryRef": { "oneOf": [{ "$ref": "#/$defs/scenarioInventoryRef" }, { "type": "null" }] },
    "scenarioPackRefs": { "$ref": "#/$defs/scenarioPackRefs" },
    "solutionRefs": { "$ref": "#/$defs/solutionRefs" },
    "carrierRefs": { "$ref": "#/$defs/carrierRefs" },
    "channelRefs": { "$ref": "#/$defs/channelRefs" },
    "fidelityInventoryRef": { "oneOf": [{ "$ref": "#/$defs/fidelityInventoryRef" }, { "type": "null" }] },
    "outcomeDefinitionRefs": { "$ref": "#/$defs/outcomeDefinitionRefs" },
    "limitations": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" },
    "assumptions": { "$ref": "business-mirror-common-v1.schema.json#/$defs/textList" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "provenance": { "$ref": "https://bloge.dev/schemas/resource-gateway-mirror/artifact-provenance-v1.schema.json" },
    "lifecycle": { "enum": ["DRAFT", "READY_FOR_REVIEW", "SUBMITTED", "SUPERSEDED"] }
  },
  "$defs": {
    "contractRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "CONTRACT" } } }] },
    "capabilityRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "CAPABILITY" } } }] } },
    "graphRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "GRAPH_DRAFT" } } }] } },
    "proposalRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "CAPABILITY_PROPOSAL" } } }] } },
    "stateModelRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "STATE_MODEL" } } }] } },
    "effectModelRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "enum": ["EFFECT_CONTRACT", "WRITE_EFFECT"] } } }] } },
    "scenarioInventoryRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "SCENARIO_INVENTORY" } } }] },
    "scenarioPackRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "SCENARIO_PACK" } } }] } },
    "solutionRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/businessAssetRef" }, { "properties": { "layer": { "const": "L1_SERVICE_DESIGN" }, "kind": { "const": "SOLUTION" } } }] } },
    "carrierRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/businessAssetRef" }, { "properties": { "layer": { "const": "L2_SERVICE_CARRIER" }, "kind": { "enum": ["SOP", "AGENT", "WORKFLOW"] } } }] } },
    "channelRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/businessAssetRef" }, { "properties": { "layer": { "const": "L3_APPLICATION" }, "kind": { "const": "CHANNEL_APPLICATION" } } }] } },
    "fidelityInventoryRef": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "DOMAIN_FIDELITY_INVENTORY" } } }] },
    "outcomeDefinitionRefs": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "allOf": [{ "$ref": "business-mirror-common-v1.schema.json#/$defs/artifactRef" }, { "properties": { "kind": { "const": "OUTCOME_DEFINITION" } } }] } }
  }
}
