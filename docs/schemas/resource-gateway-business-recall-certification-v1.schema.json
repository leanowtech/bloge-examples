{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-business-recall-certification-v1.schema.json",
  "title": "Resource Gateway business Solution Codex certification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "certifiedAt", "repositoryCommit", "productionTreeFingerprint", "certificationInputsFingerprint", "codexVersion", "runtimeIdentity", "setupIdentity", "suite", "transport", "cases", "familyEvidence", "journey", "correlation", "metrics", "assertions", "result", "certificateFingerprint"],
  "properties": {
    "schemaVersion": { "const": "rg.businessRecallCertification.v1" },
    "certifiedAt": { "type": "string", "minLength": 1 },
    "repositoryCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "productionTreeFingerprint": { "$ref": "#/$defs/sha256" },
    "certificationInputsFingerprint": { "$ref": "#/$defs/sha256" },
    "codexVersion": { "type": "string", "minLength": 1 },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "instanceNonceFingerprints", "codexPhaseCount", "repositoryCommit", "jarSha256", "processOwnershipVerified", "verifiedBeforeAndAfterTurn"],
      "properties": {
        "schemaVersion": { "const": "rg.agentTddCertificationInstance.v1" },
        "instanceNonceFingerprints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "codexPhaseCount": { "const": 4 },
        "repositoryCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "jarSha256": { "$ref": "#/$defs/sha256" },
        "processOwnershipVerified": { "const": true },
        "verifiedBeforeAndAfterTurn": { "const": true }
      }
    },
    "setupIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupFingerprint", "seedManifestFingerprint", "relationshipCount", "actorSeparationVerified", "actorSeparationFingerprint"],
      "properties": {
        "setupFingerprint": { "$ref": "#/$defs/sha256" },
        "seedManifestFingerprint": { "$ref": "#/$defs/hmac" },
        "relationshipCount": { "const": 5 },
        "actorSeparationVerified": { "const": true },
        "actorSeparationFingerprint": { "$ref": "#/$defs/hmac" }
      }
    },
    "suite": { "const": "business-solution-recall-v1" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "endpointClass", "serverCount", "serverListFiltered", "directHiddenCallRejected", "surfaceProofFingerprint"],
      "properties": {
        "kind": { "const": "HTTP_MCP" },
        "endpointClass": { "const": "LOOPBACK" },
        "serverCount": { "const": 2 },
        "serverListFiltered": { "const": true },
        "directHiddenCallRejected": { "const": true },
        "surfaceProofFingerprint": { "$ref": "#/$defs/hmac" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        { "contains": { "properties": { "expectedIntentKind": { "const": "CREATE_SOLUTION" } }, "required": ["expectedIntentKind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "expectedIntentKind": { "const": "RECALL_CAPABILITY" } }, "required": ["expectedIntentKind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "expectedIntentKind": { "const": "DEFINE_FEATURE" } }, "required": ["expectedIntentKind"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseFingerprint", "expectedIntentKind", "observedSurface", "capabilityOutcome", "selectedContractFingerprint", "toolSequenceClass", "humanBoundaryRespected", "controlledAssumptionClass", "egressDeniedCount", "goldenCaseCurrent"],
        "properties": {
          "caseFingerprint": { "$ref": "#/$defs/hmac" },
          "expectedIntentKind": { "enum": ["CREATE_SOLUTION", "RECALL_CAPABILITY", "DEFINE_FEATURE"] },
          "observedSurface": { "const": "BUSINESS_SOLUTION" },
          "capabilityOutcome": { "enum": ["EXACT", "PARTIAL", "CONFLICT", "AMBIGUOUS", "INCOMPLETE", "CLARIFIED", "NONE"] },
          "selectedContractFingerprint": {
            "oneOf": [{ "$ref": "#/$defs/hmac" }, { "type": "null" }]
          },
          "toolSequenceClass": { "const": "VALID" },
          "humanBoundaryRespected": { "const": true },
          "controlledAssumptionClass": { "enum": ["NOT_OBSERVED", "NOT_APPLICABLE"] },
          "egressDeniedCount": { "const": 0 },
          "goldenCaseCurrent": { "type": ["boolean", "null"] }
        }
      }
    },
    "familyEvidence": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "allOf": [
        { "contains": { "properties": { "familyId": { "const": "synonym-rewrite" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "near-meaning-distractor" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "boundary-unspecified" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "unknown-policy-unspecified" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "authority-source-unspecified" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "multiple-exact" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "legacy-feature-partial" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "surface-interference" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "cross-session-rediscovery" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "semantic-drift" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "fact-assumption" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "dependency-unavailable" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "action-stubbing" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "forbidden-dependency" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "familyId": { "const": "assumption-ambiguity" } }, "required": ["familyId"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "caseFingerprint", "sessionFingerprint", "expectedBehaviorClass", "observedOutcome", "firstTool", "toolRecallPassed", "passed"],
        "allOf": [
          { "if": { "properties": { "familyId": { "enum": ["synonym-rewrite", "near-meaning-distractor"] } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "RECALL_TOP1" }, "observedOutcome": { "const": "TOP1_MATCH" } } } },
          { "if": { "properties": { "familyId": { "enum": ["boundary-unspecified", "unknown-policy-unspecified", "authority-source-unspecified"] } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "CLARIFICATION_REQUIRED" }, "observedOutcome": { "const": "SINGLE_BUSINESS_QUESTION" } } } },
          { "if": { "properties": { "familyId": { "const": "multiple-exact" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "AMBIGUITY_REJECTED" }, "observedOutcome": { "const": "AMBIGUOUS_STOP" } } } },
          { "if": { "properties": { "familyId": { "const": "legacy-feature-partial" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "PARTIAL_REUSE_REJECTED" }, "observedOutcome": { "const": "PARTIAL_STOP" } } } },
          { "if": { "properties": { "familyId": { "const": "surface-interference" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "BUSINESS_SURFACE_ISOLATED" }, "observedOutcome": { "const": "BUSINESS_SURFACE_ONLY" } } } },
          { "if": { "properties": { "familyId": { "const": "cross-session-rediscovery" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "CURRENT_STATE_REDISCOVERED" }, "observedOutcome": { "const": "CURRENT_STATE_FOUND" } } } },
          { "if": { "properties": { "familyId": { "const": "semantic-drift" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "SEMANTIC_RECONFIRMATION_REQUIRED" }, "observedOutcome": { "const": "RECONFIRMATION_STOP" } } } },
          { "if": { "properties": { "familyId": { "const": "fact-assumption" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "FACT_ASSUMPTION_PROPOSED" }, "observedOutcome": { "const": "GIVEN_FACT_CAPTURED" } } } },
          { "if": { "properties": { "familyId": { "const": "dependency-unavailable" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "UNAVAILABLE_ASSUMPTION_CAPTURED" }, "observedOutcome": { "const": "UNAVAILABLE_CAPTURED" } } } },
          { "if": { "properties": { "familyId": { "const": "action-stubbing" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "SIDE_EFFECT_STUB_CAPTURED" }, "observedOutcome": { "const": "SIDE_EFFECT_STUB_CAPTURED" } } } },
          { "if": { "properties": { "familyId": { "const": "forbidden-dependency" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "FORBIDDEN_DEPENDENCY_CAPTURED" }, "observedOutcome": { "const": "MUST_NOT_USE_CAPTURED" } } } },
          { "if": { "properties": { "familyId": { "const": "assumption-ambiguity" } } }, "then": { "properties": { "expectedBehaviorClass": { "const": "ASSUMPTION_AMBIGUITY_REJECTED" }, "observedOutcome": { "const": "ASSUMPTION_AMBIGUOUS_STOP" } } } }
        ],
        "properties": {
          "familyId": { "enum": ["synonym-rewrite", "near-meaning-distractor", "boundary-unspecified", "unknown-policy-unspecified", "authority-source-unspecified", "multiple-exact", "legacy-feature-partial", "surface-interference", "cross-session-rediscovery", "semantic-drift", "fact-assumption", "dependency-unavailable", "action-stubbing", "forbidden-dependency", "assumption-ambiguity"] },
          "caseFingerprint": { "$ref": "#/$defs/hmac" },
          "sessionFingerprint": { "$ref": "#/$defs/hmac" },
          "expectedBehaviorClass": { "enum": ["RECALL_TOP1", "CLARIFICATION_REQUIRED", "AMBIGUITY_REJECTED", "PARTIAL_REUSE_REJECTED", "BUSINESS_SURFACE_ISOLATED", "CURRENT_STATE_REDISCOVERED", "SEMANTIC_RECONFIRMATION_REQUIRED", "FACT_ASSUMPTION_PROPOSED", "UNAVAILABLE_ASSUMPTION_CAPTURED", "SIDE_EFFECT_STUB_CAPTURED", "FORBIDDEN_DEPENDENCY_CAPTURED", "ASSUMPTION_AMBIGUITY_REJECTED"] },
          "observedOutcome": { "enum": ["TOP1_MATCH", "SINGLE_BUSINESS_QUESTION", "AMBIGUOUS_STOP", "PARTIAL_STOP", "BUSINESS_SURFACE_ONLY", "CURRENT_STATE_FOUND", "RECONFIRMATION_STOP", "GIVEN_FACT_CAPTURED", "UNAVAILABLE_CAPTURED", "SIDE_EFFECT_STUB_CAPTURED", "MUST_NOT_USE_CAPTURED", "ASSUMPTION_AMBIGUOUS_STOP"] },
          "firstTool": { "type": "string", "pattern": "^rg\\." },
          "toolRecallPassed": { "const": true },
          "passed": { "const": true }
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "requiredSequence", "successfulPositions", "observedCalls"],
      "properties": {
        "phase": { "const": "BUSINESS_AUTHORING_TO_HUMAN_GOLDEN_REVIEW" },
        "requiredSequence": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
        "successfulPositions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 5 },
        "observedCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "server", "tool", "status"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "server": { "enum": ["rg_read", "rg_author"] },
              "tool": { "type": "string", "pattern": "^rg\\." },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "journey", "solution", "caseSet", "cases", "librarySnapshot", "authoringPatterns", "sessions"],
      "properties": {
        "method": { "const": "EPHEMERAL_HMAC_SHA256" },
        "journey": { "$ref": "#/$defs/hmac" },
        "solution": { "$ref": "#/$defs/hmac" },
        "caseSet": { "$ref": "#/$defs/hmac" },
        "cases": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/hmac" } },
        "librarySnapshot": { "$ref": "#/$defs/hmac" },
        "authoringPatterns": { "$ref": "#/$defs/hmac" },
        "sessions": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hmac" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolRecallRate", "recallAt3", "top1", "clarificationRate", "recallCases", "clarificationCases", "unsafeEscapeCount", "controlledTestEgressCount", "staleGoldenAcceptedCount"],
      "properties": {
        "toolRecallRate": { "const": 1.0 },
        "recallAt3": { "const": 1.0 },
        "top1": { "type": "number", "minimum": 0.95, "maximum": 1 },
        "clarificationRate": { "const": 1.0 },
        "recallCases": { "const": 2 },
        "clarificationCases": { "const": 7 },
        "unsafeEscapeCount": { "const": 0 },
        "controlledTestEgressCount": { "type": "null" },
        "staleGoldenAcceptedCount": { "type": "null" }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onlyBusinessSurfaceMcpActionsObserved", "journeyRevisionLineCurrent", "libraryAndCapabilityDiscoveryObserved", "compilerValidatedAuthoringPatternsObservedBeforeCreation", "fourEntityWritesBoundToAuthoringPatterns", "fourEntityBusinessDisplaysDeclared", "solutionContextCurrent", "completeGoldenCasesProposed", "sameJourneySolutionAndCaseSet", "pendingCasesVisibleForHumanReview", "stoppedBeforeApprovalExecutionAndPublication", "finalSummaryBusinessOnly", "rawArgumentsResultsAndMessagesOmitted", "spawnedRuntimeIdentityVerified", "independentCodexSessionsObserved", "serverSurfaceListFiltered", "serverSurfaceDirectCallRejected", "setupActorSeparated", "crossSessionFeatureRecallCorrelated", "clarificationStoppedBeforeAuthoring", "singleBusinessQuestionObserved", "allRequiredRecallFamiliesObserved"],
      "properties": {
        "onlyBusinessSurfaceMcpActionsObserved": { "const": true },
        "journeyRevisionLineCurrent": { "const": true },
        "libraryAndCapabilityDiscoveryObserved": { "const": true },
        "compilerValidatedAuthoringPatternsObservedBeforeCreation": { "const": true },
        "fourEntityWritesBoundToAuthoringPatterns": { "const": true },
        "fourEntityBusinessDisplaysDeclared": { "const": true },
        "solutionContextCurrent": { "const": true },
        "completeGoldenCasesProposed": { "const": true },
        "sameJourneySolutionAndCaseSet": { "const": true },
        "pendingCasesVisibleForHumanReview": { "const": true },
        "stoppedBeforeApprovalExecutionAndPublication": { "const": true },
        "finalSummaryBusinessOnly": { "const": true },
        "rawArgumentsResultsAndMessagesOmitted": { "const": true },
        "spawnedRuntimeIdentityVerified": { "const": true },
        "independentCodexSessionsObserved": { "const": true },
        "serverSurfaceListFiltered": { "const": true },
        "serverSurfaceDirectCallRejected": { "const": true },
        "setupActorSeparated": { "const": true },
        "crossSessionFeatureRecallCorrelated": { "const": true },
        "clarificationStoppedBeforeAuthoring": { "const": true },
        "singleBusinessQuestionObserved": { "const": true },
        "allRequiredRecallFamiliesObserved": { "const": true }
      }
    },
    "result": { "const": "CERTIFIED" },
    "certificateFingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hmac": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
  }
}
