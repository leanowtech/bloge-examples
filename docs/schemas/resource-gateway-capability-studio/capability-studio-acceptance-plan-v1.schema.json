{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-acceptance-plan-v1.schema.json",
  "title": "Capability Studio Acceptance Plan v1",
  "description": "Wire schema for AcceptancePlanSource. Schema guarantees size/shape only; semantic exactness (IDs, uniqueness, 9x3 matrix completeness) is verified by Compiler. catalogRef binding to catalog raw fingerprint is verified by Compiler semantic check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "revision",
    "compilerProfile",
    "catalogId",
    "catalogRef",
    "obligationSet",
    "primitives",
    "terminalGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.capability-studio.acceptance-plan.v1"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "compilerProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "const": "formal-evidence-v1"
    },
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "catalogRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "obligationSet": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z]{2}-[A-Z]{4}-v[0-9]+$",
      "const": "RG-CS-FELT-v1"
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "typeId",
          "revision",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "typeId": {
            "enum": [
              "VERIFY_FIXED_MATERIAL_V1",
              "VERIFY_FORMAL_INPUT_TREE_V1",
              "RUN_PROVIDER_CONFORMANCE_V2",
              "EXECUTE_LEASE_EVIDENCE_V1",
              "VERIFY_DURABLE_WRAPPER_V1",
              "VERIFY_PACKAGED_FELT_MATRICES_V1",
              "VERIFY_MATERIAL_POSTFLIGHT_V1",
              "COMMIT_LOCAL_PROOF_BUNDLE_V1"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "inputSlot": {
            "enum": [
              "AUTHORITY",
              "TARGET"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "terminalGate": {
      "const": "DEVELOPMENT_VERIFIED_ONLY"
    }
  }
}