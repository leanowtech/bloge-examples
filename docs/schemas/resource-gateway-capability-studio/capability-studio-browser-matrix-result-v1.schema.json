{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-capability-studio/capability-studio-browser-matrix-result-v1.schema.json",
  "title": "Capability Studio Browser Matrix Result v1",
  "description": "Strict, payload-free Stage 0 browser acceptance result. The fixed matrix and aggregate status require independent Test Kit verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "revision",
    "contractId",
    "contractRevision",
    "candidate",
    "baselineRef",
    "environment",
    "executionWindow",
    "resultStatus",
    "matrix",
    "cells",
    "summary",
    "evidenceClosureFingerprint",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "bloge.capabilityStudioBrowserMatrixResult.v1" },
    "resultId": { "type": "string", "pattern": "^BMR-[A-Za-z0-9._-]{1,120}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "contractId": { "const": "S0-AC-01" },
    "contractRevision": { "$ref": "#/$defs/safeRef" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "baselineRef": { "$ref": "#/$defs/baselineRef" },
    "environment": { "$ref": "#/$defs/environment" },
    "executionWindow": { "$ref": "#/$defs/executionWindow" },
    "resultStatus": { "enum": ["COMPLETE", "INCOMPLETE", "FAILED"] },
    "matrix": { "$ref": "#/$defs/matrix" },
    "cells": {
      "type": "array",
      "minItems": 0,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/cell" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "evidenceClosureFingerprint": { "$ref": "#/$defs/fingerprint" },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "resultStatus": { "const": "COMPLETE" } } },
      "then": { "properties": { "diagnostics": { "maxItems": 0 } } },
      "else": { "properties": { "diagnostics": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildRef",
        "revision",
        "artifactFingerprint",
        "sourceCommit",
        "sourceTreeStatus"
      ],
      "properties": {
        "buildRef": { "$ref": "#/$defs/safeRef" },
        "revision": { "$ref": "#/$defs/safeRef" },
        "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "sourceTreeStatus": { "enum": ["CLEAN", "DIRTY"] }
      }
    },
    "baselineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/safeRef" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentFingerprint",
        "profile",
        "browserName",
        "browserVersion",
        "driverVersion",
        "axeVersion"
      ],
      "properties": {
        "environmentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "profile": { "$ref": "#/$defs/safeRef" },
        "browserName": { "$ref": "#/$defs/safeRef" },
        "browserVersion": { "$ref": "#/$defs/safeRef" },
        "driverVersion": { "$ref": "#/$defs/safeRef" },
        "axeVersion": { "$ref": "#/$defs/safeRef" }
      }
    },
    "executionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "goldenPathId": {
      "enum": [
        "GP-01", "GP-02", "GP-03", "GP-04", "GP-05",
        "GP-06", "GP-07", "GP-08", "GP-09", "GP-10"
      ]
    },
    "locale": { "enum": ["zh-CN", "en-US"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "fixedViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "enum": [1440, 1024, 390] },
        "height": { "enum": [900, 768, 844] }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixId",
        "goldenPathIds",
        "locales",
        "viewports",
        "expectedCellCount"
      ],
      "properties": {
        "matrixId": { "const": "S0-AC-01.browser.v1" },
        "goldenPathIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/goldenPathId" }
        },
        "locales": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/locale" }
        },
        "viewports": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fixedViewport" }
        },
        "expectedCellCount": { "const": 60 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "fingerprint"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/safeRef" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "axe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serious", "critical"],
      "properties": {
        "serious": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 }
      }
    },
    "keyboardPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "stepCount", "focusLossCount"],
      "properties": {
        "completed": { "type": "boolean" },
        "stepCount": { "type": "integer", "minimum": 0 },
        "focusLossCount": { "type": "integer", "minimum": 0 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellId",
        "goldenPathId",
        "locale",
        "viewport",
        "actualInnerViewport",
        "status",
        "pageHorizontalOverflow",
        "axe",
        "technicalIdCount",
        "rawJsonCount",
        "keyboardPath",
        "evidenceRefs",
        "p0Count",
        "p1Count"
      ],
      "properties": {
        "cellId": {
          "type": "string",
          "pattern": "^GP-[0-9]{2}:(zh-CN|en-US):[0-9]{2,4}x[0-9]{2,4}$"
        },
        "goldenPathId": { "$ref": "#/$defs/goldenPathId" },
        "locale": { "$ref": "#/$defs/locale" },
        "viewport": { "$ref": "#/$defs/fixedViewport" },
        "actualInnerViewport": {
          "anyOf": [
            { "$ref": "#/$defs/viewport" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["PASS", "NOT_RUN", "SKIPPED", "FAIL"] },
        "pageHorizontalOverflow": { "type": "boolean" },
        "axe": { "$ref": "#/$defs/axe" },
        "technicalIdCount": { "type": "integer", "minimum": 0 },
        "rawJsonCount": { "type": "integer", "minimum": 0 },
        "keyboardPath": { "$ref": "#/$defs/keyboardPath" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "p0Count": { "type": "integer", "minimum": 0 },
        "p1Count": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCellCount",
        "actualCellCount",
        "passCellCount",
        "incompleteCellCount",
        "failedCellCount",
        "skippedCount",
        "p0Count",
        "p1Count",
        "evidenceRefCount"
      ],
      "properties": {
        "expectedCellCount": { "const": 60 },
        "actualCellCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "passCellCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "incompleteCellCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "failedCellCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "skippedCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "p0Count": { "type": "integer", "minimum": 0 },
        "p1Count": { "type": "integer", "minimum": 0 },
        "evidenceRefCount": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
        }
      }
    }
  }
}
