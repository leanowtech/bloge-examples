        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "CODESOURCE_INDEPENDENCE"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "REVIEW_SIGNATURE_AUTHORITY"
                },
                "admissionTarget": {
                  "const": "review:INDEPENDENT_TRUSTED_REVIEW"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "REVIEW_COUNT_CONSISTENCY_REJECTED"
                },
                "admissionTarget": {
                  "const": "guard:REVIEW_COUNT_CONSISTENCY_REJECTED"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "ROLLBACK_BINDING"
                },
                "admissionTarget": {
                  "const": "artifact:GATE_VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A2_CONCLUSION_PRECEDENCE"
                },
                "admissionTarget": {
                  "const": "artifact:GATE_VERIFIER"
                }
              }
            }
          ]
        },
