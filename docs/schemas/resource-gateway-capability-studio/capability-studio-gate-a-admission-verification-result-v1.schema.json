                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "PROVIDER_NAMESPACE_COLLISION_REJECTED"
                },
                "admissionTarget": {
                  "const": "guard:PROVIDER_NAMESPACE_COLLISION_REJECTED"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "PIN_LIFECYCLE_BINDING"
                },
                "admissionTarget": {
                  "const": "artifact:GATE_VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
