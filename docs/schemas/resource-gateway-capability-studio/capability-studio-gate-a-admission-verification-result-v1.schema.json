{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-admission-verification-result-v1.schema.json",
  "title": "Capability Studio Gate A admission verification result v1",
  "$comment": "A2 MUST recompute the cross-document priority UNAVAILABLE > FAIL > OPEN > PASS, all fingerprints, raw material closure, time ordering, review counts, rollback binding, and candidate independence. The schema freezes slot identity/order, local status/ref consistency, and the conclusion/reason/next-gate discriminant; it intentionally does not derive conclusion from slot values. semanticGuardResults is a fixed diagnostic projection over the Guard Catalog; it does not add a new admission denominator or make producer facts authoritative. sourceFactIds is structurally limited to Authority Matrix facts that are not ADMISSION_DECISION; exact Guard-specific order and the dynamic observationRefs canonical order/uniqueness are Semantic Guard responsibilities. A Schema-valid PASS with any failed or missing slot is intentionally allowed so A2_CONCLUSION_PRECEDENCE, not JSON Schema, rejects the forged conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion",
    "gateId",
    "gateRevision",
    "resultId",
    "conclusion",
    "conclusionReasonCode",
    "gateResultRef",
    "admissionTrustPinRef",
    "challengeTrustPinRef",
    "admissionEvidenceRootRef",
    "gateVerifierCodeSource",
    "gateVerifierBuildIdentityRef",
    "rollback",
    "requirements",
    "artifacts",
    "tests",
    "mandatoryGuards",
    "trustedReview",
    "semanticGuardResults",
    "formalPassCount",
    "formalExpectedCount",
    "nextAllowedGate",
    "startedAt",
    "endedAt",
    "resultFingerprint"
  ],
  "properties": {
    "messageVersion": {
      "const": "resource-gateway.capability-studio.gate-a.admission-verification-result.v1"
    },
    "gateId": {
      "const": "GATE-A"
    },
    "gateRevision": {
      "const": 1
    },
    "resultId": {
      "type": "string",
      "pattern": "^A2-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "conclusion": {
      "enum": [
        "PASS",
        "OPEN",
        "FAIL",
        "UNAVAILABLE"
      ]
    },
    "conclusionReasonCode": {
      "enum": [
        "GATE_A_ADMITTED",
        "GATE_A_REQUIRED_MATERIAL_MISSING",
        "GATE_A_VERIFICATION_FAILED",
        "GATE_A_VERIFICATION_UNAVAILABLE"
      ]
    },
    "gateResultRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "admissionTrustPinRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "challengeTrustPinRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "admissionEvidenceRootRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/treeRef"
    },
    "gateVerifierCodeSource": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSource"
    },
    "gateVerifierBuildIdentityRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousGateResultRef",
        "candidateRef",
        "instructionRef",
        "resolvable",
        "candidateBound"
      ],
      "properties": {
        "previousGateResultRef": {
          "type": "null"
        },
        "candidateRef": {
          "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
        },
        "instructionRef": {
          "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
        },
        "resolvable": {
          "type": "boolean"
        },
        "candidateBound": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/requirementTypedEvidence"
        },
        {
          "$ref": "#/$defs/requirementIndependentVerifier"
        },
        {
          "$ref": "#/$defs/requirementLegacyTerminal"
        },
        {
          "$ref": "#/$defs/requirementManifestStability"
        },
        {
          "$ref": "#/$defs/requirementHonestIncomplete"
        }
      ],
      "items": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/artifactCandidate"
        },
        {
          "$ref": "#/$defs/artifactIndependentVerifier"
        },
        {
          "$ref": "#/$defs/artifactGateVerifier"
        },
        {
          "$ref": "#/$defs/artifactTestReport"
        }
      ],
      "items": false
    },
    "tests": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {
          "$ref": "#/$defs/testPlaceholder"
        },
        {
          "$ref": "#/$defs/testWrongKind"
        },
        {
          "$ref": "#/$defs/testWrongRevision"
        },
        {
          "$ref": "#/$defs/testVerifierDigest"
        },
        {
          "$ref": "#/$defs/testRegistry"
        },
        {
          "$ref": "#/$defs/testTckMismatch"
        },
        {
          "$ref": "#/$defs/testLegacyComplete"
        },
        {
          "$ref": "#/$defs/testMissingStore"
        },
        {
          "$ref": "#/$defs/testMissingOwner"
        },
        {
          "$ref": "#/$defs/testMissingTarget"
        },
        {
          "$ref": "#/$defs/testManifestDrift"
        },
        {
          "$ref": "#/$defs/testHonestIncomplete"
        }
      ],
      "items": false
    },
    "mandatoryGuards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/guardProviderCollision"
        },
        {
          "$ref": "#/$defs/guardReviewCount"
        }
      ],
      "items": false
    },
    "trustedReview": {
      "$ref": "#/$defs/trustedReviewSlot"
    },
    "formalPassCount": {
      "const": 0
    },
    "formalExpectedCount": {
      "const": 27
    },
    "nextAllowedGate": {
      "oneOf": [
        {
          "const": "GATE-B"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/timestamp"
    },
    "endedAt": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/timestamp"
    },
    "resultFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"
    },
    "semanticGuardResults": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "prefixItems": [
