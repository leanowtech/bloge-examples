  },
  "allOf": [
    {
      "if": {
        "properties": {"conclusion": {"const": "PASS"}},
        "required": ["conclusion"]
      },
      "then": {
        "properties": {
          "conclusionReasonCode": {"const": "GATE_A_ADMITTED"},
          "nextAllowedGate": {"const": "GATE-B"},
          "rollback": {
            "properties": {
              "resolvable": {"const": true},
              "candidateBound": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"conclusion": {"const": "OPEN"}},
        "required": ["conclusion"]
      },
      "then": {
        "properties": {
          "conclusionReasonCode": {"const": "GATE_A_REQUIRED_MATERIAL_MISSING"},
          "nextAllowedGate": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"conclusion": {"const": "FAIL"}},
        "required": ["conclusion"]
      },
      "then": {
        "properties": {
          "conclusionReasonCode": {"const": "GATE_A_VERIFICATION_FAILED"},
          "nextAllowedGate": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"conclusion": {"const": "UNAVAILABLE"}},
        "required": ["conclusion"]
      },
      "then": {
        "properties": {
          "conclusionReasonCode": {"const": "GATE_A_VERIFICATION_UNAVAILABLE"},
          "nextAllowedGate": {"type": "null"}
        }
      }
    }
  ],
