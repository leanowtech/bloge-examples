                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A0_TERMINAL_DERIVATION"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-01-TYPED-EVIDENCE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A0_REFERENCE_CLOSURE"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-01-TYPED-EVIDENCE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A0_RESULT_FINGERPRINT"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-01-TYPED-EVIDENCE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A1_SLOT_COUNT_PROJECTION"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A1_SLOT_OUTCOME_BINDING"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A1_PROCESS_MATERIAL_CLOSURE"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "A1_RESULT_FINGERPRINT"
                },
                "admissionTarget": {
                  "const": "requirement:GATE-A-P0-02-INDEPENDENT-VERIFIER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticGuardResult"
            },
            {
              "properties": {
                "guardId": {
                  "const": "HARNESS_PROOF_COMPLETENESS"
