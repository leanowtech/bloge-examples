{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-build-resource-manifest-v1.schema.json",
  "title": "Capability Studio Gate A Build Resource Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestFingerprint", "entries"],
  "properties": {"schemaVersion": {"const": "capability-studio.gate-a-build-resource-manifest.v1"}, "manifestFingerprint": {"$ref": "#/$defs/aggregateFingerprint"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}},
  "$defs": {
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
    "fingerprint": {"type": "object", "additionalProperties": false, "required": ["kind", "algorithm", "value"], "properties": {"kind": {"enum": ["RAW_BYTES", "CANONICAL_DOCUMENT", "TREE_COMMITMENT", "AGGREGATE_COMMITMENT"]}, "algorithm": {"const": "SHA-256"}, "value": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "rawFingerprint": {"allOf": [{"$ref": "#/$defs/fingerprint"}, {"properties": {"kind": {"const": "RAW_BYTES"}}}]},
    "aggregateFingerprint": {"allOf": [{"$ref": "#/$defs/fingerprint"}, {"properties": {"kind": {"const": "AGGREGATE_COMMITMENT"}}}]},
    "entry": {"type": "object", "additionalProperties": false, "required": ["resourceRole", "entryPath", "rawFingerprint"], "properties": {"resourceRole": {"enum": ["PROFILE", "REGISTRY", "TCK_DEFINITION", "TCK_PROVIDER", "SPI_ARTIFACT", "SPI_CLASS", "SCHEMA", "BUILD_IDENTITY", "MANIFEST"]}, "entryPath": {"$ref": "#/$defs/path"}, "rawFingerprint": {"$ref": "#/$defs/rawFingerprint"}}}
  },
  "$comment": "Entries are sorted by resourceRole, entryPath and unique. Fingerprint domain: RG-CS-GATE-A-BUILD-RESOURCE-MANIFEST-v1. Provider resources are A1-only and forbidden in Harness/A2."
}
