{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-candidate-challenge-request-v1.schema.json",
  "title": "Capability Studio Gate A candidate challenge request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion", "challengeId", "operation", "candidateRawFingerprint",
    "replayProfileRawFingerprint", "tckVectorId", "fixtureRootRef",
    "inputExactRefs", "semanticVerificationTime", "timeoutMillis",
    "stdoutLimitBytes", "stderrLimitBytes", "requestFingerprint"
  ],
  "properties": {
    "messageVersion": {"const": "resource-gateway.capability-studio.gate-a.candidate-challenge-request.v1"},
    "challengeId": {"type": "string", "pattern": "^CHALLENGE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "operation": {"enum": ["TYPED_REPLAY_V1", "LEGACY_STAGE_ACCEPTANCE_V2"]},
    "candidateRawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
    "replayProfileRawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
    "tckVectorId": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/testId"},
    "fixtureRootRef": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/treeRef"},
    "inputExactRefs": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/inputExactRef"}
    },
    "semanticVerificationTime": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/timestamp"},
    "timeoutMillis": {"const": 30000},
    "stdoutLimitBytes": {"const": 8192},
    "stderrLimitBytes": {"const": 8192},
    "requestFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "TYPED_REPLAY_V1"}}, "required": ["operation"]},
      "then": {"properties": {"tckVectorId": {"enum": ["PLACEHOLDER_REJECTED", "WRONG_KIND_REJECTED", "WRONG_VERIFIER_REVISION_REJECTED", "MANIFEST_IDENTITY_DRIFT_REJECTED", "HONEST_INCOMPLETE_ACCEPTED"]}}}
    },
    {
      "if": {"properties": {"operation": {"const": "LEGACY_STAGE_ACCEPTANCE_V2"}}, "required": ["operation"]},
      "then": {"properties": {"tckVectorId": {"enum": ["LEGACY_ACCEPTED_COMPLETE_AUTHORITY", "LEGACY_ACCEPTED_MISSING_STORE_REJECTED", "LEGACY_ACCEPTED_MISSING_OWNER_REJECTED", "LEGACY_ACCEPTED_MISSING_TARGET_REJECTED"]}}}
    }
  ],
  "$defs": {
    "inputExactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputRole", "exactRef"],
      "properties": {
        "inputRole": {"enum": ["FORMAL_EVIDENCE_MANIFEST", "FORMAL_EVIDENCE_BUNDLE", "STAGE_ACCEPTANCE_RESULT", "AUTHORITY_STORE", "AUTHORITY_OWNER", "AUTHORITY_TARGET"]},
        "exactRef": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"}
      }
    }
  }
}
