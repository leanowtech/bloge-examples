{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-candidate-challenge-response-v1.schema.json",
  "title": "Capability Studio Gate A candidate challenge response v1",
  "description": "Candidate semantic response. Exit, stdout, stderr, time, timeout, cancellation, and process state belong only to the caller-owned transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion", "challengeId", "operation", "tckVectorId",
    "observedTerminal", "closedReasonCode", "candidateCodeSourceRawFingerprint",
    "authorityProviderFqcn", "authorityProviderCodeSourceRawFingerprint",
    "authorityProviderClassRawFingerprint", "operationResultKind",
    "operationResult", "operationResultFingerprint", "responseFingerprint"
  ],
  "properties": {
    "messageVersion": {"const": "resource-gateway.capability-studio.gate-a.candidate-challenge-response.v1"},
    "challengeId": {"type": "string", "pattern": "^CHALLENGE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "operation": {"enum": ["TYPED_REPLAY_V1", "LEGACY_STAGE_ACCEPTANCE_V2"]},
    "tckVectorId": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/testId"},
    "observedTerminal": {"enum": ["STRUCTURE_VERIFIED", "INCOMPLETE", "INVALID", "UNAVAILABLE", "ACCEPTED", "NOT_ACCEPTED"]},
    "closedReasonCode": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/reasonCode"},
    "candidateCodeSourceRawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
    "authorityProviderFqcn": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"}]},
    "authorityProviderCodeSourceRawFingerprint": {"oneOf": [{"type": "null"}, {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"}]},
    "authorityProviderClassRawFingerprint": {"oneOf": [{"type": "null"}, {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"}]},
    "operationResultKind": {"enum": ["TYPED_REPLAY_RESULT", "LEGACY_ACCEPTANCE_RESULT"]},
    "operationResult": {
      "oneOf": [
        {"$ref": "./capability-studio-gate-a-candidate-replay-result-v1.schema.json"},
        {"$ref": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-candidate-challenge-response-v1.schema.json#/$defs/legacyAcceptanceResult"}
      ]
    },
    "operationResultFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"},
    "responseFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "TYPED_REPLAY_V1"}}, "required": ["operation"]},
      "then": {
        "properties": {
          "tckVectorId": {"enum": ["PLACEHOLDER_REJECTED", "WRONG_KIND_REJECTED", "WRONG_VERIFIER_REVISION_REJECTED", "MANIFEST_IDENTITY_DRIFT_REJECTED", "HONEST_INCOMPLETE_ACCEPTED"]},
          "observedTerminal": {"enum": ["STRUCTURE_VERIFIED", "INCOMPLETE", "INVALID", "UNAVAILABLE"]},
          "authorityProviderFqcn": {"type": "null"},
          "authorityProviderCodeSourceRawFingerprint": {"type": "null"},
          "authorityProviderClassRawFingerprint": {"type": "null"},
          "operationResultKind": {"const": "TYPED_REPLAY_RESULT"},
          "operationResult": {"$ref": "./capability-studio-gate-a-candidate-replay-result-v1.schema.json"}
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "LEGACY_STAGE_ACCEPTANCE_V2"}}, "required": ["operation"]},
      "then": {
        "properties": {
          "tckVectorId": {"enum": ["LEGACY_ACCEPTED_COMPLETE_AUTHORITY", "LEGACY_ACCEPTED_MISSING_STORE_REJECTED", "LEGACY_ACCEPTED_MISSING_OWNER_REJECTED", "LEGACY_ACCEPTED_MISSING_TARGET_REJECTED"]},
          "observedTerminal": {"enum": ["ACCEPTED", "NOT_ACCEPTED", "INVALID"]},
          "authorityProviderFqcn": {"type": "string"},
          "authorityProviderCodeSourceRawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
          "authorityProviderClassRawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
          "operationResultKind": {"const": "LEGACY_ACCEPTANCE_RESULT"},
          "operationResult": {"$ref": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-candidate-challenge-response-v1.schema.json#/$defs/legacyAcceptanceResult"}
        }
      }
    },
    {"if": {"properties": {"observedTerminal": {"const": "STRUCTURE_VERIFIED"}}, "required": ["observedTerminal"]}, "then": {"properties": {"closedReasonCode": {"const": "A0_STRUCTURE_VERIFIED"}, "operationResult": {"properties": {"terminal": {"const": "STRUCTURE_VERIFIED"}, "reasonCode": {"const": "A0_STRUCTURE_VERIFIED"}}}}}},
    {"if": {"properties": {"observedTerminal": {"const": "INCOMPLETE"}}, "required": ["observedTerminal"]}, "then": {"properties": {"closedReasonCode": {"const": "A0_INCOMPLETE"}, "operationResult": {"properties": {"terminal": {"const": "INCOMPLETE"}, "reasonCode": {"const": "A0_INCOMPLETE"}}}}}},
    {
      "if": {
        "properties": {
          "operation": {"const": "TYPED_REPLAY_V1"},
          "observedTerminal": {"const": "INVALID"}
        },
        "required": ["operation", "observedTerminal"]
      },
      "then": {
        "properties": {
          "closedReasonCode": {"const": "A0_INVALID"},
          "operationResult": {
            "properties": {
              "terminal": {"const": "INVALID"},
              "reasonCode": {"const": "A0_INVALID"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "LEGACY_STAGE_ACCEPTANCE_V2"},
          "observedTerminal": {"const": "INVALID"}
        },
        "required": ["operation", "observedTerminal"]
      },
      "then": {
        "properties": {
          "closedReasonCode": {"const": "OUTPUT_INVALID"},
          "operationResult": {
            "properties": {
              "terminal": {"const": "INVALID"},
              "reasonCode": {"const": "OUTPUT_INVALID"}
            }
          }
        }
      }
    },
    {"if": {"properties": {"observedTerminal": {"const": "UNAVAILABLE"}}, "required": ["observedTerminal"]}, "then": {"properties": {"closedReasonCode": {"const": "A0_UNAVAILABLE"}, "operationResult": {"properties": {"terminal": {"const": "UNAVAILABLE"}, "reasonCode": {"const": "A0_UNAVAILABLE"}}}}}},
    {"if": {"properties": {"observedTerminal": {"const": "ACCEPTED"}}, "required": ["observedTerminal"]}, "then": {"properties": {"closedReasonCode": {"const": "LEGACY_AUTHORITY_COMPLETE"}, "operationResult": {"properties": {"terminal": {"const": "ACCEPTED"}, "reasonCode": {"const": "LEGACY_AUTHORITY_COMPLETE"}, "authorityBindingComplete": {"const": true}}}}}},
    {"if": {"properties": {"observedTerminal": {"const": "NOT_ACCEPTED"}}, "required": ["observedTerminal"]}, "then": {"properties": {"closedReasonCode": {"enum": ["MISSING_STORE", "MISSING_OWNER", "MISSING_TARGET"]}, "operationResult": {"properties": {"terminal": {"const": "NOT_ACCEPTED"}, "authorityBindingComplete": {"const": false}}}}}},
    {"if": {"properties": {"closedReasonCode": {"const": "MISSING_STORE"}}, "required": ["closedReasonCode"]}, "then": {"properties": {"operationResult": {"properties": {"reasonCode": {"const": "MISSING_STORE"}}}}}},
    {"if": {"properties": {"closedReasonCode": {"const": "MISSING_OWNER"}}, "required": ["closedReasonCode"]}, "then": {"properties": {"operationResult": {"properties": {"reasonCode": {"const": "MISSING_OWNER"}}}}}},
    {"if": {"properties": {"closedReasonCode": {"const": "MISSING_TARGET"}}, "required": ["closedReasonCode"]}, "then": {"properties": {"operationResult": {"properties": {"reasonCode": {"const": "MISSING_TARGET"}}}}}}
  ],
  "$defs": {
    "legacyAcceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageVersion", "terminal", "reasonCode", "authorityBindingComplete"],
      "properties": {
        "messageVersion": {"const": "resource-gateway.capability-studio.gate-a.legacy-acceptance-result.v1"},
        "terminal": {"enum": ["ACCEPTED", "NOT_ACCEPTED", "INVALID"]},
        "reasonCode": {"enum": ["LEGACY_AUTHORITY_COMPLETE", "MISSING_STORE", "MISSING_OWNER", "MISSING_TARGET", "OUTPUT_INVALID"]},
        "authorityBindingComplete": {"type": "boolean"}
      }
    }
  }
}
