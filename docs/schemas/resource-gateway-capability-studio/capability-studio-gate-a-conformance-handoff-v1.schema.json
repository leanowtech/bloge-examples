{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-conformance-handoff-v1.schema.json",
  "title": "Capability Studio Gate A conformance handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageVersion",
    "handoffFingerprint",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "capability-studio.gate-a-conformance-handoff.v1"
    },
    "messageVersion": {
      "const": "resource-gateway.capability-studio.gate-a.conformance-handoff.v1"
    },
    "handoffFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "ACCEPTED"
      ]
    }
  }
}