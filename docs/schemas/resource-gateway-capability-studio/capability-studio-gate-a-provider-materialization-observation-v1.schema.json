{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-provider-materialization-observation-v1.schema.json",
  "title": "Capability Studio Gate A provider materialization observation v1",
  "description": "Parent-owned proof that one pinned Provider JAR was copied with CREATE_NEW into isolated scratch, inspected as a closed ZIP, then deleted without residue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion",
    "runId",
    "materializationId",
    "sourceJarRef",
    "destinationPath",
    "createMode",
    "sourcePreReadRawFingerprint",
    "materializedRawFingerprint",
    "sourcePostReadRawFingerprint",
    "providerIdentityRawFingerprint",
    "jarEntryPaths",
    "serviceDescriptor",
    "implementationClass",
    "destinationCreateReceipt",
    "destinationOpenReadReceipt",
    "destinationDeleteReceipt",
    "scratchBeforeCount",
    "scratchAfterCount",
    "deletionStatus",
    "residualPaths",
    "observationFingerprint"
  ],
  "properties": {
    "messageVersion": {
      "const": "resource-gateway.capability-studio.gate-a.provider-materialization-observation.v1"
    },
    "runId": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/runId"
    },
    "materializationId": {
      "type": "string",
      "pattern": "^PROVIDER-MATERIALIZATION-[A-Z0-9][A-Z0-9-]{2,95}$"
    },
    "sourceJarRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "destinationPath": {
      "const": "/work/provider.jar"
    },
    "createMode": {
      "const": "CREATE_NEW"
    },
    "sourcePreReadRawFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
    },
    "materializedRawFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
    },
    "sourcePostReadRawFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
    },
    "providerIdentityRawFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
    },
    "jarEntryPaths": {
      "type": "array",
      "prefixItems": [
        {"const": "META-INF/MANIFEST.MF"},
        {"const": "META-INF/services/com.leanowtech.bloge.gateway.testkit.CapabilityStudioStageAcceptanceAuthorityProvider"},
        {"const": "com/leanowtech/bloge/gatetckprovider/GateATckProvider.class"}
      ],
      "items": false
    },
    "serviceDescriptor": {
      "$ref": "#/$defs/jarEntry"
    },
    "implementationClass": {
      "$ref": "#/$defs/jarEntry"
    },
    "destinationCreateReceipt": {
      "$ref": "#/$defs/destinationCreateReceipt"
    },
    "destinationOpenReadReceipt": {
      "$ref": "#/$defs/destinationOpenReadReceipt"
    },
    "destinationDeleteReceipt": {
      "$ref": "#/$defs/destinationDeleteReceipt"
    },
    "scratchBeforeCount": {
      "const": 0
    },
    "scratchAfterCount": {
      "const": 0
    },
    "deletionStatus": {
      "const": "VERIFIED"
    },
    "residualPaths": {
      "type": "array",
      "maxItems": 0
    },
    "observationFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"
    }
  },
  "$defs": {
    "jarEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawFingerprint"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._$/-]+$"
        },
        "rawFingerprint": {
          "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
        }
      }
    },
    "destinationCreateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "createMode", "createNew", "preExisting", "outcome", "identity"],
      "properties": {
        "path": {"const": "/work/provider.jar"},
        "createMode": {"const": "CREATE_NEW"},
        "createNew": {"const": true},
        "preExisting": {"const": false},
        "outcome": {"const": "CREATED"},
        "identity": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSourceObservationSnapshot"}
      }
    },
    "destinationOpenReadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "openMode", "readMode", "byteLength", "rawFingerprint", "preRead", "postRead"],
      "properties": {
        "path": {"const": "/work/provider.jar"},
        "openMode": {"const": "READ_NOFOLLOW"},
        "readMode": {"const": "FSTAT_READ_FSTAT"},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "rawFingerprint": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"},
        "preRead": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSourceObservationSnapshot"},
        "postRead": {"$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSourceObservationSnapshot"}
      }
    },
    "destinationDeleteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "deleteMode", "outcome", "missingAfterDelete", "residualPaths"],
      "properties": {
        "path": {"const": "/work/provider.jar"},
        "deleteMode": {"const": "UNLINK"},
        "outcome": {"const": "DELETED"},
        "missingAfterDelete": {"const": true},
        "residualPaths": {"type": "array", "maxItems": 0}
      }
    }
  }
}
