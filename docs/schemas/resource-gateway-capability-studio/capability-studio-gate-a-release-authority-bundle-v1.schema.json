{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-release-authority-bundle-v1.schema.json",
  "title": "Capability Studio Gate A sealed Release Authority Bundle v1",
  "description": "A caller-compiled, closed and externally pinned snapshot consumed by Gate A verifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion",
    "bundleId",
    "purpose",
    "releaseAdmissionPolicy",
    "authorityRawFingerprint",
    "authorityRevision",
    "projectionSetFingerprint",
    "schemaSetFingerprint",
    "dependencyAuthorityRawFingerprint",
    "toolchainPolicyFingerprint",
    "targetSliceId",
    "artifactClosureRoles",
    "implementationRoles",
    "files",
    "roleViews",
    "oracleCompartment",
    "closedTreeFingerprint",
    "limits",
    "seal",
    "bundleRootFingerprint"
  ],
  "properties": {
    "messageVersion": {
      "const": "capability-studio.gate-a.release-authority-bundle.v1"
    },
    "bundleId": {
      "const": "GATE_A_RELEASE_AUTHORITY_BUNDLE"
    },
    "purpose": {
      "const": "FROZEN_CALLER_INPUT_NOT_RELEASE_EVIDENCE"
    },
    "releaseAdmissionPolicy": {
      "const": "EXTERNAL_PINS_HERMETIC_EXECUTION_AND_SLICE_RECEIPT_REQUIRED"
    },
    "authorityRawFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "authorityRevision": {
      "type": "integer",
      "minimum": 1
    },
    "projectionSetFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "schemaSetFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "dependencyAuthorityRawFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "toolchainPolicyFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "targetSliceId": {
      "type": "string",
      "pattern": "^A1\\.[1-7]$"
    },
    "artifactClosureRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "implementationRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "roleViews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/roleView"
      }
    },
    "oracleCompartment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "rootPath",
        "fileRefs"
      ],
      "properties": {
        "visibility": {
          "const": "PARENT_ONLY"
        },
        "rootPath": {
          "$ref": "#/$defs/relativePath"
        },
        "fileRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "closedTreeFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFiles",
        "maxFileBytes",
        "maxTotalBytes",
        "maxJsonBytes"
      ],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maxJsonBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifestPath",
        "selfNullField"
      ],
      "properties": {
        "kind": {
          "const": "ATOMIC_FINAL_SEAL"
        },
        "manifestPath": {
          "const": "release-authority-bundle-v1.json"
        },
        "selfNullField": {
          "const": "bundleRootFingerprint"
        }
      }
    },
    "bundleRootFingerprint": {
      "$ref": "#/$defs/selfNullFingerprint"
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "kind",
        "byteLength",
        "rawFingerprint"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "kind": {
          "enum": [
            "AUTHORITY",
            "PROJECTION",
            "COMPILATION_MANIFEST",
            "SCHEMA",
            "CANONICAL_PROFILE",
            "DEPENDENCY_AUTHORITY",
            "ROLE_ARTIFACT",
            "ROLE_INPUT",
            "PACKAGED_PROFILE",
            "ROLE_VIEW_MANIFEST",
            "ORACLE",
            "FIXTURE_BINDING"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "rawFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "role": {
      "enum": [
        "IMPLEMENTATION_CANDIDATE",
        "TCK_PROVIDER",
        "INDEPENDENT_VERIFIER",
        "CONFORMANCE_HARNESS"
      ]
    },
    "roleView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageVersion",
        "role",
        "manifestPath",
        "visibleFileRefs",
        "inputTreeFingerprint",
        "forbiddenCapabilities",
        "roleViewFingerprint",
        "requiredRuntimeArtifactRoles",
        "packagedSchemaIds",
        "visibleSchemaIds",
        "schemaSetFingerprint"
      ],
      "properties": {
        "messageVersion": {
          "const": "capability-studio.gate-a.release-authority-bundle.role-view.v1"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "manifestPath": {
          "$ref": "#/$defs/relativePath"
        },
        "visibleFileRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "inputTreeFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "forbiddenCapabilities": {
          "const": [
            "ORACLE",
            "AUTHORITY_WORKSPACE",
            "REPOSITORY_ROOT",
            "OTHER_ROLE_INPUTS"
          ]
        },
        "roleViewFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "requiredRuntimeArtifactRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "packagedSchemaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "visibleSchemaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "schemaSetFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "selfNullFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "algorithm",
        "value",
        "selfNullField"
      ],
      "properties": {
        "kind": {
          "const": "SELF_NULL_BUNDLE_ROOT"
        },
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "$ref": "#/$defs/fingerprint"
        },
        "selfNullField": {
          "const": "bundleRootFingerprint"
        }
      }
    }
  }
}
