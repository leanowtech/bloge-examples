{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-replay-verification-result-v1.schema.json",
  "title": "Capability Studio Gate A replay verification result v1",
  "$comment": "This producer Result is not a Proof. Schema freezes slots, field types, and terminal/reason discriminant. Counts, per-slot outcome consistency, terminal derivation, fingerprints, process closure, and time ordering are untrusted projections until the caller closes this Result and its parent-owned process material in GateAReplayProofEnvelope v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion",
    "resultId",
    "gateRevision",
    "challengeTrustPinRawFingerprint",
    "candidateCodeSource",
    "verifierCodeSource",
    "replayProfileRef",
    "tckDefinitionRef",
    "registryRef",
    "providerMaterializationRef",
    "testRuns",
    "testCount",
    "passedCount",
    "failedCount",
    "skippedCount",
    "scratchBeforeCount",
    "scratchAfterCount",
    "terminal",
    "reasonCode",
    "startedAt",
    "endedAt",
    "resultFingerprint"
  ],
  "properties": {
    "messageVersion": {
      "const": "resource-gateway.capability-studio.gate-a.replay-verification-result.v1"
    },
    "resultId": {
      "type": "string",
      "pattern": "^A1-REPLAY-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "gateRevision": {
      "const": 1
    },
    "challengeTrustPinRawFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawFingerprint"
    },
    "candidateCodeSource": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSource"
    },
    "verifierCodeSource": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/codeSource"
    },
    "replayProfileRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "tckDefinitionRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "registryRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "providerMaterializationRef": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/rawRef"
    },
    "testRuns": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "$ref": "#/$defs/placeholder"
        },
        {
          "$ref": "#/$defs/wrongKind"
        },
        {
          "$ref": "#/$defs/wrongRevision"
        },
        {
          "$ref": "#/$defs/legacyComplete"
        },
        {
          "$ref": "#/$defs/missingStore"
        },
        {
          "$ref": "#/$defs/missingOwner"
        },
        {
          "$ref": "#/$defs/missingTarget"
        },
        {
          "$ref": "#/$defs/manifestDrift"
        },
        {
          "$ref": "#/$defs/honestIncomplete"
        }
      ],
      "items": false
    },
    "testCount": {
      "const": 9
    },
    "passedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "failedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "skippedCount": {
      "const": 0
    },
    "scratchBeforeCount": {
      "const": 0
    },
    "scratchAfterCount": {
      "const": 0
    },
    "terminal": {
      "enum": [
        "VERIFIED",
        "INVALID",
        "UNAVAILABLE"
      ]
    },
    "reasonCode": {
      "enum": [
        "A1_REPLAY_VERIFIED",
        "A1_REPLAY_INVALID",
        "A1_REPLAY_UNAVAILABLE"
      ]
    },
    "startedAt": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/timestamp"
    },
    "endedAt": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/timestamp"
    },
    "resultFingerprint": {
      "$ref": "./capability-studio-gate-a-common-v1.schema.json#/$defs/documentFingerprint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "A1_REPLAY_VERIFIED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "INVALID"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "A1_REPLAY_INVALID"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "UNAVAILABLE"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "A1_REPLAY_UNAVAILABLE"
          }
        }
      }
    }
  ],
