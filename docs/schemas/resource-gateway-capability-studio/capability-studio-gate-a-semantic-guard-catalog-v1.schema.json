{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-semantic-guard-catalog-v1.schema.json",
  "title": "Capability Studio Gate A semantic guard catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageVersion",
    "evaluationMode",
    "evaluationOrder",
    "terminalPriority",
    "admissionPriority",
    "targetAggregationPriority",
    "guards"
  ],
  "properties": {
    "messageVersion": {
      "const": "resource-gateway.capability-studio.gate-a.semantic-guard-catalog.v1"
    },
    "evaluationMode": {
      "const": "ALL_GUARDS_NO_SHORT_CIRCUIT"
    },
    "evaluationOrder": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "const": "STRUCTURE"
        },
        {
          "const": "IDENTITY"
        },
        {
          "const": "REFERENCE_CLOSURE"
        },
        {
          "const": "PROJECTION"
        },
        {
          "const": "OUTCOME"
        },
        {
          "const": "FINGERPRINT"
        },
        {
          "const": "TRUST"
        },
        {
          "const": "ADMISSION"
        }
      ],
      "items": false
    },
    "terminalPriority": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "UNAVAILABLE"
        },
        {
          "const": "INVALID"
        },
        {
          "const": "INCOMPLETE"
        },
        {
          "const": "VERIFIED"
        }
      ],
      "items": false
    },
    "admissionPriority": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "UNAVAILABLE"
        },
        {
          "const": "FAIL"
        },
        {
          "const": "OPEN"
        },
        {
          "const": "PASS"
        }
      ],
      "items": false
    },
    "targetAggregationPriority": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "UNAVAILABLE"
        },
        {
          "const": "FAIL"
        },
        {
          "const": "MISSING"
        },
        {
          "const": "PASS"
        }
      ],
      "items": false
    },
    "guards": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "prefixItems": [
        {
          "$ref": "#/$defs/a0SlotCount"
        },
        {
          "$ref": "#/$defs/a0Terminal"
        },
        {
          "$ref": "#/$defs/a0Reference"
        },
        {
          "$ref": "#/$defs/a0Fingerprint"
        },
        {
          "$ref": "#/$defs/a1SlotCount"
        },
        {
          "$ref": "#/$defs/a1Outcome"
        },
        {
          "$ref": "#/$defs/a1Material"
        },
        {
          "$ref": "#/$defs/a1Fingerprint"
        },
        {
          "$ref": "#/$defs/harnessProof"
        },
        {
          "$ref": "#/$defs/providerCollision"
        },
        {
          "$ref": "#/$defs/pinLifecycle"
        },
        {
          "$ref": "#/$defs/evidenceRoot"
        },
        {
          "$ref": "#/$defs/codeSource"
        },
        {
          "$ref": "#/$defs/reviewSignature"
        },
        {
          "$ref": "#/$defs/reviewCount"
        },
        {
          "$ref": "#/$defs/rollback"
        },
        {
          "$ref": "#/$defs/conclusion"
        },
        {
          "$ref": "#/$defs/a2Fingerprint"
        }
      ],
      "items": false
    }
