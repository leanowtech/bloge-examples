  "$defs": {
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardId",
        "owner",
        "phase",
        "inputKind",
        "rule",
        "mismatch",
        "unavailable",
        "sourceFactIds",
        "admissionTarget"
      ],
      "properties": {
        "guardId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{2,95}$"
        },
        "owner": {
          "enum": [
            "A1",
            "HARNESS",
            "CALLER",
            "A2"
          ]
        },
        "phase": {
          "enum": [
            "STRUCTURE",
            "IDENTITY",
            "REFERENCE_CLOSURE",
            "PROJECTION",
            "OUTCOME",
            "FINGERPRINT",
            "TRUST",
            "ADMISSION"
          ]
        },
        "inputKind": {
          "enum": [
            "GateACandidateReplayResultV1",
            "GateAReplayVerificationResultV1",
            "GateAIndependentVerificationResultV1",
            "GateAAdmissionVerificationResultV1",
            "ReviewerAuthorityEnvelopeV1"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1024
        },
        "mismatch": {
          "enum": [
            "INVALID",
            "FAIL"
          ]
        },
        "unavailable": {
          "const": "UNAVAILABLE"
        },
        "sourceFactIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EXPECTED_TCK_SLOT",
              "EXPECTED_ARTIFACT_IDENTITY",
              "PROCESS_OBSERVATION",
              "A0_ADAPTER_FACT",
              "A0_FELT_GAP",
              "A1_SLOT_OUTCOME",
              "TEST_REPORT_CLOSURE",
              "REVIEW_FINDING",
              "OBSERVED_OUTPUT_SEAL"
            ]
          }
        },
        "admissionTarget": {
          "type": "string",
          "pattern": "^(requirement|artifact|guard|review):[A-Z0-9][A-Z0-9_-]{2,95}$"
        }
      }
    },
    "fixed": {
      "allOf": [
        {
          "$ref": "#/$defs/guard"
        }
      ]
    },
    "a0SlotCount": {
      "allOf": [
        {
          "$ref": "#/$defs/fixed"
        },
        {
          "properties": {
            "guardId": {
