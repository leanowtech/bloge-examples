{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-semantic-guard-vectors-v1.schema.json",
  "title": "Capability Studio Gate A semantic guard vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageVersion", "terminalDerivationCases", "cases"],
  "properties": {
    "messageVersion": {"const": "resource-gateway.capability-studio.gate-a.semantic-guard-vectors.v1"},
    "terminalDerivationCases": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/a0Derivation"}, {"$ref": "#/$defs/a0Derivation"},
        {"$ref": "#/$defs/a0Derivation"}, {"$ref": "#/$defs/a0Derivation"},
        {"$ref": "#/$defs/a1Derivation"}, {"$ref": "#/$defs/a1Derivation"},
        {"$ref": "#/$defs/a1Derivation"}
      ],
      "items": false
    },
    "cases": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/materialMutation"}, {"$ref": "#/$defs/materialMutation"},
        {"$ref": "#/$defs/materialMutation"}, {"$ref": "#/$defs/materialMutation"},
        {"$ref": "#/$defs/materialMutation"}
      ],
      "items": false
    }
  },
  "$defs": {
    "expectedTerminal": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal", "reasonCode"],
      "properties": {
        "terminal": {"enum": ["STRUCTURE_VERIFIED", "INCOMPLETE", "INVALID", "UNAVAILABLE", "VERIFIED"]},
        "reasonCode": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]{2,95}$"}
      }
    },
    "a0Derivation": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "stage", "adapterStatuses", "expected"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^A0-[A-Z0-9-]{3,95}$"},
        "stage": {"const": "A0"},
        "adapterStatuses": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"enum": ["VERIFIED", "INVALID", "UNAVAILABLE", "NOT_RUN"]}
        },
        "expected": {"$ref": "#/$defs/expectedTerminal"}
      }
    },
    "a1Derivation": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "stage", "slotFacts", "expected"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^A1-[A-Z0-9-]{3,95}$"},
        "stage": {"const": "A1"},
        "slotFacts": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "observedTerminal"],
            "properties": {
              "status": {"enum": ["PASS", "FAIL"]},
              "observedTerminal": {"enum": ["ACCEPTED", "NOT_ACCEPTED", "STRUCTURE_VERIFIED", "INCOMPLETE", "INVALID", "UNAVAILABLE"]}
            }
          }
        },
        "expected": {"$ref": "#/$defs/expectedTerminal"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "path", "value"],
      "properties": {
        "op": {"const": "replace"},
        "path": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"},
        "value": {}
      }
    },
    "semanticExpected": {
      "type": "object", "additionalProperties": false,
      "required": ["reasonCode", "failedGuardId", "exitCode"],
      "properties": {
        "terminal": {"enum": ["INVALID", "UNAVAILABLE"]},
        "conclusion": {"enum": ["OPEN", "FAIL", "UNAVAILABLE"]},
        "reasonCode": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]{2,95}$"},
        "failedGuardId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,95}$"},
        "exitCode": {"enum": [2, 3, 4]}
      },
      "oneOf": [{"required": ["terminal"]}, {"required": ["conclusion"]}]
    },
    "materialMutation": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "guardId", "baseFixture", "schema", "mutations", "schemaExpected", "semanticExpected"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{3,127}$"},
        "guardId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,95}$"},
        "baseFixture": {"type": "string", "pattern": "^\\.\\./process-results/[A-Za-z0-9._-]+\\.json$"},
        "schema": {"type": "string", "pattern": "^\\.\\./\\.\\./\\.\\./\\.\\./schemas/resource-gateway-capability-studio/[A-Za-z0-9._-]+\\.schema\\.json$"},
        "mutations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/mutation"}},
        "schemaExpected": {"const": "VALID"},
        "semanticExpected": {"$ref": "#/$defs/semanticExpected"}
      }
    }
  }
}
