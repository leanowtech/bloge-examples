{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-gate-a-source-manifest-v1.schema.json",
  "title": "Capability Studio Gate A Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestFingerprint", "entries"],
  "properties": {"schemaVersion": {"const": "capability-studio.gate-a-source-manifest.v1"}, "manifestFingerprint": {"$ref": "#/$defs/aggregateFingerprint"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}},
  "$defs": {
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
    "fingerprint": {"type": "object", "additionalProperties": false, "required": ["kind", "algorithm", "value"], "properties": {"kind": {"enum": ["RAW_BYTES", "CANONICAL_DOCUMENT", "TREE_COMMITMENT", "AGGREGATE_COMMITMENT"]}, "algorithm": {"const": "SHA-256"}, "value": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "rawFingerprint": {"allOf": [{"$ref": "#/$defs/fingerprint"}, {"properties": {"kind": {"const": "RAW_BYTES"}}}]},
    "aggregateFingerprint": {"allOf": [{"$ref": "#/$defs/fingerprint"}, {"properties": {"kind": {"const": "AGGREGATE_COMMITMENT"}}}]},
    "entry": {"type": "object", "additionalProperties": false, "required": ["relativeSourcePath", "entryPath", "rawFingerprint"], "properties": {"relativeSourcePath": {"$ref": "#/$defs/path"}, "entryPath": {"$ref": "#/$defs/path"}, "rawFingerprint": {"$ref": "#/$defs/rawFingerprint"}}}
  },
  "$comment": "Entries are sorted by relativeSourcePath and unique. Source snapshots are packaged below META-INF/gate-a/sources/. Fingerprint domain: RG-CS-GATE-A-SOURCE-MANIFEST-v1."
}
