{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-golden-path-acceptance-manifest-v1.schema.json",
  "title": "Resource Gateway Capability Studio Golden Path Acceptance Manifest v1",
  "description": "Payload-free acceptance evidence for GP-01 through GP-10 and the nine-case golden path. Cross-field acceptance semantics require a verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "revision",
    "status",
    "artifactFingerprint",
    "candidateBuildRef",
    "acceptanceBaselineRef",
    "goldenDemoPackRef",
    "scope",
    "contractAndDatasetFingerprints",
    "gpResults",
    "scenarioResults",
    "realExternalCallCount",
    "egressObservation",
    "browserAndViewportResults",
    "accessibilityResults",
    "protocolAndSecurityResults",
    "knownLimitations",
    "signOffs",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.capabilityStudioGoldenPathAcceptanceManifest.v1" },
    "manifestId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["NO_GO", "ACCEPTED", "REJECTED"] },
    "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
    "candidateBuildRef": { "$ref": "#/$defs/exactRef" },
    "acceptanceBaselineRef": { "$ref": "#/$defs/exactRef" },
    "goldenDemoPackRef": { "$ref": "#/$defs/exactRef" },
    "scope": { "$ref": "#/$defs/scope" },
    "contractAndDatasetFingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiContractFingerprints", "featureContractFingerprint", "toolContractFingerprint", "graphFingerprint", "datasetFingerprint", "bindingPlanFingerprint"],
      "properties": {
        "apiContractFingerprints": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/fingerprint" } },
        "featureContractFingerprint": { "$ref": "#/$defs/fingerprint" },
        "toolContractFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "datasetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "bindingPlanFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "gpResults": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/gpResult" }
    },
    "scenarioResults": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/scenarioResult" }
    },
    "realExternalCallCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "egressObservation": { "$ref": "#/$defs/observation" },
    "browserAndViewportResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/browserResult" }
    },
    "accessibilityResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/qualityResult" }
    },
    "protocolAndSecurityResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocolSecurityResult" }
    },
    "knownLimitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    },
    "signOffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signoff" }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "organizationId", "projectId", "environmentId", "region"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint", "authority", "scope"],
      "properties": {
        "kind": { "enum": ["BUILD", "ACCEPTANCE_BASELINE", "GOLDEN_DEMO_PACK", "CAPABILITY", "DATASET", "GRAPH_DRAFT", "BINDING_PLAN", "EVIDENCE"] },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "authority": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "uri", "fingerprint", "status"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["DOM", "SCREENSHOT", "RUN_TRACE", "PROTOCOL", "ACCESSIBILITY", "SECURITY", "NFR", "USABILITY", "NETWORK", "GOVERNANCE"] },
        "uri": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "status": { "enum": ["AVAILABLE", "NOT_RUN", "PENDING", "INVALIDATED"] }
      }
    },
    "resultStatus": { "enum": ["PASSED", "FAILED", "BLOCKED", "NOT_RUN", "SKIPPED"] },
    "gpResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpId", "status", "startedAt", "completedAt", "evidenceRefs", "failureCode", "notes"],
      "properties": {
        "gpId": { "enum": ["GP-01", "GP-02", "GP-03", "GP-04", "GP-05", "GP-06", "GP-07", "GP-08", "GP-09", "GP-10"] },
        "status": { "$ref": "#/$defs/resultStatus" },
        "startedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "completedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "failureCode": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "caseType", "branch", "status", "runId", "semanticFingerprint", "assertionStatus", "realCallCount", "evidenceRefs", "notes"],
      "properties": {
        "scenarioId": { "pattern": "^CASE-[0-9]{2}$" },
        "caseType": { "enum": ["GOLDEN", "NEGATIVE", "BOUNDARY", "REGRESSION", "FAULT", "TIMEOUT", "MUST_NOT_CALL"] },
        "branch": { "enum": ["CANONICAL_BASELINE", "TUTORIAL_BRANCH"] },
        "status": { "$ref": "#/$defs/resultStatus" },
        "runId": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "semanticFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
        "assertionStatus": { "$ref": "#/$defs/resultStatus" },
        "realCallCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt", "source", "count", "evidenceRefs", "notes"],
      "properties": {
        "status": { "enum": ["PASSED", "FAILED", "NOT_RUN", "BLOCKED"] },
        "observedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "source": { "type": "string", "minLength": 1 },
        "count": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "browserResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "viewport", "status", "domEvidenceRefs", "visualEvidenceRefs", "network404Count", "notes"],
      "properties": {
        "language": { "enum": ["zh-CN", "en-US"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "enum": [1440, 1024, 390] }, "height": { "enum": [900, 768, 844] } }
        },
        "status": { "$ref": "#/$defs/resultStatus" },
        "domEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "visualEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "network404Count": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "qualityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "evidenceRefs", "notes"],
      "properties": {
        "checkId": { "pattern": "^(A11Y|UX)-[0-9]{2}$" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "protocolSecurityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "evidenceRefs", "notes"],
      "properties": {
        "checkId": { "pattern": "^(SPIKE-[A-C]|SEC-[0-9]{2}|NFR-[0-9]{2})$" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitationId", "severity", "status", "description", "ownerRole", "blocksAcceptance"],
      "properties": {
        "limitationId": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["OPEN", "MITIGATED", "ACCEPTED_RISK", "CLOSED"] },
        "description": { "type": "string", "minLength": 1 },
        "ownerRole": { "$ref": "#/$defs/identifier" },
        "blocksAcceptance": { "type": "boolean" }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signoffId", "role", "status", "actorRef", "signedAt", "signatureRef", "comment"],
      "properties": {
        "signoffId": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["PRODUCT_OWNER", "BUSINESS_OWNER", "UX_OWNER", "ARCHITECTURE_OWNER", "SECURITY_OWNER", "QA_OWNER", "DELIVERY_OWNER"] },
        "status": { "enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED"] },
        "actorRef": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "signedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "signatureRef": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "comment": { "type": "string", "minLength": 1 }
      }
    }
  }
}
