{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-implementation-gate-result-v1.schema.json",
  "title": "Capability Studio Implementation Gate Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateId",
    "gateRevision",
    "designRef",
    "gateProfileRef",
    "previousGateResultRef",
    "requirementRefs",
    "artifactFingerprints",
    "testEvidenceRefs",
    "independentReview",
    "decision",
    "rollbackTarget",
    "nextAllowedGate",
    "closedReasonCodes",
    "decidedAt",
    "formalPassCount",
    "formalExpectedCount",
    "gateResultFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "capability-studio.implementation-gate-result.v1"
    },
    "gateId": {
      "const": "GATE-A"
    },
    "gateRevision": {
      "const": 1
    },
    "designRef": {
      "$ref": "#/$defs/exactRef"
    },
    "gateProfileRef": {
      "$ref": "#/$defs/exactRef"
    },
    "previousGateResultRef": {
      "type": "null"
    },
    "requirementRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GATE-A-(P0|P1)-[0-9]{2}-[A-Z][A-Z0-9-]{2,95}$"
      }
    },
    "artifactFingerprints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "testEvidenceRefs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/testEvidence"
      }
    },
    "independentReview": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/independentReview"}
      ]
    },
    "decision": {
      "enum": ["OPEN", "PASS", "FAIL"]
    },
    "rollbackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateRef", "instructionRef"],
      "properties": {
        "candidateRef": {
          "$ref": "#/$defs/exactRef"
        },
        "instructionRef": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "nextAllowedGate": {
      "oneOf": [
        {"type": "null"},
        {"const": "GATE-B"}
      ]
    },
    "closedReasonCodes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RG\\.ACCEPTANCE\\.GATE\\.[A-Z0-9_]{2,96}$"
      }
    },
    "decidedAt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      ]
    },
    "formalPassCount": {
      "const": 0
    },
    "formalExpectedCount": {
      "const": 27
    },
    "gateResultFingerprint": {
      "$ref": "#/$defs/fingerprint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "PASS"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "independentReview": {"$ref": "#/$defs/passingIndependentReview"},
          "closedReasonCodes": {"maxItems": 0},
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"enum": ["OPEN", "FAIL"]}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "nextAllowedGate": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "PASS"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "requirementRefs": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {"const": "GATE-A-P0-01-TYPED-EVIDENCE"},
              {"const": "GATE-A-P0-02-INDEPENDENT-VERIFIER"},
              {"const": "GATE-A-P0-03-LEGACY-TERMINAL"},
              {"const": "GATE-A-P1-01-MANIFEST-STABILITY"},
              {"const": "GATE-A-P1-02-HONEST-INCOMPLETE"}
            ],
            "items": false
          },
          "artifactFingerprints": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {"$ref": "#/$defs/implementationCandidateArtifact"},
              {"$ref": "#/$defs/independentVerifierArtifact"},
              {"$ref": "#/$defs/gateVerifierArtifact"},
              {"$ref": "#/$defs/testReportArtifact"}
            ],
            "items": false
          },
          "testEvidenceRefs": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "prefixItems": [
              {"$ref": "#/$defs/placeholderRejected"},
              {"$ref": "#/$defs/wrongKindRejected"},
              {"$ref": "#/$defs/wrongVerifierRevisionRejected"},
              {"$ref": "#/$defs/verifierDigestMutationRejected"},
              {"$ref": "#/$defs/registryMutationRejected"},
              {"$ref": "#/$defs/verifierTckMismatchRejected"},
              {"$ref": "#/$defs/legacyCompleteAuthorityAccepted"},
              {"$ref": "#/$defs/legacyMissingStoreRejected"},
              {"$ref": "#/$defs/legacyMissingOwnerRejected"},
              {"$ref": "#/$defs/legacyMissingTargetRejected"},
              {"$ref": "#/$defs/manifestIdentityDriftRejected"},
              {"$ref": "#/$defs/honestIncompleteAccepted"}
            ],
            "items": false
          },
          "nextAllowedGate": {"const": "GATE-B"}
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "rawFingerprint"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "rawFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifactRef", "publishedAt"],
      "properties": {
        "role": {
          "enum": [
            "IMPLEMENTATION_CANDIDATE",
            "INDEPENDENT_VERIFIER",
            "GATE_VERIFIER",
            "TEST_REPORT"
          ]
        },
        "artifactRef": {
          "$ref": "#/$defs/exactRef"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "status", "skipped", "evidenceRef"],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
        },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN"]
        },
        "skipped": {
          "type": "boolean"
        },
        "evidenceRef": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerAuthorityRef",
        "reviewerArtifactRef",
        "reviewEvidenceRef",
        "reviewedAt",
        "openP0",
        "openP1",
        "skippedCount",
        "reviewFingerprint"
      ],
      "properties": {
        "reviewerAuthorityRef": {"$ref": "#/$defs/exactRef"},
        "reviewerArtifactRef": {"$ref": "#/$defs/exactRef"},
        "reviewEvidenceRef": {"$ref": "#/$defs/exactRef"},
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "openP0": {"type": "integer", "minimum": 0, "maximum": 1000},
        "openP1": {"type": "integer", "minimum": 0, "maximum": 1000},
        "skippedCount": {"type": "integer", "minimum": 0, "maximum": 1000},
        "reviewFingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "passingIndependentReview": {
      "allOf": [
        {"$ref": "#/$defs/independentReview"},
        {
          "properties": {
            "openP0": {"const": 0},
            "openP1": {"const": 0},
            "skippedCount": {"const": 0}
          }
        }
      ]
    },
    "passingTestEvidence": {
      "allOf": [
        {"$ref": "#/$defs/testEvidence"},
        {
          "properties": {
            "status": {"const": "PASS"},
            "skipped": {"const": false}
          }
        }
      ]
    },
    "implementationCandidateArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"role": {"const": "IMPLEMENTATION_CANDIDATE"}}}
      ]
    },
    "independentVerifierArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"role": {"const": "INDEPENDENT_VERIFIER"}}}
      ]
    },
    "gateVerifierArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"role": {"const": "GATE_VERIFIER"}}}
      ]
    },
    "testReportArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"role": {"const": "TEST_REPORT"}}}
      ]
    },
    "placeholderRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "PLACEHOLDER_REJECTED"}}}]},
    "wrongKindRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "WRONG_KIND_REJECTED"}}}]},
    "wrongVerifierRevisionRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "WRONG_VERIFIER_REVISION_REJECTED"}}}]},
    "verifierDigestMutationRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "VERIFIER_DIGEST_MUTATION_REJECTED"}}}]},
    "registryMutationRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "REGISTRY_MUTATION_REJECTED"}}}]},
    "verifierTckMismatchRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "VERIFIER_TCK_MISMATCH_REJECTED"}}}]},
    "legacyCompleteAuthorityAccepted": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "LEGACY_ACCEPTED_COMPLETE_AUTHORITY"}}}]},
    "legacyMissingStoreRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "LEGACY_ACCEPTED_MISSING_STORE_REJECTED"}}}]},
    "legacyMissingOwnerRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "LEGACY_ACCEPTED_MISSING_OWNER_REJECTED"}}}]},
    "legacyMissingTargetRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "LEGACY_ACCEPTED_MISSING_TARGET_REJECTED"}}}]},
    "manifestIdentityDriftRejected": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "MANIFEST_IDENTITY_DRIFT_REJECTED"}}}]},
    "honestIncompleteAccepted": {"allOf": [{"$ref": "#/$defs/passingTestEvidence"}, {"properties": {"testId": {"const": "HONEST_INCOMPLETE_ACCEPTED"}}}]}
  }
}
