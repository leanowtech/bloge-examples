{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-mounted-authority-bundle-v1.schema.json",
  "title": "Resource Gateway Capability Studio Mounted Authority Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "revision", "generatedAt", "expiresAt", "bundleFingerprint", "artifacts", "issuerPolicies", "ownerPolicies"],
  "properties": {
    "schemaVersion": {"const": "resource-gateway.capability-studio.mounted-authority-bundle.v1"},
    "bundleId": {"$ref": "#/$defs/safeRef"},
    "revision": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "bundleFingerprint": {"$ref": "#/$defs/fingerprint"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/artifact"}},
    "issuerPolicies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/issuerPolicy"}},
    "ownerPolicies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/ownerPolicy"}}
  },
  "$defs": {
    "safeRef": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"},
    "fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[a-f0-9]{64}$"},
    "jsonFile": {"type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceKind", "referenceKey", "exactRef", "fingerprint", "artifactFile", "artifactFileFingerprint"],
      "properties": {
        "referenceKind": {"enum": ["EVIDENCE", "SIGNATURE"]},
        "referenceKey": {"$ref": "#/$defs/safeRef"},
        "exactRef": {"$ref": "#/$defs/safeRef"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "artifactFile": {"$ref": "#/$defs/jsonFile"},
        "artifactFileFingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "evidenceKind": {"enum": ["ACCEPTANCE_EVIDENCE", "ENVIRONMENT_ATTESTATION", "DEPLOYMENT_EGRESS_OBSERVATION", "OWNER_SIGNATURE"]},
    "issuerPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerRef", "scope", "allowedEvidenceKinds", "keySetFile", "pinnedKeySetFingerprint", "maxProofTtlSeconds"],
      "properties": {
        "issuerRef": {"$ref": "#/$defs/safeRef"},
        "scope": {"$ref": "#/$defs/safeRef"},
        "allowedEvidenceKinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceKind"}},
        "keySetFile": {"$ref": "#/$defs/jsonFile"},
        "pinnedKeySetFingerprint": {"$ref": "#/$defs/fingerprint"},
        "maxProofTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "ownerPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "allowedActorRefs", "signatureIssuerRef", "scope", "keySetFile", "pinnedKeySetFingerprint", "maxSignatureTtlSeconds"],
      "properties": {
        "role": {"$ref": "#/$defs/safeRef"},
        "allowedActorRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/safeRef"}},
        "signatureIssuerRef": {"$ref": "#/$defs/safeRef"},
        "scope": {"$ref": "#/$defs/safeRef"},
        "keySetFile": {"$ref": "#/$defs/jsonFile"},
        "pinnedKeySetFingerprint": {"$ref": "#/$defs/fingerprint"},
        "maxSignatureTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}
