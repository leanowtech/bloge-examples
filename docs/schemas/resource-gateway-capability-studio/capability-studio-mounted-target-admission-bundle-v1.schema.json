{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-capability-studio/capability-studio-mounted-target-admission-bundle-v1.schema.json",
  "title": "Resource Gateway Capability Studio Mounted Target Admission Bundle v1",
  "description": "Closed deployment-owned snapshot for Candidate and Environment target admission authority material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "revision",
    "lifecycleState",
    "predecessorBundleFingerprint",
    "revocationAuthority",
    "generatedAt",
    "expiresAt",
    "executionLeaseId",
    "trustedTargetIdentities",
    "targetBinding",
    "candidate",
    "environment",
    "bundleFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resource-gateway.capability-studio.mounted-target-admission-bundle.v1"
    },
    "bundleId": { "$ref": "#/$defs/safeRef" },
    "revision": { "type": "integer", "minimum": 1 },
    "lifecycleState": { "const": "ACTIVE" },
    "predecessorBundleFingerprint": {
      "oneOf": [
        { "$ref": "#/$defs/fingerprint" },
        { "type": "null" }
      ]
    },
    "revocationAuthority": { "$ref": "#/$defs/revocationAuthority" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "executionLeaseId": { "$ref": "#/$defs/safeRef" },
    "trustedTargetIdentities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeRef" }
    },
    "targetBinding": { "$ref": "#/$defs/targetBinding" },
    "candidate": { "$ref": "#/$defs/candidateAdmission" },
    "environment": { "$ref": "#/$defs/environmentAdmission" },
    "bundleFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "jsonFile": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revocationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRef",
        "revision",
        "snapshotFingerprint",
        "observedAt",
        "expiresAt"
      ],
      "properties": {
        "registryRef": { "$ref": "#/$defs/safeRef" },
        "revision": { "type": "integer", "minimum": 1 },
        "snapshotFingerprint": { "$ref": "#/$defs/fingerprint" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "fileFingerprint", "reference", "revision"],
      "properties": {
        "file": { "$ref": "#/$defs/jsonFile" },
        "fileFingerprint": { "$ref": "#/$defs/fingerprint" },
        "reference": { "$ref": "#/$defs/safeRef" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "fileFingerprint", "canonicalFingerprint"],
      "properties": {
        "file": { "$ref": "#/$defs/jsonFile" },
        "fileFingerprint": { "$ref": "#/$defs/fingerprint" },
        "canonicalFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "role",
        "issuer",
        "scope",
        "keySetFile",
        "keySetFileFingerprint",
        "pinnedKeySetFingerprint",
        "maximumProofTtlSeconds",
        "proofFile",
        "proofFileFingerprint"
      ],
      "properties": {
        "policyRef": { "$ref": "#/$defs/safeRef" },
        "role": { "const": "CANDIDATE_AUTHORITY" },
        "issuer": { "$ref": "#/$defs/safeRef" },
        "scope": { "$ref": "#/$defs/safeRef" },
        "keySetFile": { "$ref": "#/$defs/jsonFile" },
        "keySetFileFingerprint": { "$ref": "#/$defs/fingerprint" },
        "pinnedKeySetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "maximumProofTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "proofFile": { "$ref": "#/$defs/jsonFile" },
        "proofFileFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "environmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "role",
        "issuer",
        "scope",
        "keySetFile",
        "keySetFileFingerprint",
        "pinnedKeySetFingerprint",
        "maximumProofTtlSeconds",
        "proofFile",
        "proofFileFingerprint"
      ],
      "properties": {
        "policyRef": { "$ref": "#/$defs/safeRef" },
        "role": { "const": "ENVIRONMENT_AUTHORITY" },
        "issuer": { "$ref": "#/$defs/safeRef" },
        "scope": { "$ref": "#/$defs/safeRef" },
        "keySetFile": { "$ref": "#/$defs/jsonFile" },
        "keySetFileFingerprint": { "$ref": "#/$defs/fingerprint" },
        "pinnedKeySetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "maximumProofTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "proofFile": { "$ref": "#/$defs/jsonFile" },
        "proofFileFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "candidateAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "policy"],
      "properties": {
        "attestation": { "$ref": "#/$defs/coordinate" },
        "policy": { "$ref": "#/$defs/candidatePolicy" }
      }
    },
    "environmentAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "policy"],
      "properties": {
        "attestation": { "$ref": "#/$defs/coordinate" },
        "policy": { "$ref": "#/$defs/environmentPolicy" }
      }
    }
  }
}
