{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-capability-studio/capability-studio-stage-acceptance-provider-conformance-result-v1.schema.json",
  "title": "Capability Studio Stage Acceptance Provider Conformance Result v1",
  "description": "Strict result for the Provider Conformance TCK. The result records protocol mechanism conformance only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "reasonCode",
    "resultBinding",
    "verifiedAt",
    "checks",
    "summary",
    "externalChecksRequired",
    "reportFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.capabilityStudioStageAcceptanceProviderConformanceResult.v1"
    },
    "verdict": {
      "enum": ["CONFORMANT", "NON_CONFORMANT", "BLOCKED", "INPUT_INVALID"]
    },
    "reasonCode": {
      "$ref": "#/$defs/reasonCode"
    },
    "resultBinding": {
      "anyOf": [
        { "$ref": "#/$defs/resultBinding" },
        { "type": "null" }
      ]
    },
    "verifiedAt": {
      "anyOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": {
            "checkId": { "const": "LOCAL_PROTOCOL" },
            "challengeCount": { "const": 0 }
          } }
        ] },
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": {
            "checkId": { "const": "BASELINE_AUTHORITY_ACCEPTANCE" },
            "challengeCount": { "const": 0 }
          } }
        ] },
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": {
            "checkId": { "const": "DETERMINISTIC_REPLAY" },
            "challengeCount": { "const": 0 }
          } }
        ] },
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": { "checkId": { "const": "RESOLVER_WRONG_FINGERPRINT_FAIL_CLOSED" } } },
          { "$ref": "#/$defs/challengeCountByStatus" }
        ] },
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": { "checkId": { "const": "EVIDENCE_POLICY_TAMPER_FAIL_CLOSED" } } },
          { "$ref": "#/$defs/challengeCountByStatus" }
        ] },
        { "allOf": [
          { "$ref": "#/$defs/check" },
          { "properties": { "checkId": { "const": "OWNER_AUTHORITY_TAMPER_FAIL_CLOSED" } } },
          { "$ref": "#/$defs/challengeCountByStatus" }
        ] }
      ],
      "items": false,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "LOCAL_PROTOCOL" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "BASELINE_AUTHORITY_ACCEPTANCE" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "DETERMINISTIC_REPLAY" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "RESOLVER_WRONG_FINGERPRINT_FAIL_CLOSED" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "EVIDENCE_POLICY_TAMPER_FAIL_CLOSED" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["checkId"],
            "properties": { "checkId": { "const": "OWNER_AUTHORITY_TAMPER_FAIL_CLOSED" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "externalChecksRequired": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "TRUST_ROOT_ORGANIZATION" },
        { "const": "KMS_HSM_CUSTODY" },
        { "const": "TARGET_ENVIRONMENT_TRANSPORT" },
        { "const": "DEPLOYMENT_EGRESS_ENFORCEMENT" },
        { "const": "OWNER_PROCESS_ATTESTATION" }
      ],
      "items": false,
      "allOf": [
        {
          "contains": { "const": "TRUST_ROOT_ORGANIZATION" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "const": "KMS_HSM_CUSTODY" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "const": "TARGET_ENVIRONMENT_TRANSPORT" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "const": "DEPLOYMENT_EGRESS_ENFORCEMENT" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "const": "OWNER_PROCESS_ATTESTATION" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "reportFingerprint": {
      "$ref": "#/$defs/fingerprint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "CONFORMANT" } }
      },
      "then": {
        "properties": {
          "resultBinding": { "$ref": "#/$defs/resultBinding" },
          "verifiedAt": { "$ref": "#/$defs/dateTime" },
          "summary": {
            "properties": {
              "passCount": { "const": 6 },
              "failCount": { "const": 0 },
              "blockedCount": { "const": 0 },
              "notRunCount": { "const": 0 },
              "challengeCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "NON_CONFORMANT" } }
      },
      "then": {
        "properties": {
          "resultBinding": { "$ref": "#/$defs/resultBinding" },
          "verifiedAt": { "$ref": "#/$defs/dateTime" },
          "summary": {
            "properties": {
              "failCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "BLOCKED" } }
      },
      "then": {
        "properties": {
          "resultBinding": { "$ref": "#/$defs/resultBinding" },
          "verifiedAt": { "$ref": "#/$defs/dateTime" },
          "summary": {
            "properties": {
              "failCount": { "const": 0 },
              "blockedCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "INPUT_INVALID" } }
      },
      "then": {
        "properties": {
          "resultBinding": { "type": "null" },
          "verifiedAt": { "type": "null" },
          "summary": {
            "properties": {
              "passCount": { "const": 0 },
              "failCount": { "const": 1 },
              "blockedCount": { "const": 0 },
              "notRunCount": { "const": 5 },
              "challengeCount": { "const": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "maxLength": 80
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 57,
      "maxLength": 255,
      "pattern": "^RG\\.CAPABILITY_STUDIO\\.STAGE_ACCEPTANCE_PROVIDER_CONFORMANCE\\.[A-Z][A-Z0-9_.-]*$"
    },
    "resultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "revision", "resultFingerprint"],
      "properties": {
        "resultId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 124,
          "pattern": "^SAR-[A-Za-z0-9._-]{1,120}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resultFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "reasonCode", "challengeCount"],
      "properties": {
        "checkId": {
          "enum": [
            "LOCAL_PROTOCOL",
            "BASELINE_AUTHORITY_ACCEPTANCE",
            "DETERMINISTIC_REPLAY",
            "RESOLVER_WRONG_FINGERPRINT_FAIL_CLOSED",
            "EVIDENCE_POLICY_TAMPER_FAIL_CLOSED",
            "OWNER_AUTHORITY_TAMPER_FAIL_CLOSED"
          ]
        },
        "status": {
          "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "challengeCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "challengeCountByStatus": {
      "if": {
        "properties": { "status": { "const": "NOT_RUN" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "challengeCount": { "const": 0 } }
      },
      "else": {
        "properties": { "challengeCount": { "type": "integer", "minimum": 1 } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCount",
        "passCount",
        "failCount",
        "blockedCount",
        "notRunCount",
        "challengeCount"
      ],
      "properties": {
        "totalCount": { "const": 6 },
        "passCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "failCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "blockedCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "notRunCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "challengeCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
