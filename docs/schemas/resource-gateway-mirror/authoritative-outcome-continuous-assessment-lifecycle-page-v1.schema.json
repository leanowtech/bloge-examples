{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-continuous-assessment-lifecycle-page-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Continuous Assessment Lifecycle Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "afterOrdinal",
    "predecessorFingerprint",
    "nextOrdinal",
    "hasMore",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeContinuousAssessmentLifecyclePage.v1"
    },
    "projectionId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "afterOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "predecessorFingerprint": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "nextOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "hasMore": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "authoritative-outcome-continuous-assessment-lifecycle-event-v1.schema.json"
      }
    }
  }
}
