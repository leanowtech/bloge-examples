{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-continuous-assessment-remediation-request-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Continuous Assessment Remediation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "expectedProjectionFingerprint",
    "expectedLifecycleHeadOrdinal",
    "expectedLifecycleHeadFingerprint",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeContinuousAssessmentRemediationRequest.v1"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "expectedProjectionFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "expectedLifecycleHeadOrdinal": {
      "type": "integer",
      "minimum": 1
    },
    "expectedLifecycleHeadFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    }
  }
}
