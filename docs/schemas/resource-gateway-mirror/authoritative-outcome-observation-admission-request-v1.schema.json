{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-observation-admission-request-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Observation Admission Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedPredecessorFingerprint",
    "observation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeObservationAdmission.v1"
    },
    "expectedPredecessorFingerprint": {
      "$ref": "#/$defs/optionalFingerprint"
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "authoritative-outcome-observation-v1.schema.json"
        },
        {
          "$ref": "#/$defs/unsignedObservation"
        }
      ]
    }
  },
  "$defs": {
    "optionalFingerprint": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "unsignedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "observationId",
        "revision",
        "observationFingerprint",
        "scope",
        "inventoryRef",
        "unitId",
        "scenarioCaseRef",
        "targetCapabilityRef",
        "outcomeDefinitionRef",
        "attributionPolicyRef",
        "authoritySetRef",
        "selectionProof",
        "subjectFingerprint",
        "attributionKeyFingerprint",
        "modelOutcomeFingerprint",
        "attributionWindow",
        "reconciledAt",
        "attestedAt",
        "authorityWatermarks",
        "authorityFacts",
        "reconciliation",
        "evidenceComplete",
        "observationSeal"
      ],
      "properties": {
        "schemaVersion": {
          "const": "resourceGateway.authoritativeOutcomeObservation.v1"
        },
        "observationId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "observationFingerprint": {
          "const": ""
        },
        "scope": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
        },
        "inventoryRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/inventoryRef"
        },
        "unitId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "scenarioCaseRef": {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/scenarioCaseRef"
        },
        "targetCapabilityRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/capabilityRef"
        },
        "outcomeDefinitionRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/outcomeDefinitionRef"
        },
        "attributionPolicyRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/attributionPolicyRef"
        },
        "authoritySetRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/authoritySetRef"
        },
        "selectionProof": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/selectionProof"
        },
        "subjectFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "attributionKeyFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "modelOutcomeFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "attributionWindow": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/attributionWindow"
        },
        "reconciledAt": {
          "type": "string",
          "format": "date-time"
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorityWatermarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/authorityWatermark"
          }
        },
        "authorityFacts": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/authorityFact"
          }
        },
        "reconciliation": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "PENDING",
            "CENSORED",
            "CONFLICT"
          ]
        },
        "evidenceComplete": {
          "type": "boolean"
        },
        "observationSeal": {
          "$ref": "#/$defs/unsignedSeal"
        }
      }
    },
    "unsignedSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "materialFingerprint",
        "algorithm",
        "keyId",
        "signedAt",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualRunEvidenceSeal.v1"
        },
        "materialFingerprint": {
          "const": ""
        },
        "algorithm": {
          "const": ""
        },
        "keyId": {
          "const": ""
        },
        "signedAt": {
          "const": "1970-01-01T00:00:00Z"
        },
        "signature": {
          "const": ""
        }
      }
    }
  }
}
