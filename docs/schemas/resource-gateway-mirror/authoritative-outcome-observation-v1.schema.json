{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-observation-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observationId",
    "revision",
    "observationFingerprint",
    "scope",
    "inventoryRef",
    "unitId",
    "scenarioCaseRef",
    "targetCapabilityRef",
    "outcomeDefinitionRef",
    "attributionPolicyRef",
    "authoritySetRef",
    "selectionProof",
    "subjectFingerprint",
    "attributionKeyFingerprint",
    "modelOutcomeFingerprint",
    "attributionWindow",
    "reconciledAt",
    "attestedAt",
    "authorityWatermarks",
    "authorityFacts",
    "reconciliation",
    "evidenceComplete",
    "observationSeal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeObservation.v1"
    },
    "observationId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "observationFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "inventoryRef": {
      "$ref": "#/$defs/inventoryRef"
    },
    "unitId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "scenarioCaseRef": {
      "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/scenarioCaseRef"
    },
    "targetCapabilityRef": {
      "$ref": "#/$defs/capabilityRef"
    },
    "outcomeDefinitionRef": {
      "$ref": "#/$defs/outcomeDefinitionRef"
    },
    "attributionPolicyRef": {
      "$ref": "#/$defs/attributionPolicyRef"
    },
    "authoritySetRef": {
      "$ref": "#/$defs/authoritySetRef"
    },
    "selectionProof": {
      "$ref": "#/$defs/selectionProof"
    },
    "subjectFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "attributionKeyFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "modelOutcomeFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "attributionWindow": {
      "$ref": "#/$defs/attributionWindow"
    },
    "reconciledAt": {
      "type": "string",
      "format": "date-time"
    },
    "attestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorityWatermarks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/authorityWatermark"
      }
    },
    "authorityFacts": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/authorityFact"
      }
    },
    "reconciliation": {
      "type": "string",
      "enum": [
        "MATCH",
        "MISMATCH",
        "PENDING",
        "CENSORED",
        "CONFLICT"
      ]
    },
    "evidenceComplete": {
      "type": "boolean"
    },
    "observationSeal": {
      "$ref": "domain-fidelity-profile-v1.schema.json#/$defs/evidenceSeal"
    }
  },
  "$defs": {
    "selectionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortRef",
        "samplingFrameRef",
        "stratumId",
        "inclusionFingerprint",
        "selectedAt",
        "eligiblePopulationSize",
        "selectedPopulationSize",
        "sampleOrdinal",
        "selectionMode"
      ],
      "properties": {
        "cohortRef": {
          "$ref": "#/$defs/cohortRef"
        },
        "samplingFrameRef": {
          "$ref": "#/$defs/samplingFrameRef"
        },
        "stratumId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "inclusionFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "selectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "eligiblePopulationSize": {
          "type": "integer",
          "minimum": 1
        },
        "selectedPopulationSize": {
          "type": "integer",
          "minimum": 1
        },
        "sampleOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "selectionMode": {
          "type": "string",
          "enum": [
            "CENSUS",
            "HASH_PARTITION",
            "STRATIFIED_RANDOM"
          ]
        }
      }
    },
    "attributionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionOccurredAt",
        "opensAt",
        "closesAt"
      ],
      "properties": {
        "actionOccurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "opensAt": {
          "type": "string",
          "format": "date-time"
        },
        "closesAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authorityWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId",
        "watermarkRef",
        "eventTimeThrough",
        "publishedAt"
      ],
      "properties": {
        "authorityId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "watermarkRef": {
          "$ref": "#/$defs/watermarkRef"
        },
        "eventTimeThrough": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authorityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId",
        "sourceRef",
        "subjectFingerprint",
        "attributionKeyFingerprint",
        "outcomeFingerprint",
        "occurredAt",
        "recordedAt",
        "evidenceComplete"
      ],
      "properties": {
        "authorityId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRecordRef"
        },
        "subjectFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "attributionKeyFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "outcomeFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceComplete": {
          "type": "boolean"
        }
      }
    },
    "inventoryRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "DOMAIN_FIDELITY_INVENTORY"
            }
          }
        }
      ]
    },
    "capabilityRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "CAPABILITY"
            }
          }
        }
      ]
    },
    "outcomeDefinitionRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "OUTCOME_DEFINITION"
            }
          }
        }
      ]
    },
    "attributionPolicyRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "OUTCOME_ATTRIBUTION_POLICY"
            }
          }
        }
      ]
    },
    "authoritySetRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "OUTCOME_AUTHORITY_SET"
            }
          }
        }
      ]
    },
    "cohortRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "OUTCOME_CALIBRATION_COHORT"
            }
          }
        }
      ]
    },
    "samplingFrameRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "OUTCOME_SAMPLING_FRAME"
            }
          }
        }
      ]
    },
    "watermarkRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "AUTHORITATIVE_OUTCOME_SOURCE_WATERMARK"
            }
          }
        }
      ]
    },
    "sourceRecordRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "AUTHORITATIVE_OUTCOME_SOURCE_RECORD"
            }
          }
        }
      ]
    }
  }
}
