{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-selected-population-admission-request-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Selected Population Admission Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedPredecessorFingerprint",
    "manifest",
    "chunks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeSelectedPopulationAdmission.v1"
    },
    "expectedPredecessorFingerprint": {
      "$ref": "#/$defs/optionalFingerprint"
    },
    "manifest": {
      "$ref": "#/$defs/candidateManifest"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "authoritative-outcome-selected-population-chunk-v1.schema.json"
      }
    }
  },
  "$defs": {
    "optionalFingerprint": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "candidateManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "populationId",
        "revision",
        "manifestFingerprint",
        "scope",
        "inventoryRef",
        "cohortRef",
        "samplingFrameRef",
        "selectionPolicyRef",
        "selectionAuthoritySetRef",
        "selectionAttestationRef",
        "selectedAt",
        "strata",
        "chunks",
        "totalEligiblePopulation",
        "totalSelectedPopulation",
        "attestedAt",
        "manifestSeal"
      ],
      "properties": {
        "schemaVersion": {
          "const": "resourceGateway.authoritativeOutcomeSelectedPopulationManifest.v1"
        },
        "populationId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifestFingerprint": {
          "$ref": "#/$defs/optionalFingerprint"
        },
        "scope": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
        },
        "inventoryRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/inventoryRef"
        },
        "cohortRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/cohortRef"
        },
        "samplingFrameRef": {
          "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/samplingFrameRef"
        },
        "selectionPolicyRef": {
          "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json#/$defs/artifactRef"
        },
        "selectionAuthoritySetRef": {
          "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json#/$defs/artifactRef"
        },
        "selectionAttestationRef": {
          "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json#/$defs/artifactRef"
        },
        "selectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json#/$defs/stratum"
          }
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json#/$defs/chunkDescriptor"
          }
        },
        "totalEligiblePopulation": {
          "type": "integer",
          "minimum": 1
        },
        "totalSelectedPopulation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "manifestSeal": {
          "oneOf": [
            {
              "$ref": "domain-fidelity-profile-v1.schema.json#/$defs/evidenceSeal"
            },
            {
              "$ref": "#/$defs/unsignedSeal"
            }
          ]
        }
      }
    },
    "unsignedSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "materialFingerprint",
        "algorithm",
        "keyId",
        "signedAt",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualRunEvidenceSeal.v1"
        },
        "materialFingerprint": {
          "const": ""
        },
        "algorithm": {
          "const": ""
        },
        "keyId": {
          "const": ""
        },
        "signedAt": {
          "const": "1970-01-01T00:00:00Z"
        },
        "signature": {
          "const": ""
        }
      }
    }
  }
}
