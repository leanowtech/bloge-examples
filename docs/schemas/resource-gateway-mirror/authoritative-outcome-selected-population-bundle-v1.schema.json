{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-selected-population-bundle-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Selected Population Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifest",
    "chunks",
    "predecessorFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeSelectedPopulationBundle.v1"
    },
    "manifest": {
      "$ref": "authoritative-outcome-selected-population-manifest-v1.schema.json"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "authoritative-outcome-selected-population-chunk-v1.schema.json"
      }
    },
    "predecessorFingerprint": {
      "$ref": "authoritative-outcome-selected-population-admission-request-v1.schema.json#/$defs/optionalFingerprint"
    }
  }
}
