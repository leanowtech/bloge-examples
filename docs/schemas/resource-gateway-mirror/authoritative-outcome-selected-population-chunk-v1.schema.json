{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/authoritative-outcome-selected-population-chunk-v1.schema.json",
  "title": "Resource Gateway Authoritative Outcome Selected Population Chunk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chunkId",
    "chunkFingerprint",
    "populationId",
    "populationRevision",
    "scope",
    "inventoryRef",
    "cohortRef",
    "samplingFrameRef",
    "selectedAt",
    "chunkIndex",
    "firstGlobalOrdinal",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.authoritativeOutcomeSelectedPopulationChunk.v1"
    },
    "chunkId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "chunkFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "populationId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "populationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "inventoryRef": {
      "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/inventoryRef"
    },
    "cohortRef": {
      "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/cohortRef"
    },
    "samplingFrameRef": {
      "$ref": "authoritative-outcome-observation-v1.schema.json#/$defs/samplingFrameRef"
    },
    "selectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "chunkIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "firstGlobalOrdinal": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalOrdinal",
        "unitId",
        "stratumId",
        "sampleOrdinal",
        "inclusionFingerprint",
        "subjectFingerprint",
        "attributionKeyFingerprint"
      ],
      "properties": {
        "globalOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "unitId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "stratumId": {
          "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
        },
        "sampleOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "inclusionFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "subjectFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "attributionKeyFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        }
      }
    }
  }
}
