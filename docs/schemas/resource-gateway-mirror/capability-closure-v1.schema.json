{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-closure-v1.schema.json",
  "title": "Resource Gateway Capability Closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rootRef", "snapshots", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.capabilityClosure.v1" },
    "rootRef": { "$ref": "#/$defs/capabilityRef" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10001,
      "items": { "$ref": "capability-snapshot-v1.schema.json" }
    },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "const": "CAPABILITY" },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
