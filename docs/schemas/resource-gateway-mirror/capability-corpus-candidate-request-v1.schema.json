{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-corpus-candidate-request-v1.schema.json",
  "title": "Resource Gateway Capability Corpus Candidate Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "corpusId", "revision", "expectedPredecessorRef",
    "capabilityRef", "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityCorpusCandidateRequest.v1"
    },
    "corpusId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "expectedPredecessorRef": {
      "oneOf": [
        { "$ref": "#/$defs/corpusRevisionRef" },
        { "type": "null" }
      ]
    },
    "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/sourceCoordinate" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": { "expectedPredecessorRef": { "type": "null" } }
      },
      "else": {
        "properties": {
          "expectedPredecessorRef": { "$ref": "#/$defs/corpusRevisionRef" }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY", "CAPABILITY_CORPUS_REVISION",
            "CAPABILITY_OBSERVATION", "CAPABILITY_OBSERVATION_ADMISSION"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY" } } }
      ]
    },
    "corpusRevisionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY_CORPUS_REVISION" } } }
      ]
    },
    "observationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY_OBSERVATION" } } }
      ]
    },
    "admissionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_OBSERVATION_ADMISSION" }
          }
        }
      ]
    },
    "sourceCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationRef", "admissionRef"],
      "properties": {
        "observationRef": { "$ref": "#/$defs/observationRef" },
        "admissionRef": { "$ref": "#/$defs/admissionRef" }
      }
    }
  }
}
