{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-corpus-publication-v1.schema.json",
  "title": "Resource Gateway Capability Corpus Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "publicationFingerprint", "sourceCommandFingerprint",
    "scope", "corpusId", "revision", "predecessorRef", "corpusRevisionRef",
    "publicationPolicyRef", "reviewTicketRef", "reasonCode", "reviewedBy",
    "publishedAt", "usableUntil"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityCorpusPublication.v1"
    },
    "publicationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "sourceCommandFingerprint": { "$ref": "#/$defs/fingerprint" },
    "scope": { "$ref": "#/$defs/scope" },
    "corpusId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "predecessorRef": {
      "oneOf": [
        { "$ref": "#/$defs/corpusPublicationRef" },
        { "type": "null" }
      ]
    },
    "corpusRevisionRef": { "$ref": "#/$defs/corpusRevisionRef" },
    "publicationPolicyRef": { "$ref": "#/$defs/publicationPolicyRef" },
    "reviewTicketRef": { "$ref": "#/$defs/reviewTicketRef" },
    "reasonCode": { "$ref": "#/$defs/reasonCode" },
    "reviewedBy": { "$ref": "#/$defs/actorId" },
    "publishedAt": { "$ref": "#/$defs/canonicalInstant" },
    "usableUntil": { "$ref": "#/$defs/canonicalInstant" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": { "predecessorRef": { "type": "null" } }
      },
      "else": {
        "properties": {
          "predecessorRef": { "$ref": "#/$defs/corpusPublicationRef" }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/#-]{0,511}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3})?(?:[0-9]{3})?)?Z$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId", "organizationId", "projectId", "environmentId", "region"
      ],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "projectId": { "type": "string", "maxLength": 255 },
        "environmentId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "region": { "type": "string", "maxLength": 96 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY_CORPUS_REVISION",
            "CAPABILITY_CORPUS_PUBLICATION",
            "CORPUS_PUBLICATION_POLICY",
            "GOVERNANCE_REVIEW_TICKET"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "corpusRevisionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY_CORPUS_REVISION" } } }
      ]
    },
    "corpusPublicationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_CORPUS_PUBLICATION" }
          }
        }
      ]
    },
    "publicationPolicyRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CORPUS_PUBLICATION_POLICY" } } }
      ]
    },
    "reviewTicketRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "GOVERNANCE_REVIEW_TICKET" } } }
      ]
    }
  }
}
