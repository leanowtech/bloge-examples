{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-corpus-publish-request-v1.schema.json",
  "title": "Resource Gateway Capability Corpus Publish Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "corpusId", "publicationRevision",
    "expectedPublicationRef", "corpusRevisionRef", "reviewTicketRef",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityCorpusPublishRequest.v1"
    },
    "corpusId": { "$ref": "#/$defs/identifier" },
    "publicationRevision": { "type": "integer", "minimum": 1 },
    "expectedPublicationRef": {
      "oneOf": [
        { "$ref": "#/$defs/corpusPublicationRef" },
        { "type": "null" }
      ]
    },
    "corpusRevisionRef": { "$ref": "#/$defs/corpusRevisionRef" },
    "reviewTicketRef": { "$ref": "#/$defs/reviewTicketRef" },
    "reasonCode": { "$ref": "#/$defs/reasonCode" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "publicationRevision": { "const": 1 } },
        "required": ["publicationRevision"]
      },
      "then": {
        "properties": { "expectedPublicationRef": { "type": "null" } }
      },
      "else": {
        "properties": {
          "expectedPublicationRef": { "$ref": "#/$defs/corpusPublicationRef" }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY_CORPUS_REVISION",
            "CAPABILITY_CORPUS_PUBLICATION",
            "GOVERNANCE_REVIEW_TICKET"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "corpusRevisionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY_CORPUS_REVISION" } } }
      ]
    },
    "corpusPublicationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_CORPUS_PUBLICATION" }
          }
        }
      ]
    },
    "reviewTicketRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "GOVERNANCE_REVIEW_TICKET" } } }
      ]
    }
  }
}
