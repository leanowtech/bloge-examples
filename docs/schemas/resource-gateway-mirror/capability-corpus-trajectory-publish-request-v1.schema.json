{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-corpus-trajectory-publish-request-v1.schema.json",
  "title": "Resource Gateway Capability Corpus Trajectory Publish Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "trajectoryId", "revision", "expectedPredecessorRef",
    "capabilityRef", "corpusPublicationRef", "retryPolicyRef", "attempts",
    "reviewTicketRef", "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityCorpusTrajectoryPublishRequest.v1"
    },
    "trajectoryId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "expectedPredecessorRef": {
      "oneOf": [
        { "$ref": "#/$defs/trajectoryPublicationRef" },
        { "type": "null" }
      ]
    },
    "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
    "corpusPublicationRef": { "$ref": "#/$defs/corpusPublicationRef" },
    "retryPolicyRef": { "$ref": "#/$defs/retryPolicyRef" },
    "attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/attemptSource" }
    },
    "reviewTicketRef": { "$ref": "#/$defs/reviewTicketRef" },
    "reasonCode": { "$ref": "#/$defs/reasonCode" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": { "expectedPredecessorRef": { "type": "null" } }
      },
      "else": {
        "properties": {
          "expectedPredecessorRef": {
            "$ref": "#/$defs/trajectoryPublicationRef"
          }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY",
            "CAPABILITY_OBSERVATION",
            "CAPABILITY_OBSERVATION_ADMISSION",
            "CAPABILITY_CORPUS_PUBLICATION",
            "CAPABILITY_CORPUS_TRAJECTORY_PUBLICATION",
            "RETRY_POLICY",
            "GOVERNANCE_REVIEW_TICKET"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY" } } }
      ]
    },
    "observationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_OBSERVATION" }
          }
        }
      ]
    },
    "admissionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_OBSERVATION_ADMISSION" }
          }
        }
      ]
    },
    "corpusPublicationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_CORPUS_PUBLICATION" }
          }
        }
      ]
    },
    "trajectoryPublicationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": {
              "const": "CAPABILITY_CORPUS_TRAJECTORY_PUBLICATION"
            }
          }
        }
      ]
    },
    "retryPolicyRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "RETRY_POLICY" } } }
      ]
    },
    "reviewTicketRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "GOVERNANCE_REVIEW_TICKET" }
          }
        }
      ]
    },
    "attemptSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "observationRef", "admissionRef"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 32 },
        "observationRef": { "$ref": "#/$defs/observationRef" },
        "admissionRef": { "$ref": "#/$defs/admissionRef" }
      }
    }
  }
}
