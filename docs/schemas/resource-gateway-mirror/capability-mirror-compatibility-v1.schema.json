{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-mirror-compatibility-v1.schema.json",
  "title": "Resource Gateway Capability Mirror Compatibility Baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "protocolVersions",
    "requiredObjects",
    "requiredFeatures",
    "deferredFeatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityMirrorCompatibility.v1"
    },
    "protocol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "requiredObjects": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "requiredFeatures": {
      "$ref": "#/$defs/features"
    },
    "deferredFeatures": {
      "$ref": "#/$defs/features"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "features": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    }
  }
}
