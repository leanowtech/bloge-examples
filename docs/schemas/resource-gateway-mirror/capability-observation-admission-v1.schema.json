{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-observation-admission-v1.schema.json",
  "title": "Resource Gateway Capability Observation Admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "admissionFingerprint", "observationRef", "scope",
    "capabilityRef", "policyRef", "dataUseGrantRef", "authorityKeyRef",
    "state", "reason", "decidedAt", "usableUntil"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityObservationAdmission.v1"
    },
    "admissionFingerprint": { "$ref": "#/$defs/fingerprint" },
    "observationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_OBSERVATION" }
          }
        }
      ]
    },
    "scope": { "$ref": "#/$defs/scope" },
    "capabilityRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY" } } }
      ]
    },
    "policyRef": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/artifactRef" },
            {
              "properties": {
                "kind": { "const": "OBSERVATION_ADMISSION_POLICY" }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "dataUseGrantRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DATA_USE_GRANT" } } }
      ]
    },
    "authorityKeyRef": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/artifactRef" },
            {
              "properties": {
                "kind": { "const": "OBSERVATION_AUTHORITY_KEY" }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "state": { "enum": ["ADMITTED", "QUARANTINED"] },
    "reason": {
      "enum": [
        "ACCEPTED", "ADMISSION_POLICY_NOT_FOUND", "CAPABILITY_NOT_ELIGIBLE",
        "INTEGRITY_REJECTED", "DATA_USE_GRANT_REJECTED",
        "OBSERVATION_WINDOW_REJECTED", "PAYLOAD_POLICY_REJECTED",
        "PAYLOAD_REFERENCE_REJECTED"
      ]
    },
    "decidedAt": { "$ref": "#/$defs/canonicalInstant" },
    "usableUntil": { "$ref": "#/$defs/canonicalInstant" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "ADMITTED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "reason": { "const": "ACCEPTED" },
          "policyRef": { "$ref": "#/$defs/artifactRef" },
          "authorityKeyRef": { "$ref": "#/$defs/artifactRef" }
        }
      },
      "else": {
        "properties": {
          "reason": { "not": { "const": "ACCEPTED" } }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3})?(?:[0-9]{3})?)?Z$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId", "organizationId", "projectId", "environmentId", "region"
      ],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "projectId": { "type": "string", "maxLength": 255 },
        "environmentId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "region": { "type": "string", "maxLength": 96 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY", "CAPABILITY_OBSERVATION", "DATA_USE_GRANT",
            "OBSERVATION_ADMISSION_POLICY", "OBSERVATION_AUTHORITY_KEY"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
