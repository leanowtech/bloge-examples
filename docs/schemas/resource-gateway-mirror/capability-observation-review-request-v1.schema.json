{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/capability-observation-review-request-v1.schema.json",
  "title": "Resource Gateway Capability Observation Review Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "observationRef", "admissionRef", "disposition",
    "reviewTicketRef", "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.capabilityObservationReviewRequest.v1"
    },
    "observationRef": { "$ref": "#/$defs/observationRef" },
    "admissionRef": { "$ref": "#/$defs/admissionRef" },
    "disposition": {
      "enum": [
        "CONFIRMED_QUARANTINE",
        "PRODUCER_REMEDIATION_REQUIRED",
        "POLICY_REMEDIATION_REQUIRED",
        "SECURITY_INVESTIGATION_REQUIRED",
        "FALSE_POSITIVE_REINGEST_REQUIRED"
      ]
    },
    "reviewTicketRef": { "$ref": "#/$defs/reviewTicketRef" },
    "reasonCode": { "$ref": "#/$defs/reasonCode" }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "CAPABILITY_OBSERVATION",
            "CAPABILITY_OBSERVATION_ADMISSION",
            "GOVERNANCE_REVIEW_TICKET"
          ]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "observationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY_OBSERVATION" } } }
      ]
    },
    "admissionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "const": "CAPABILITY_OBSERVATION_ADMISSION" }
          }
        }
      ]
    },
    "reviewTicketRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "GOVERNANCE_REVIEW_TICKET" } } }
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    }
  }
}
