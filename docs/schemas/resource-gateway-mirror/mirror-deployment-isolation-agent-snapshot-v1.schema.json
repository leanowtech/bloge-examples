{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-deployment-isolation-agent-snapshot-v1.schema.json",
  "title": "Resource Gateway Mirror Deployment Isolation Agent Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "snapshotFingerprint", "cacheGeneration", "refreshedAt",
    "validUntil", "authorityPublication", "attestationBundle"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorDeploymentIsolationAgentSnapshot.v1"
    },
    "snapshotFingerprint": { "$ref": "#/$defs/fingerprint" },
    "cacheGeneration": { "type": "integer", "minimum": 1 },
    "refreshedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "authorityPublication": {
      "oneOf": [
        {
          "$ref": "mirror-deployment-isolation-authority-key-set-publication-v1.schema.json"
        },
        { "type": "null" }
      ]
    },
    "attestationBundle": {
      "$ref": "mirror-deployment-isolation-attestation-bundle-v1.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attestationBundle": {
            "properties": {
              "status": {
                "properties": {
                  "material": {
                    "properties": {
                      "state": { "const": "ACTIVE" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorityPublication": {
            "$ref": "mirror-deployment-isolation-authority-key-set-publication-v1.schema.json"
          }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
