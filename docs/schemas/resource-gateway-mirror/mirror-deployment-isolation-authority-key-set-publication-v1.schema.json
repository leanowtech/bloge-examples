{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-deployment-isolation-authority-key-set-publication-v1.schema.json",
  "title": "Resource Gateway Mirror Deployment Isolation Authority Key Set Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "publicationFingerprint", "materialFingerprint", "material", "signatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorDeploymentIsolationAuthorityKeySetPublication.v1"
    },
    "publicationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
    "material": { "$ref": "#/$defs/material" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rootSignature" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "optionalIdentifier": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/identifier" }
      ]
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3})?(?:[0-9]{3})?)?Z$"
    },
    "canonicalBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "organizationId", "projectId", "environmentId", "region"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/optionalIdentifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/optionalIdentifier" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentScopeId", "clusterId", "namespace", "workloadName",
        "serviceAccount", "imageDigest"
      ],
      "properties": {
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "clusterId": { "$ref": "#/$defs/identifier" },
        "namespace": { "$ref": "#/$defs/identifier" },
        "workloadName": { "$ref": "#/$defs/identifier" },
        "serviceAccount": { "$ref": "#/$defs/identifier" },
        "imageDigest": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "authorityKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "encodedPublicKey", "notBefore", "notAfter", "state"],
      "properties": {
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "encodedPublicKey": { "$ref": "#/$defs/canonicalBase64" },
        "notBefore": { "$ref": "#/$defs/canonicalInstant" },
        "notAfter": { "$ref": "#/$defs/canonicalInstant" },
        "state": { "enum": ["ACTIVE", "RETIRED", "REVOKED"] }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keySetId", "generation", "previousPublicationFingerprint", "scope", "deployment",
        "attestationIssuer", "rootTrustDomain", "rootThreshold", "policyFingerprint",
        "issuedAt", "notBefore", "expiresAt", "authorityKeys"
      ],
      "properties": {
        "keySetId": { "$ref": "#/$defs/identifier" },
        "generation": { "type": "integer", "minimum": 1 },
        "previousPublicationFingerprint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "scope": { "$ref": "#/$defs/scope" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "attestationIssuer": { "$ref": "#/$defs/identifier" },
        "rootTrustDomain": { "$ref": "#/$defs/identifier" },
        "rootThreshold": { "type": "integer", "minimum": 1, "maximum": 16 },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/canonicalInstant" },
        "notBefore": { "$ref": "#/$defs/canonicalInstant" },
        "expiresAt": { "$ref": "#/$defs/canonicalInstant" },
        "authorityKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityKey" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "generation": { "const": 1 } }, "required": ["generation"] },
          "then": { "properties": { "previousPublicationFingerprint": { "const": "" } } },
          "else": { "properties": { "previousPublicationFingerprint": { "$ref": "#/$defs/fingerprint" } } }
        }
      ]
    },
    "rootSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "$ref": "#/$defs/canonicalInstant" },
        "signature": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
