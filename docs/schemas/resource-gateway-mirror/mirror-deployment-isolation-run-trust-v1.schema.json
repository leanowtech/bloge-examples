{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-deployment-isolation-run-trust-v1.schema.json",
  "title": "Resource Gateway Mirror Deployment Isolation Run Trust v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decisionRef", "authorityKeySetRef", "attestationRef",
    "statusRef", "admittedSnapshotRef", "committedSnapshotRef", "admittedAt",
    "confirmedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorDeploymentIsolationRunTrust.v1"
    },
    "decisionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_ATTESTATION_BUNDLE" } } }
      ]
    },
    "authorityKeySetRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_AUTHORITY_KEY_SET" } } }
      ]
    },
    "attestationRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_ATTESTATION" } } }
      ]
    },
    "statusRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_ATTESTATION_STATUS" } } }
      ]
    },
    "admittedSnapshotRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_AGENT_SNAPSHOT" } } }
      ]
    },
    "committedSnapshotRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DEPLOYMENT_ISOLATION_AGENT_SNAPSHOT" } } }
      ]
    },
    "admittedAt": { "type": "string", "format": "date-time" },
    "confirmedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
