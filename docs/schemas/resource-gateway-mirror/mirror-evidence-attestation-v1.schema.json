{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-evidence-attestation-v1.schema.json",
  "title": "Resource Gateway Mirror Evidence Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "signatureStatus", "runId", "planFingerprint",
    "evidenceFingerprint", "signedAt", "keyId", "algorithm", "signature",
    "independentlyVerifiable"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.mirrorEvidenceAttestation.v1" },
    "signatureStatus": { "enum": ["VERIFIED", "VERIFICATION_UNAVAILABLE"] },
    "runId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" },
    "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
    "signedAt": { "type": "string", "format": "date-time" },
    "keyId": { "type": "string", "maxLength": 1024 },
    "algorithm": { "type": "string", "maxLength": 64 },
    "signature": { "type": "string", "maxLength": 16384 },
    "independentlyVerifiable": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "signatureStatus": { "const": "VERIFIED" } } },
      "then": {
        "properties": {
          "keyId": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "algorithm": { "const": "Ed25519" },
          "signature": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "independentlyVerifiable": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "signatureStatus": { "const": "VERIFICATION_UNAVAILABLE" } } },
      "then": {
        "properties": {
          "signedAt": { "const": "1970-01-01T00:00:00Z" },
          "keyId": { "const": "" },
          "algorithm": { "const": "" },
          "signature": { "const": "" },
          "independentlyVerifiable": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
