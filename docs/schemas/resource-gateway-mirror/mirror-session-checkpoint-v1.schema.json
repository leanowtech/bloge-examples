{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-session-checkpoint-v1.schema.json",
  "title": "Resource Gateway Mirror Session Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "scope",
    "sessionId",
    "storeGeneration",
    "planFingerprint",
    "stateModelRef",
    "stateReadRefs",
    "writeEffectRefs",
    "stateRevision",
    "logicalClock",
    "worldFingerprint",
    "stateFingerprint",
    "payloadFingerprint",
    "descriptorFingerprint",
    "sessionCreatedAt",
    "sessionUpdatedAt",
    "sessionExpiresAt",
    "checkpointedAt",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorSessionCheckpoint.v1"
    },
    "checkpointId": {
      "$ref": "session-state-space-v1.schema.json#/$defs/identifier"
    },
    "scope": {
      "$ref": "capability-snapshot-v1.schema.json#/$defs/scope"
    },
    "sessionId": {
      "$ref": "session-state-space-v1.schema.json#/$defs/identifier"
    },
    "storeGeneration": {
      "$ref": "mirror-session-store-generation-v1.schema.json"
    },
    "planFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "stateModelRef": {
      "$ref": "session-state-space-v1.schema.json#/$defs/stateModelRef"
    },
    "stateReadRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "session-state-space-v1.schema.json#/$defs/artifactRef"
          },
          {
            "properties": {
              "kind": {
                "const": "STATE_READ_SPEC"
              }
            }
          }
        ]
      }
    },
    "writeEffectRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "session-state-space-v1.schema.json#/$defs/writeEffectRef"
      }
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "logicalClock": {
      "type": "string",
      "format": "date-time"
    },
    "worldFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "stateFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "payloadFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "descriptorFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "sessionCreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sessionUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sessionExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "checkpointedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    }
  }
}
