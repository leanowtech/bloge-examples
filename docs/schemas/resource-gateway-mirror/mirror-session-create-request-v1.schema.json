    "requestId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorSessionCreateRequest.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{0,255}$"
    },
    "payload": {
      "$ref": "mirror-session-payload-v1.schema.json"
    }
  }
