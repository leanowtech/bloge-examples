{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-session-descriptor-v1.schema.json",
  "title": "Resource Gateway Mirror Session Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "scope",
    "planFingerprint",
    "stateModelRef",
    "writeEffectRefs",
    "stateRevision",
    "status",
    "worldFingerprint",
    "stateFingerprint",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "destroyedAt",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorSessionDescriptor.v1"
    },
    "sessionId": {
      "$ref": "session-state-space-v1.schema.json#/$defs/identifier"
    },
    "scope": {
      "$ref": "capability-snapshot-v1.schema.json#/$defs/scope"
    },
    "planFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "stateModelRef": {
      "$ref": "session-state-space-v1.schema.json#/$defs/stateModelRef"
    },
    "writeEffectRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "session-state-space-v1.schema.json#/$defs/writeEffectRef"
      }
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "DESTROYED"
      ]
    },
    "worldFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "stateFingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "destroyedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    }
  }
}
