{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-session-payload-v1.schema.json",
  "title": "Resource Gateway Mirror Session Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stateModel",
    "writeEffects",
    "state",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.mirrorSessionPayload.v1"
    },
    "stateModel": {
      "$ref": "state-model-v1.schema.json"
    },
    "stateReadSpecs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "state-read-spec-v1.schema.json"
      }
    },
    "writeEffects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "write-effect-spec-v1.schema.json"
      }
    },
    "state": {
      "allOf": [
        {
          "$ref": "session-state-space-v1.schema.json"
        },
        {
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,511}$"
            }
          }
        }
      ]
    },
    "fingerprint": {
      "$ref": "session-state-space-v1.schema.json#/$defs/fingerprint"
    }
  }
}
