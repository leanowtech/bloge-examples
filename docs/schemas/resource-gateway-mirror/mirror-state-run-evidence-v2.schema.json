{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-state-run-evidence-v2.schema.json",
  "title": "Resource Gateway Mirror State Run Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stateEvidenceFingerprint", "runId", "planFingerprint",
    "sessionStateRef", "finalSessionStateRef", "stateModelRef", "stateRevision",
    "finalStateRevision", "worldFingerprint", "finalWorldFingerprint",
    "logicalClock", "finalLogicalClock", "mode", "statefulBindings", "accesses",
    "transitions", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.mirrorStateRunEvidence.v2" },
    "stateEvidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" },
    "sessionStateRef": { "$ref": "#/$defs/sessionStateRef" },
    "finalSessionStateRef": { "$ref": "#/$defs/sessionStateRef" },
    "stateModelRef": { "$ref": "#/$defs/stateModelRef" },
    "stateRevision": { "type": "integer", "minimum": 0 },
    "finalStateRevision": { "type": "integer", "minimum": 0 },
    "worldFingerprint": { "$ref": "#/$defs/fingerprint" },
    "finalWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
    "logicalClock": { "type": "string", "format": "date-time" },
    "finalLogicalClock": { "type": "string", "format": "date-time" },
    "mode": { "const": "SERIALIZABLE_READ_WRITE" },
    "statefulBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/statefulBinding" }
    },
    "accesses": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/stateAccess" }
    },
    "transitions": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/stateTransition" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "optionalFingerprint": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/fingerprint" }
      ]
    },
    "sessionStateRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "SESSION_STATE" } } }
      ]
    },
    "stateModelRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "STATE_MODEL" } } }
      ]
    },
    "stateReadSpecRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "STATE_READ_SPEC" } } }
      ]
    },
    "writeEffectRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "WRITE_EFFECT" } } }
      ]
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY" } } }
      ]
    },
    "statefulBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSiteId", "graphPath", "capabilityRef", "interaction"
      ],
      "properties": {
        "invocationSiteId": {
          "type": "string", "minLength": 1, "maxLength": 2048
        },
        "graphPath": {
          "type": "string", "pattern": "^/.*", "maxLength": 2048
        },
        "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
        "interaction": { "enum": ["READ", "WRITE"] },
        "stateReadSpecRef": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stateReadSpecRef" }
          ]
        },
        "writeEffectRef": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/writeEffectRef" }
          ]
        }
      },
      "oneOf": [
        {
          "required": ["stateReadSpecRef"],
          "properties": {
            "interaction": { "const": "READ" },
            "stateReadSpecRef": { "$ref": "#/$defs/stateReadSpecRef" },
            "writeEffectRef": { "type": "null" }
          }
        },
        {
          "required": ["writeEffectRef"],
          "properties": {
            "interaction": { "const": "WRITE" },
            "stateReadSpecRef": { "type": "null" },
            "writeEffectRef": { "$ref": "#/$defs/writeEffectRef" }
          }
        }
      ]
    },
    "stateAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSiteId", "graphPath", "correlationKey", "occurrence",
        "attempt", "capabilityRef", "stateReadSpecRef", "observedStateRef",
        "observedStateRevision", "observedWorldFingerprint",
        "observedLogicalClock", "requestFingerprint", "businessKeyFingerprint",
        "outcome", "stateRecordFingerprint", "projectedOutputFingerprint",
        "errorCode"
      ],
      "properties": {
        "invocationSiteId": {
          "type": "string", "minLength": 1, "maxLength": 2048
        },
        "graphPath": {
          "type": "string", "pattern": "^/.*", "maxLength": 2048
        },
        "correlationKey": { "type": "string", "maxLength": 1024 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
        "stateReadSpecRef": { "$ref": "#/$defs/stateReadSpecRef" },
        "observedStateRef": { "$ref": "#/$defs/sessionStateRef" },
        "observedStateRevision": { "type": "integer", "minimum": 0 },
        "observedWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
        "observedLogicalClock": { "type": "string", "format": "date-time" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "businessKeyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "outcome": { "enum": ["LIVE_ENTITY", "ABSENT", "TOMBSTONED"] },
        "stateRecordFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "projectedOutputFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "errorCode": { "type": "string", "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "LIVE_ENTITY" } } },
          "then": {
            "properties": {
              "stateRecordFingerprint": { "$ref": "#/$defs/fingerprint" },
              "projectedOutputFingerprint": { "$ref": "#/$defs/fingerprint" },
              "errorCode": { "const": "" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "ABSENT" } } },
          "then": {
            "properties": {
              "stateRecordFingerprint": { "const": "" },
              "projectedOutputFingerprint": { "const": "" },
              "errorCode": { "const": "" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "TOMBSTONED" } } },
          "then": {
            "properties": {
              "stateRecordFingerprint": { "$ref": "#/$defs/fingerprint" },
              "projectedOutputFingerprint": { "const": "" },
              "errorCode": { "const": "RG.MIRROR.STATE.ENTITY_TOMBSTONED" }
            }
          }
        }
      ]
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSiteId", "graphPath", "correlationKey", "occurrence",
        "attempt", "capabilityRef", "writeEffectRef", "initialStateRef",
        "finalStateRef", "revisionBefore", "revisionAfter",
        "initialWorldFingerprint", "finalWorldFingerprint",
        "initialLogicalClock", "finalLogicalClock", "requestFingerprint",
        "idempotencyKeyFingerprint", "commandFingerprint",
        "receiptFingerprint", "responseFingerprint",
        "resultingWorldFingerprint", "committedAt", "replayed", "events"
      ],
      "properties": {
        "invocationSiteId": {
          "type": "string", "minLength": 1, "maxLength": 2048
        },
        "graphPath": {
          "type": "string", "pattern": "^/.*", "maxLength": 2048
        },
        "correlationKey": { "type": "string", "maxLength": 1024 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
        "writeEffectRef": { "$ref": "#/$defs/writeEffectRef" },
        "initialStateRef": { "$ref": "#/$defs/sessionStateRef" },
        "finalStateRef": { "$ref": "#/$defs/sessionStateRef" },
        "revisionBefore": { "type": "integer", "minimum": 0 },
        "revisionAfter": { "type": "integer", "minimum": 0 },
        "initialWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
        "finalWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
        "initialLogicalClock": { "type": "string", "format": "date-time" },
        "finalLogicalClock": { "type": "string", "format": "date-time" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "idempotencyKeyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "commandFingerprint": { "$ref": "#/$defs/fingerprint" },
        "receiptFingerprint": { "$ref": "#/$defs/fingerprint" },
        "responseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "resultingWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
        "committedAt": { "type": "string", "format": "date-time" },
        "replayed": { "type": "boolean" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/transitionEvent" }
        }
      }
    },
    "transitionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventIdFingerprint", "stateRevision", "mutationId", "operation",
        "entityType", "entityIdentityFingerprint", "beforeFingerprint",
        "afterFingerprint", "occurredAt", "eventFingerprint"
      ],
      "properties": {
        "eventIdFingerprint": { "$ref": "#/$defs/fingerprint" },
        "stateRevision": { "type": "integer", "minimum": 1 },
        "mutationId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operation": {
          "enum": ["COPY_IN", "CREATE", "UPDATE", "DELETE", "UPSERT"]
        },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 512 },
        "entityIdentityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "beforeFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "afterFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "eventFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
