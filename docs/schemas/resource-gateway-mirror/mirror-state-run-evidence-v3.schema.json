{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/mirror-state-run-evidence-v3.schema.json",
  "title": "Resource Gateway Mirror State Run Evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stateEvidenceFingerprint", "runId", "planFingerprint",
    "sessionStateRef", "finalSessionStateRef", "stateModelRef", "stateRevision",
    "finalStateRevision", "worldFingerprint", "finalWorldFingerprint",
    "logicalClock", "finalLogicalClock", "mode", "statefulBindings", "accesses",
    "writeAttempts", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.mirrorStateRunEvidence.v3" },
    "stateEvidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" },
    "sessionStateRef": { "$ref": "#/$defs/sessionStateRef" },
    "finalSessionStateRef": { "$ref": "#/$defs/sessionStateRef" },
    "stateModelRef": { "$ref": "#/$defs/stateModelRef" },
    "stateRevision": { "type": "integer", "minimum": 0 },
    "finalStateRevision": { "type": "integer", "minimum": 0 },
    "worldFingerprint": { "$ref": "#/$defs/fingerprint" },
    "finalWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
    "logicalClock": { "type": "string", "format": "date-time" },
    "finalLogicalClock": { "type": "string", "format": "date-time" },
    "mode": { "const": "SERIALIZABLE_READ_WRITE_OUTCOMES" },
    "statefulBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "mirror-state-run-evidence-v2.schema.json#/$defs/statefulBinding"
      }
    },
    "accesses": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "mirror-state-run-evidence-v2.schema.json#/$defs/stateAccess"
      }
    },
    "writeAttempts": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/writeAttempt" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "writeAttempts": {
            "contains": {
              "type": "object",
              "required": ["outcome"],
              "properties": {
                "outcome": { "const": "COMMIT_OUTCOME_UNKNOWN" }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": { "const": "WRITE_COMMIT_OUTCOME_UNKNOWN" }
          }
        }
      },
      "else": {
        "properties": {
          "limitations": {
            "not": {
              "contains": { "const": "WRITE_COMMIT_OUTCOME_UNKNOWN" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "optionalFingerprint": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/fingerprint" }
      ]
    },
    "sessionStateRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "SESSION_STATE" } } }
      ]
    },
    "stateModelRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "STATE_MODEL" } } }
      ]
    },
    "writeEffectRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "WRITE_EFFECT" } } }
      ]
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "mirror-run-evidence-v1.schema.json#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "CAPABILITY" } } }
      ]
    },
    "writeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSiteId", "graphPath", "correlationKey", "occurrence",
        "attempt", "capabilityRef", "writeEffectRef", "observedStateRef",
        "observedStateRevision", "observedWorldFingerprint",
        "observedLogicalClock", "requestFingerprint", "outcome", "stage",
        "stateDisposition", "retryable", "errorCode", "errorType",
        "failureFingerprint"
      ],
      "properties": {
        "invocationSiteId": {
          "type": "string", "minLength": 1, "maxLength": 2048
        },
        "graphPath": {
          "type": "string", "pattern": "^/.*", "maxLength": 2048
        },
        "correlationKey": { "type": "string", "maxLength": 1024 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "capabilityRef": { "$ref": "#/$defs/capabilityRef" },
        "writeEffectRef": { "$ref": "#/$defs/writeEffectRef" },
        "observedStateRef": { "$ref": "#/$defs/sessionStateRef" },
        "observedStateRevision": { "type": "integer", "minimum": 0 },
        "observedWorldFingerprint": { "$ref": "#/$defs/fingerprint" },
        "observedLogicalClock": { "type": "string", "format": "date-time" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "outcome": {
          "enum": [
            "COMMITTED", "REPLAYED", "REJECTED", "PRE_COMMIT_FAILED",
            "COMMIT_OUTCOME_UNKNOWN"
          ]
        },
        "stage": {
          "enum": [
            "RESOLVER_ADMISSION", "COMMAND_ADMISSION", "COMMAND_EVALUATION",
            "COMMIT", "RESULT_VERIFICATION", "PROCESS_INTERRUPTION", "COMPLETED"
          ]
        },
        "stateDisposition": {
          "enum": ["ADVANCED", "UNCHANGED", "UNKNOWN"]
        },
        "retryable": { "type": "boolean" },
        "errorCode": { "type": "string", "maxLength": 192 },
        "errorType": { "type": "string", "maxLength": 128 },
        "failureFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "transition": {
          "$ref": "mirror-state-run-evidence-v2.schema.json#/$defs/stateTransition"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "COMMITTED" } } },
          "then": {
            "required": ["transition"],
            "properties": {
              "stage": { "const": "COMPLETED" },
              "stateDisposition": { "const": "ADVANCED" },
              "retryable": { "const": false },
              "errorCode": { "const": "" },
              "errorType": { "const": "" },
              "failureFingerprint": { "const": "" },
              "transition": {
                "allOf": [
                  {
                    "$ref": "mirror-state-run-evidence-v2.schema.json#/$defs/stateTransition"
                  },
                  { "properties": { "replayed": { "const": false } } }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "REPLAYED" } } },
          "then": {
            "required": ["transition"],
            "properties": {
              "stage": { "const": "COMPLETED" },
              "stateDisposition": { "const": "UNCHANGED" },
              "retryable": { "const": false },
              "errorCode": { "const": "" },
              "errorType": { "const": "" },
              "failureFingerprint": { "const": "" },
              "transition": {
                "allOf": [
                  {
                    "$ref": "mirror-state-run-evidence-v2.schema.json#/$defs/stateTransition"
                  },
                  { "properties": { "replayed": { "const": true } } }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "REJECTED" } } },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "RESOLVER_ADMISSION", "COMMAND_ADMISSION",
                  "COMMAND_EVALUATION"
                ]
              },
              "stateDisposition": { "const": "UNCHANGED" },
              "errorCode": { "type": "string", "minLength": 1, "maxLength": 192 },
              "errorType": { "type": "string", "minLength": 1, "maxLength": 128 },
              "failureFingerprint": { "$ref": "#/$defs/fingerprint" }
            },
            "not": { "required": ["transition"] }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "PRE_COMMIT_FAILED" } }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "COMMAND_ADMISSION", "COMMAND_EVALUATION", "COMMIT"
                ]
              },
              "stateDisposition": { "const": "UNCHANGED" },
              "errorCode": { "type": "string", "minLength": 1, "maxLength": 192 },
              "errorType": { "type": "string", "minLength": 1, "maxLength": 128 },
              "failureFingerprint": { "$ref": "#/$defs/fingerprint" }
            },
            "not": { "required": ["transition"] }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": { "const": "COMMIT_OUTCOME_UNKNOWN" }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": ["COMMIT", "RESULT_VERIFICATION", "PROCESS_INTERRUPTION"]
              },
              "stateDisposition": { "const": "UNKNOWN" },
              "errorCode": { "type": "string", "minLength": 1, "maxLength": 192 },
              "errorType": { "type": "string", "minLength": 1, "maxLength": 128 },
              "failureFingerprint": { "$ref": "#/$defs/fingerprint" }
            },
            "not": { "required": ["transition"] }
          }
        }
      ]
    }
  }
}
