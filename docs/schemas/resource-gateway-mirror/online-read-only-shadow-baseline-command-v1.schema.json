    "executionId",
    "requestId",
    "scope",
    "inventoryRef",
    "unitId",
    "scenarioCaseRef",
    "targetCapabilityRef",
    "baselineBindingRef",
    "comparisonPolicyRef",
    "accessGrant",
    "admissionFingerprint",
    "admittedAt",
    "deadlineAt"
