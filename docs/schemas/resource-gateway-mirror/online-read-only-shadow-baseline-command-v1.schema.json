{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/online-read-only-shadow-baseline-command-v1.schema.json",
  "title": "Resource Gateway Online Read-only Shadow Baseline Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
