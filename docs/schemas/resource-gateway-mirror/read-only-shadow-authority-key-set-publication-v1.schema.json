{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/read-only-shadow-authority-key-set-publication-v1.schema.json",
  "title": "Resource Gateway Read-Only Shadow Authority Key Set Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "publicationFingerprint", "materialFingerprint", "material", "signatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.readOnlyShadowAuthorityKeySetPublication.v1"
    },
    "publicationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
    "material": { "$ref": "#/$defs/material" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rootSignature" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "optionalIdentifier": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511})$"
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3})?(?:[0-9]{3})?)?Z$"
    },
    "canonicalBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "organizationId", "projectId", "environmentId", "region"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/optionalIdentifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/optionalIdentifier" }
      }
    },
    "authorityKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId", "algorithm", "encodedPublicKey", "notBefore", "notAfter", "retiredAt", "state"
      ],
      "properties": {
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "encodedPublicKey": { "$ref": "#/$defs/canonicalBase64" },
        "notBefore": { "$ref": "#/$defs/canonicalInstant" },
        "notAfter": { "$ref": "#/$defs/canonicalInstant" },
        "retiredAt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/canonicalInstant" }
          ]
        },
        "state": { "enum": ["ACTIVE", "RETIRED", "REVOKED"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "RETIRED" } },
            "required": ["state"]
          },
          "then": {
            "properties": { "retiredAt": { "$ref": "#/$defs/canonicalInstant" } }
          },
          "else": {
            "properties": { "retiredAt": { "type": "null" } }
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keySetId", "generation", "previousPublicationFingerprint", "scope",
        "publicationKind", "issuer", "rootTrustDomain", "rootThreshold",
        "policyFingerprint", "issuedAt", "notBefore", "expiresAt", "keys"
      ],
      "properties": {
        "keySetId": { "$ref": "#/$defs/identifier" },
        "generation": { "type": "integer", "minimum": 1 },
        "previousPublicationFingerprint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "scope": { "$ref": "#/$defs/scope" },
        "publicationKind": {
          "enum": ["GUARD_POLICY", "SAMPLING_GRANT", "KILL_SWITCH"]
        },
        "issuer": { "$ref": "#/$defs/identifier" },
        "rootTrustDomain": { "$ref": "#/$defs/identifier" },
        "rootThreshold": { "type": "integer", "minimum": 1, "maximum": 16 },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/canonicalInstant" },
        "notBefore": { "$ref": "#/$defs/canonicalInstant" },
        "expiresAt": { "$ref": "#/$defs/canonicalInstant" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityKey" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "generation": { "const": 1 } },
            "required": ["generation"]
          },
          "then": {
            "properties": { "previousPublicationFingerprint": { "const": "" } }
          },
          "else": {
            "properties": {
              "previousPublicationFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      ]
    },
    "rootSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "$ref": "#/$defs/canonicalInstant" },
        "signature": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
