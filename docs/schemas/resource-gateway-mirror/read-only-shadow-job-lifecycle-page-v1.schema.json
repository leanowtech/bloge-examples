{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/read-only-shadow-job-lifecycle-page-v1.schema.json",
  "title": "Resource Gateway Read-only Shadow Job Lifecycle Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "afterSequence",
    "nextSequence",
    "hasMore",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.readOnlyShadowJobLifecyclePage.v1"
    },
    "jobId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "afterSequence": {
      "type": "integer",
      "minimum": 0
    },
    "nextSequence": {
      "type": "integer",
      "minimum": 0
    },
    "hasMore": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "read-only-shadow-job-lifecycle-event-v1.schema.json"
      }
    }
  }
}
