{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/read-only-shadow-job-v1.schema.json",
  "title": "Resource Gateway Read-only Shadow Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "requestId",
    "requestFingerprint",
    "scope",
    "status",
    "attemptCount",
    "maximumAttempts",
    "nextEligibleAt",
    "deadlineAt",
    "leaseEpoch",
    "leaseExpiresAt",
    "comparisonRef",
    "failureCode",
    "createdAt",
    "updatedAt",
    "completedAt",
    "recordFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.readOnlyShadowJob.v1"
    },
    "jobId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "requestId": {
      "$ref": "read-only-shadow-comparison-v1.schema.json#/$defs/identifier"
    },
    "requestFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "maximumAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "nextEligibleAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "leaseEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "comparisonRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/comparisonRef"
        }
      ]
    },
    "failureCode": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(|[A-Z][A-Z0-9_.-]{0,254})$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "recordFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    }
  },
  "$defs": {
    "comparisonRef": {
      "allOf": [
        {
          "$ref": "domain-fidelity-inventory-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "FIDELITY_SHADOW_COMPARISON"
            }
          }
        }
      ]
    }
  }
}
