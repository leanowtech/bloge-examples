{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/read-only-shadow-sampling-grant-publication-v1.schema.json",
  "title": "Resource Gateway Read-Only Shadow Sampling Grant Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "publicationFingerprint", "materialFingerprint", "material", "seal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.readOnlyShadowSamplingGrantPublication.v1"
    },
    "publicationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
    "material": { "$ref": "#/$defs/material" },
    "seal": { "$ref": "#/$defs/seal" }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    },
    "optionalIdentifier": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511})$"
    },
    "canonicalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3})?(?:[0-9]{3})?)?Z$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId", "organizationId", "projectId", "environmentId", "region"
      ],
      "properties": {
        "tenantId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/optionalIdentifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/optionalIdentifier" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "const": "SHADOW_EXECUTION_GUARD_POLICY" },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId", "revision", "previousPublicationFingerprint", "scope", "active",
        "maximumSamples", "guardScope", "guardPolicyRef", "issuedAt", "validFrom",
        "expiresAt", "issuer"
      ],
      "properties": {
        "grantId": { "$ref": "#/$defs/identifier" },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "previousPublicationFingerprint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "scope": { "$ref": "#/$defs/scope" },
        "active": { "type": "boolean" },
        "maximumSamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "guardScope": { "$ref": "#/$defs/scope" },
        "guardPolicyRef": { "$ref": "#/$defs/artifactRef" },
        "issuedAt": { "$ref": "#/$defs/canonicalInstant" },
        "validFrom": { "$ref": "#/$defs/canonicalInstant" },
        "expiresAt": { "$ref": "#/$defs/canonicalInstant" },
        "issuer": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": { "const": 1 }
            },
            "required": ["revision"]
          },
          "then": {
            "properties": {
              "previousPublicationFingerprint": { "const": "" }
            }
          },
          "else": {
            "properties": {
              "previousPublicationFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      ]
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialFingerprint", "algorithm", "keyId", "signedAt", "signature"
      ],
      "properties": {
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "signedAt": { "$ref": "#/$defs/canonicalInstant" },
        "signature": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
