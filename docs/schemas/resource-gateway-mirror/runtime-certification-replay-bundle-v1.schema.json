{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/runtime-certification-replay-bundle-v1.schema.json",
  "title": "Resource Gateway Runtime Certification Replay Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "bundleFingerprint", "bundleId", "revision", "manifest",
    "authorization", "report", "regionalContract", "regionalCertification",
    "isolationDecision", "exportedAt", "exporter"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.runtimeCertificationReplayBundle.v1" },
    "bundleFingerprint": { "$ref": "#/$defs/fingerprint" },
    "bundleId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "manifest": { "$ref": "runtime-certification-manifest-v1.schema.json" },
    "authorization": {
      "$ref": "runtime-certification-execution-authorization-v1.schema.json"
    },
    "report": { "$ref": "runtime-certification-report-v1.schema.json" },
    "regionalContract": {
      "$ref": "regional-data-plane-deployment-contract-v1.schema.json"
    },
    "regionalCertification": {
      "$ref": "regional-data-plane-certification-v1.schema.json"
    },
    "isolationDecision": {
      "$ref": "mirror-deployment-isolation-attestation-bundle-v2.schema.json"
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "exporter": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,511}$"
    }
  }
}
