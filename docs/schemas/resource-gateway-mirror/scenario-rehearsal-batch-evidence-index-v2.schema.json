{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-batch-evidence-index-v2.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Batch Evidence Index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "indexFingerprint", "request", "manifest", "job", "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalBatchEvidenceIndex.v2"
    },
    "indexFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "request": {
      "$ref": "scenario-rehearsal-batch-request-v1.schema.json"
    },
    "manifest": {
      "$ref": "scenario-rehearsal-batch-manifest-v1.schema.json"
    },
    "job": {
      "$ref": "scenario-rehearsal-batch-job-v2.schema.json"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "scenario-rehearsal-batch-item-page-v1.schema.json#/$defs/item"
      }
    }
  }
}
