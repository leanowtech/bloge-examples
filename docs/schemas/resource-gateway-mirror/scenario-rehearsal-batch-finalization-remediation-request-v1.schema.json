{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-batch-finalization-remediation-request-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Batch Finalization Remediation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "commandId", "expectedAttemptCount",
    "expectedUpdatedAt", "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalBatchFinalizationRemediationRequest.v1"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "expectedAttemptCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "expectedUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    }
  }
}
