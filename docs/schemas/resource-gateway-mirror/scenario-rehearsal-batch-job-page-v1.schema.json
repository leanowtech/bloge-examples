{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-batch-job-page-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Batch Job Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "jobs",
    "nextCursor"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalBatchJobPage.v1"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "jobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "$ref": "scenario-rehearsal-batch-job-v1.schema.json"
          },
          {
            "$ref": "scenario-rehearsal-batch-job-v2.schema.json"
          }
        ]
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cursor"
        }
      ]
    }
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "jobId"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "jobId": {
          "type": "string",
          "pattern": "^scenario-batch-[a-f0-9]{64}$"
        }
      }
    }
  }
}
