{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-batch-job-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Batch Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "jobId", "requestId", "requestFingerprint",
    "manifestFingerprint", "scope", "status", "failureMode", "priority",
    "maximumItemAttempts", "summary", "deadlineAt", "failureCode",
    "cancellationRequestId", "cancellationReasonCode", "createdAt",
    "updatedAt", "completedAt", "recordFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalBatchJob.v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^scenario-batch-[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "requestFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "manifestFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "status": {
      "enum": [
        "QUEUED", "RUNNING", "CANCEL_REQUESTED", "SUCCEEDED", "PARTIAL",
        "FAILED", "CANCELLED", "EXPIRED", "QUARANTINED"
      ]
    },
    "failureMode": {
      "enum": ["FAIL_FAST", "COLLECT_ALL"]
    },
    "priority": {
      "enum": ["LOW", "NORMAL", "HIGH"]
    },
    "maximumItemAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "failureCode": {
      "$ref": "#/$defs/optionalCode"
    },
    "cancellationRequestId": {
      "$ref": "#/$defs/optionalIdentifier"
    },
    "cancellationReasonCode": {
      "$ref": "#/$defs/optionalCode"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "recordFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    }
  },
  "$defs": {
    "optionalIdentifier": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"
    },
    "optionalCode": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^$|^[A-Z][A-Z0-9_.-]{0,254}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalItems", "completedItems", "passedItems", "failedItems",
        "indeterminateItems", "cancelledItems"
      ],
      "properties": {
        "totalItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "completedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "passedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "failedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "indeterminateItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "cancelledItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    }
  }
}
