{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-batch-request-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Batch Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalBatchRequest.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "compiledPlanRef": {
      "allOf": [
        {
          "$ref": "scenario-pack-v1.schema.json#/$defs/artifactRefByKind"
        },
        {
          "properties": {
            "kind": {
              "const": "COMPILED_REHEARSAL_PLAN"
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "compiledPlanRef"],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "compiledPlanRef": {
          "$ref": "#/$defs/compiledPlanRef"
        }
      }
    }
  }
}
