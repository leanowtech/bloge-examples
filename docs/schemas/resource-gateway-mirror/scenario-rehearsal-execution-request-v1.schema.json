{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-execution-request-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Execution Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "compiledPlanRef"],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalExecutionRequest.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "compiledPlanRef": {
      "$ref": "#/$defs/compiledPlanRef"
    }
  },
  "$defs": {
    "compiledPlanRef": {
      "allOf": [
        {
          "$ref": "scenario-pack-v1.schema.json#/$defs/artifactRefByKind"
        },
        {
          "properties": {
            "kind": {
              "const": "COMPILED_REHEARSAL_PLAN"
            }
          }
        }
      ]
    }
  }
}
