{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-remediation-approval-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Remediation Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalFingerprint",
    "sourceCommandFingerprint",
    "scope",
    "remediationId",
    "remediationPlanFingerprint",
    "generation",
    "previousApprovalFingerprint",
    "role",
    "decision",
    "governanceTicketRef",
    "reasonCode",
    "actorId",
    "delegatedBy",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalRemediationApproval.v1"
    },
    "approvalFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "sourceCommandFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "remediationId": {
      "$ref": "scenario-rehearsal-remediation-plan-v1.schema.json#/$defs/remediationId"
    },
    "remediationPlanFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "previousApprovalFingerprint": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        }
      ]
    },
    "role": {
      "enum": ["OWNER", "INDEPENDENT_REVIEWER"]
    },
    "decision": {
      "enum": ["APPROVE", "REJECT"]
    },
    "governanceTicketRef": {
      "$ref": "scenario-rehearsal-remediation-preview-request-v1.schema.json#/$defs/governanceTicketRef"
    },
    "reasonCode": {
      "enum": [
        "APPROVED_AS_REVIEWED",
        "REJECTED_REQUIRES_CHANGES",
        "REJECTED_POLICY_CONFLICT",
        "REJECTED_INSUFFICIENT_EVIDENCE"
      ]
    },
    "actorId": {
      "$ref": "#/$defs/actor"
    },
    "delegatedBy": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/actor"
        }
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "const": 1
          }
        },
        "required": ["generation"]
      },
      "then": {
        "properties": {
          "previousApprovalFingerprint": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "previousApprovalFingerprint": {
            "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVE"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "APPROVED_AS_REVIEWED"
          }
        }
      },
      "else": {
        "properties": {
          "reasonCode": {
            "enum": [
              "REJECTED_REQUIRES_CHANGES",
              "REJECTED_POLICY_CONFLICT",
              "REJECTED_INSUFFICIENT_EVIDENCE"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/#-]{0,254}$"
    }
  }
}
