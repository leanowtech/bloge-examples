{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-remediation-comparison-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Remediation Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "comparisonFingerprint", "scope", "remediationId",
    "lineageFingerprint", "remediationPlanFingerprint", "receiptFingerprint",
    "predecessor", "successor", "gateTransition", "resolvedBlockers",
    "remainingBlockers", "introducedBlockers", "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalRemediationComparison.v1"
    },
    "comparisonFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "remediationId": {
      "type": "string",
      "pattern": "^scenario-remediation-[a-f0-9]{64}$"
    },
    "lineageFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "remediationPlanFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "receiptFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "predecessor": {
      "allOf": [
        {"$ref": "#/$defs/workbookSnapshot"},
        {
          "properties": {
            "gateReady": {"const": false},
            "blockers": {"minItems": 1}
          }
        }
      ]
    },
    "successor": {
      "$ref": "#/$defs/workbookSnapshot"
    },
    "gateTransition": {
      "enum": ["RESOLVED", "STILL_BLOCKED"]
    },
    "resolvedBlockers": {
      "$ref": "#/$defs/blockers"
    },
    "remainingBlockers": {
      "$ref": "#/$defs/blockers"
    },
    "introducedBlockers": {
      "$ref": "#/$defs/blockers"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entryComparison"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "successor": {
            "properties": {
              "gateReady": {"const": true}
            },
            "required": ["gateReady"]
          }
        },
        "required": ["successor"]
      },
      "then": {
        "properties": {
          "gateTransition": {"const": "RESOLVED"},
          "remainingBlockers": {"maxItems": 0},
          "introducedBlockers": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "gateTransition": {"const": "STILL_BLOCKED"},
          "successor": {
            "properties": {
              "blockers": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "machineCode": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Z][A-Z0-9_.-]{0,254}$"
    },
    "optionalMachineCode": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:|[A-Z][A-Z0-9_.-]{0,254})$"
    },
    "optionalFingerprint": {
      "type": "string",
      "pattern": "^(?:|sha256:[a-f0-9]{64})$"
    },
    "blockers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/machineCode"
      }
    },
    "correctnessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceBackedEntries", "totalCases", "passedCases", "failedCases",
        "indeterminateCases", "assertionResults", "blockerFailures",
        "blockerIndeterminate", "warningFailures", "warningIndeterminate"
      ],
      "properties": {
        "evidenceBackedEntries": {"type": "integer", "minimum": 0, "maximum": 256},
        "totalCases": {"type": "integer", "minimum": 0, "maximum": 10000},
        "passedCases": {"type": "integer", "minimum": 0, "maximum": 10000},
        "failedCases": {"type": "integer", "minimum": 0, "maximum": 10000},
        "indeterminateCases": {"type": "integer", "minimum": 0, "maximum": 10000},
        "assertionResults": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "blockerFailures": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "blockerIndeterminate": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "warningFailures": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "warningIndeterminate": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "workbookSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbookSchemaVersion", "scope", "jobId", "seedFingerprint",
        "requestFingerprint", "manifestFingerprint", "evidenceBundleFingerprint",
        "evidenceIndexFingerprint", "workbookSeal", "status", "summary",
        "correctnessSummary", "gateReady", "blockers"
      ],
      "properties": {
        "workbookSchemaVersion": {
          "const": "resourceGateway.scenarioRehearsalBatchWorkbookSeed.v1"
        },
        "scope": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
        },
        "jobId": {
          "type": "string",
          "pattern": "^scenario-batch-[a-f0-9]{64}$"
        },
        "seedFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "requestFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "manifestFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "evidenceBundleFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "evidenceIndexFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "workbookSeal": {
          "allOf": [
            {
              "$ref": "scenario-rehearsal-batch-retention-event-v1.schema.json#/$defs/evidenceSeal"
            },
            {
              "properties": {
                "materialFingerprint": {
                  "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
                },
                "algorithm": {"const": "Ed25519"}
              }
            }
          ]
        },
        "status": {
          "enum": [
            "SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED", "EXPIRED", "QUARANTINED"
          ]
        },
        "summary": {
          "$ref": "scenario-rehearsal-batch-job-v2.schema.json#/$defs/summary"
        },
        "correctnessSummary": {
          "$ref": "#/$defs/correctnessSummary"
        },
        "gateReady": {
          "type": "boolean"
        },
        "blockers": {
          "$ref": "#/$defs/blockers"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gateReady": {"const": true}
            },
            "required": ["gateReady"]
          },
          "then": {
            "properties": {
              "status": {"const": "SUCCEEDED"},
              "blockers": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "blockers": {"minItems": 1}
            }
          }
        }
      ]
    },
    "entrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiledPlanRef", "status", "failureCode", "runId",
        "childEvidenceBundleFingerprint", "childWorkbookSeedFingerprint",
        "scenarioPackRef", "targetCapabilityRef", "outcome", "summary",
        "gateReady", "blockers"
      ],
      "properties": {
        "compiledPlanRef": {
          "$ref": "scenario-rehearsal-execution-request-v1.schema.json#/$defs/compiledPlanRef"
        },
        "status": {
          "enum": ["PASSED", "FAILED", "INDETERMINATE", "CANCELLED"]
        },
        "failureCode": {
          "$ref": "#/$defs/optionalMachineCode"
        },
        "runId": {
          "type": "string",
          "pattern": "^(?:|scenario-[a-f0-9]{64})$"
        },
        "childEvidenceBundleFingerprint": {
          "$ref": "#/$defs/optionalFingerprint"
        },
        "childWorkbookSeedFingerprint": {
          "$ref": "#/$defs/optionalFingerprint"
        },
        "scenarioPackRef": {
          "oneOf": [
            {"type": "null"},
            {
              "$ref": "compiled-scenario-rehearsal-plan-v1.schema.json#/$defs/scenarioPackRef"
            }
          ]
        },
        "targetCapabilityRef": {
          "oneOf": [
            {"type": "null"},
            {
              "$ref": "scenario-pack-v1.schema.json#/$defs/capabilityRef"
            }
          ]
        },
        "outcome": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["PASS", "FAIL", "INDETERMINATE"]}
          ]
        },
        "summary": {
          "oneOf": [
            {"type": "null"},
            {
              "$ref": "scenario-rehearsal-result-v1.schema.json#/$defs/summary"
            }
          ]
        },
        "gateReady": {
          "type": "boolean"
        },
        "blockers": {
          "$ref": "#/$defs/blockers"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runId": {"const": ""}
            },
            "required": ["runId"]
          },
          "then": {
            "properties": {
              "childEvidenceBundleFingerprint": {"const": ""},
              "childWorkbookSeedFingerprint": {"const": ""},
              "scenarioPackRef": {"type": "null"},
              "targetCapabilityRef": {"type": "null"},
              "outcome": {"type": "null"},
              "summary": {"type": "null"},
              "gateReady": {"const": false}
            }
          },
          "else": {
            "properties": {
              "childEvidenceBundleFingerprint": {
                "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
              },
              "childWorkbookSeedFingerprint": {
                "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
              },
              "scenarioPackRef": {
                "$ref": "compiled-scenario-rehearsal-plan-v1.schema.json#/$defs/scenarioPackRef"
              },
              "targetCapabilityRef": {
                "$ref": "scenario-pack-v1.schema.json#/$defs/capabilityRef"
              },
              "outcome": {
                "enum": ["PASS", "FAIL", "INDETERMINATE"]
              },
              "summary": {
                "$ref": "scenario-rehearsal-result-v1.schema.json#/$defs/summary"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gateReady": {"const": true}
            },
            "required": ["gateReady"]
          },
          "then": {
            "properties": {
              "status": {"const": "PASSED"},
              "outcome": {"const": "PASS"},
              "blockers": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "blockers": {"minItems": 1}
            }
          }
        }
      ]
    },
    "entryComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryIndex", "entryId", "planChanged", "gateTransition",
        "resolvedBlockers", "remainingBlockers", "introducedBlockers",
        "predecessor", "successor"
      ],
      "properties": {
        "entryIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "entryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "planChanged": {
          "type": "boolean"
        },
        "gateTransition": {
          "enum": ["RESOLVED", "STILL_BLOCKED", "REGRESSED", "STILL_READY"]
        },
        "resolvedBlockers": {
          "$ref": "#/$defs/blockers"
        },
        "remainingBlockers": {
          "$ref": "#/$defs/blockers"
        },
        "introducedBlockers": {
          "$ref": "#/$defs/blockers"
        },
        "predecessor": {
          "$ref": "#/$defs/entrySnapshot"
        },
        "successor": {
          "$ref": "#/$defs/entrySnapshot"
        }
      }
    }
  }
}
