{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/scenario-rehearsal-retention-event-v1.schema.json",
  "title": "Resource Gateway Scenario Rehearsal Retention Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventId", "commandId", "scope", "requestId", "runId",
    "revision", "type", "retainUntil", "occurredAt", "actorId", "reasonCode",
    "holdId", "evidenceBundleFingerprint", "previousEventFingerprint",
    "deletedCaseProgressCount", "childEvidenceDisposition", "evidenceSeal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "resourceGateway.scenarioRehearsalRetentionEvent.v1"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/scope"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runId": {
      "type": "string",
      "pattern": "^scenario-[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "RETENTION_REGISTERED", "HOLD_PLACED", "HOLD_RELEASED", "PURGED"
      ]
    },
    "retainUntil": {
      "type": "string",
      "format": "date-time"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^RG\\.MIRROR\\.[A-Z0-9_.-]{1,224}$"
    },
    "holdId": {
      "type": "string",
      "maxLength": 256
    },
    "evidenceBundleFingerprint": {
      "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
    },
    "previousEventFingerprint": {
      "oneOf": [
        {"const": ""},
        {"$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"}
      ]
    },
    "deletedCaseProgressCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "childEvidenceDisposition": {
      "enum": ["NOT_APPLICABLE", "RETAINED"]
    },
    "evidenceSeal": {
      "$ref": "#/$defs/evidenceSeal"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"revision": {"const": 1}},
        "required": ["revision"]
      },
      "then": {
        "properties": {"previousEventFingerprint": {"const": ""}}
      },
      "else": {
        "properties": {
          "previousEventFingerprint": {
            "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {"enum": ["HOLD_PLACED", "HOLD_RELEASED"]}
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "holdId": {"type": "string", "minLength": 1, "maxLength": 256},
          "deletedCaseProgressCount": {"const": 0},
          "childEvidenceDisposition": {"const": "NOT_APPLICABLE"}
        }
      },
      "else": {
        "properties": {"holdId": {"const": ""}}
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "PURGED"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "childEvidenceDisposition": {"const": "RETAINED"}
        }
      },
      "else": {
        "properties": {
          "deletedCaseProgressCount": {"const": 0},
          "childEvidenceDisposition": {"const": "NOT_APPLICABLE"}
        }
      }
    }
  ],
  "$defs": {
    "evidenceSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "materialFingerprint", "algorithm",
        "keyId", "signedAt", "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.visualRunEvidenceSeal.v1"
        },
        "materialFingerprint": {
          "$ref": "mirror-plan-v1.schema.json#/$defs/fingerprint"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
