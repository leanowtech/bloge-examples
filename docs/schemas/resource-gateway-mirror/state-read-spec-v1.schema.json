{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/state-read-spec-v1.schema.json",
  "title": "Resource Gateway State Read Spec v1",
  "description": "Content-addressed lowering from one exact external read capability to one session-state business-key lookup and bounded response projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specId",
    "revision",
    "fingerprint",
    "scope",
    "targetCapabilityRef",
    "stateModelRef",
    "entityType",
    "businessKeyName",
    "keyComponents",
    "responseProjection",
    "provenance",
    "lifecycle",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.stateReadSpec.v1" },
    "specId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "scope": {
      "$ref": "capability-snapshot-v1.schema.json#/$defs/scope"
    },
    "targetCapabilityRef": {
      "$ref": "write-effect-spec-v1.schema.json#/$defs/capabilityRef"
    },
    "stateModelRef": {
      "$ref": "write-effect-spec-v1.schema.json#/$defs/stateModelRef"
    },
    "entityType": { "$ref": "#/$defs/identifier" },
    "businessKeyName": { "$ref": "#/$defs/identifier" },
    "keyComponents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "bounded-state-expression-v1.schema.json" }
    },
    "responseProjection": {
      "$ref": "bounded-state-expression-v1.schema.json"
    },
    "provenance": {
      "$ref": "artifact-provenance-v1.schema.json"
    },
    "lifecycle": {
      "enum": ["DRAFT", "REVIEWED", "ACTIVE", "DEPRECATED", "STALE", "REVOKED"]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{0,511}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
