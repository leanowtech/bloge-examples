{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-mirror/write-effect-spec-v1.schema.json",
  "title": "Resource Gateway Write Effect Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specId",
    "revision",
    "fingerprint",
    "scope",
    "targetCapabilityRef",
    "stateModelRef",
    "mutations",
    "responseProjection",
    "idempotency",
    "provenance",
    "lifecycle",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.writeEffectSpec.v1" },
    "specId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "scope": {
      "$ref": "capability-snapshot-v1.schema.json#/$defs/scope"
    },
    "targetCapabilityRef": {
      "$ref": "#/$defs/capabilityRef"
    },
    "stateModelRef": {
      "$ref": "#/$defs/stateModelRef"
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/mutation" }
    },
    "responseProjection": {
      "$ref": "bounded-state-expression-v1.schema.json"
    },
    "idempotency": { "$ref": "#/$defs/idempotency" },
    "provenance": { "$ref": "artifact-provenance-v1.schema.json" },
    "lifecycle": {
      "enum": ["DRAFT", "REVIEWED", "ACTIVE", "DEPRECATED", "STALE", "REVOKED"]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "type": "object",
          "properties": { "kind": { "const": "CAPABILITY" } }
        }
      ]
    },
    "stateModelRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "type": "object",
          "properties": { "kind": { "const": "STATE_MODEL" } }
        }
      ]
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutationId",
        "operation",
        "entityType",
        "identity",
        "baselineReadCapabilityRef",
        "preconditions",
        "fieldEffects",
        "businessKeys"
      ],
      "properties": {
        "mutationId": { "$ref": "#/$defs/identifier" },
        "operation": { "enum": ["CREATE", "UPDATE", "DELETE", "UPSERT"] },
        "entityType": { "$ref": "#/$defs/identifier" },
        "identity": { "$ref": "bounded-state-expression-v1.schema.json" },
        "baselineReadCapabilityRef": {
          "oneOf": [
            { "$ref": "#/$defs/capabilityRef" },
            { "type": "null" }
          ]
        },
        "preconditions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/precondition" }
        },
        "fieldEffects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/fieldEffect" }
        },
        "businessKeys": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/businessKeyRule" }
        }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditionId", "predicate", "errorCode"],
      "properties": {
        "preconditionId": { "$ref": "#/$defs/identifier" },
        "predicate": { "$ref": "bounded-state-expression-v1.schema.json" },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Z][A-Z0-9_.-]{0,191}$"
        }
      }
    },
    "fieldEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2048,
          "pattern": "^/.*[^/]$"
        },
        "value": { "$ref": "bounded-state-expression-v1.schema.json" }
      }
    },
    "businessKeyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "components"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "bounded-state-expression-v1.schema.json" }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyPath", "replayReturnsOriginal"],
      "properties": {
        "keyPath": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2048,
          "pattern": "^/.*[^/]$"
        },
        "replayReturnsOriginal": { "const": true }
      }
    }
  }
}
