{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/control-plane-certificate-rotation-event-source-configuration-v1.schema.json",
  "title": "Resource Gateway Certificate Rotation Event Source Configuration v1",
  "description": "Strict test/staging configuration for fingerprint-chained event delivery through a durable serving-slot cursor. The source transport is independently governed private PKIX, SPKI-pinned mutual TLS with exact workload identities; event authorization remains the separate signed rotation trust domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled", "required", "endpoint-uri", "baseline-sequence",
    "baseline-page-fingerprint", "poll-interval-seconds", "maximum-pages-per-poll",
    "request-timeout-millis", "maximum-page-bytes", "clock-skew-seconds",
    "maximum-page-lifetime-seconds", "allow-insecure-loopback", "transport"
  ],
  "properties": {
    "enabled": { "type": "boolean" },
    "required": { "type": "boolean" },
    "endpoint-uri": {
      "type": "string",
      "maxLength": 2048,
      "description": "HTTPS source endpoint without user info, query, or fragment. HTTP loopback requires the explicit test-only escape."
    },
    "baseline-sequence": { "type": "integer", "minimum": 0 },
    "baseline-page-fingerprint": { "$ref": "#/$defs/optionalFingerprint" },
    "poll-interval-seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "maximum-pages-per-poll": { "type": "integer", "minimum": 1, "maximum": 32 },
    "request-timeout-millis": { "type": "integer", "minimum": 100, "maximum": 30000 },
    "maximum-page-bytes": { "type": "integer", "minimum": 1024, "maximum": 524288 },
    "clock-skew-seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "maximum-page-lifetime-seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "allow-insecure-loopback": {
      "type": "boolean",
      "description": "Test-only loopback protocol escape; staging must remain false."
    },
    "transport": { "$ref": "#/$defs/transport" }
  },
  "$defs": {
    "optionalFingerprint": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "fingerprints": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(,sha256:[a-f0-9]{64}){0,15}$",
      "maxLength": 1151
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "required", "trust-store-path", "trust-store-password-ref",
        "client-key-store-path", "client-key-store-password-ref", "server-spki-pins",
        "certificate-identity-required", "expected-client-subject-dn",
        "expected-client-uri-san", "client-issuer-spki-pins",
        "expected-server-uri-san", "server-issuer-spki-pins"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "trust-store-path": { "type": "string", "maxLength": 4096 },
        "trust-store-password-ref": { "type": "string", "maxLength": 255 },
        "client-key-store-path": { "type": "string", "maxLength": 4096 },
        "client-key-store-password-ref": { "type": "string", "maxLength": 255 },
        "server-spki-pins": { "type": "string", "maxLength": 1151 },
        "certificate-identity-required": { "type": "boolean" },
        "expected-client-subject-dn": { "type": "string", "maxLength": 1024 },
        "expected-client-uri-san": { "type": "string", "maxLength": 2048 },
        "client-issuer-spki-pins": { "type": "string", "maxLength": 1151 },
        "expected-server-uri-san": { "type": "string", "maxLength": 2048 },
        "server-issuer-spki-pins": { "type": "string", "maxLength": 1151 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "required": { "const": true },
              "trust-store-path": { "minLength": 1 },
              "trust-store-password-ref": { "minLength": 1 },
              "client-key-store-path": { "minLength": 1 },
              "client-key-store-password-ref": { "minLength": 1 },
              "server-spki-pins": { "$ref": "#/$defs/fingerprints" },
              "certificate-identity-required": { "const": true },
              "expected-client-subject-dn": { "minLength": 1 },
              "expected-client-uri-san": { "minLength": 4 },
              "client-issuer-spki-pins": { "$ref": "#/$defs/fingerprints" },
              "expected-server-uri-san": { "minLength": 4 },
              "server-issuer-spki-pins": { "$ref": "#/$defs/fingerprints" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
      "then": { "properties": { "enabled": { "const": true } } }
    },
    {
      "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "required": { "const": false },
          "endpoint-uri": { "const": "" },
          "baseline-sequence": { "const": 0 },
          "baseline-page-fingerprint": { "const": "" },
          "poll-interval-seconds": { "const": 5 },
          "maximum-pages-per-poll": { "const": 4 },
          "request-timeout-millis": { "const": 3000 },
          "maximum-page-bytes": { "const": 262144 },
          "clock-skew-seconds": { "const": 30 },
          "maximum-page-lifetime-seconds": { "const": 300 },
          "allow-insecure-loopback": { "const": false },
          "transport": {
            "allOf": [
              { "$ref": "#/$defs/transport" },
              {
                "properties": {
                  "enabled": { "const": false },
                  "required": { "const": false },
                  "trust-store-path": { "const": "" },
                  "trust-store-password-ref": { "const": "" },
                  "client-key-store-path": { "const": "" },
                  "client-key-store-password-ref": { "const": "" },
                  "server-spki-pins": { "const": "" },
                  "certificate-identity-required": { "const": false },
                  "expected-client-subject-dn": { "const": "" },
                  "expected-client-uri-san": { "const": "" },
                  "client-issuer-spki-pins": { "const": "" },
                  "expected-server-uri-san": { "const": "" },
                  "server-issuer-spki-pins": { "const": "" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "endpoint-uri": { "minLength": 1 },
          "baseline-page-fingerprint": { "pattern": "^sha256:[a-f0-9]{64}$" },
          "transport": {
            "allOf": [
              { "$ref": "#/$defs/transport" },
              { "properties": { "enabled": { "const": true }, "required": { "const": true } } }
            ]
          }
        }
      }
    }
  ]
}
