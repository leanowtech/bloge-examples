{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/control-plane-certificate-rotation-event-v1.schema.json",
  "title": "Resource Gateway Control-Plane Certificate Rotation Event v1",
  "description": "Strict signed command for one deployment- and target-bound TLS generation successor.",
  "$ref": "#/$defs/event",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "materialId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "material", "materialFingerprint", "signatures"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.controlPlaneCertificateRotationEvent.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "trustDomain", "eventId", "deploymentScopeId",
        "targetId", "generation", "previousMaterialFingerprint", "materialId",
        "settingsFingerprint", "policyFingerprint", "issuedAt", "notBefore",
        "activateAt", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.controlPlaneCertificateRotationEventMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "eventId": { "$ref": "#/$defs/identifier" },
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "generation": { "type": "integer", "minimum": 2 },
        "previousMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "materialId": { "$ref": "#/$defs/materialId" },
        "settingsFingerprint": { "$ref": "#/$defs/fingerprint" },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "activateAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
