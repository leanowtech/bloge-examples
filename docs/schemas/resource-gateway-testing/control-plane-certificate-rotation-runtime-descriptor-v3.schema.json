{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/control-plane-certificate-rotation-runtime-descriptor-v3.schema.json",
  "title": "Resource Gateway Certificate Rotation Runtime Descriptor v3",
  "description": "Fixed-cardinality product projection separating local rotation, replica convergence, certificate-status admission, serving readiness and still-unmet enterprise PKI readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "enabled", "ready", "trustAvailable", "durableState",
    "inventoriedTargetCount", "registeredTargetCount", "synchronizedState",
    "convergenceIntegrated", "convergenceAvailable", "replicaConvergenceProven",
    "servingReady", "certificateStatusIntegrated", "certificateStatusAvailable",
    "certificateStatusFresh", "productionReady", "convergenceStatus",
    "certificateStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.controlPlaneCertificateRotationRuntimeDescriptor.v3"
    },
    "enabled": { "type": "boolean" },
    "ready": { "type": "boolean" },
    "trustAvailable": { "type": "boolean" },
    "durableState": { "type": "boolean" },
    "inventoriedTargetCount": { "type": "integer", "minimum": 0, "maximum": 12 },
    "registeredTargetCount": { "type": "integer", "minimum": 0, "maximum": 12 },
    "synchronizedState": { "type": "boolean" },
    "convergenceIntegrated": { "type": "boolean" },
    "convergenceAvailable": { "type": "boolean" },
    "replicaConvergenceProven": { "type": "boolean" },
    "servingReady": { "type": "boolean" },
    "certificateStatusIntegrated": { "type": "boolean" },
    "certificateStatusAvailable": {
      "type": "boolean",
      "description": "Whether the latest bounded status-source interaction and durable floor are available. A fresh cache can remain true during a transient source outage."
    },
    "certificateStatusFresh": {
      "type": "boolean",
      "description": "Whether the immutable local status snapshot remains inside both signed wall-clock and monotonic deadlines."
    },
    "productionReady": {
      "const": false,
      "description": "Remains false until enterprise CA integration, custody, event distribution, HA/DR and operational gates are independently proven."
    },
    "convergenceStatus": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "certificateStatus": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    }
  }
}
