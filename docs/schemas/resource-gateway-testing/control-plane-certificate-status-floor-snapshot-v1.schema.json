{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-testing/control-plane-certificate-status-floor-snapshot-v1.schema.json",
  "title": "Control-plane certificate status floor snapshot v1",
  "description": "Strict durable cursor and complete normalized certificate-status head. An empty target list represents only the deployment-pinned baseline before the first accepted publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "deploymentScopeId", "baselineSequence",
    "baselinePublicationFingerprint", "sequence", "publicationId",
    "publicationFingerprint", "issuedAt", "expiresAt", "observedAt", "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bloge.controlPlaneCertificateStatusFloorSnapshot.v1"
    },
    "deploymentScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "baselineSequence": {
      "type": "integer",
      "minimum": 0
    },
    "baselinePublicationFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "publicationId": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "publicationFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issuedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "expiresAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "observedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "targets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "control-plane-certificate-status-publication-v1.schema.json#/$defs/targetStatus"
      }
    }
  }
}
