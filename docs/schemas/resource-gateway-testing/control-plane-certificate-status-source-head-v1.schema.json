{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/resource-gateway-testing/control-plane-certificate-status-source-head-v1.schema.json",
  "title": "Control-plane certificate status exact source head v1",
  "description": "Strict payload-free M-of-N signed statement of the exact normalized certificate-status publication-log head.",
  "$ref": "#/$defs/sourceHead",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "$ref": "#/$defs/instant" },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "trustDomain", "attestationId", "deploymentScopeId",
        "headSequence", "headPublicationFingerprint", "policyFingerprint",
        "issuedAt", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.controlPlaneCertificateStatusSourceHeadMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "attestationId": { "$ref": "#/$defs/identifier" },
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "headSequence": { "type": "integer", "minimum": 0 },
        "headPublicationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" }
      }
    },
    "sourceHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.controlPlaneCertificateStatusSourceHead.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    }
  }
}
