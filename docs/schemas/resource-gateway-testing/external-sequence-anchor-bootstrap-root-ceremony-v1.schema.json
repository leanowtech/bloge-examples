{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/external-sequence-anchor-bootstrap-root-ceremony-v1.schema.json",
  "title": "Resource Gateway External Sequence Anchor Bootstrap Root Ceremony v1",
  "$ref": "#/$defs/ceremonyOutcome",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "wholeSecondInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "role": {
      "type": "string",
      "enum": ["AUTHORIZING_ROOT", "INCOMING_ROOT"]
    },
    "signerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "authorityId", "keyId", "algorithm", "publicKeyBase64"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootSignerDescriptor.v1"
        },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 60,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "signatureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "ceremonyId", "role", "rootSetId",
        "sequence", "authorityId", "keyId", "materialFingerprint", "issuedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootSignRequest.v1"
        },
        "requestId": { "$ref": "#/$defs/fingerprint" },
        "ceremonyId": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/role" },
        "rootSetId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" }
      }
    },
    "signatureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "authorityId", "keyId", "algorithm",
        "materialFingerprint", "signedAt", "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootSignResponse.v1"
        },
        "requestId": { "$ref": "#/$defs/fingerprint" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "rotationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "ceremonyId", "expectedPreviousMaterialFingerprint",
        "incomingRootKeys", "policyFingerprint", "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootCeremonyRequest.v1"
        },
        "ceremonyId": { "$ref": "#/$defs/identifier" },
        "expectedPreviousMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "incomingRootKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "external-sequence-anchor-bootstrap-root-bundle-v1.schema.json#/$defs/rootKeyMaterial"
          }
        },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "notBefore": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" }
      }
    },
    "signingAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "authorityId", "keyId", "status"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "status": {
          "type": "string",
          "enum": ["SIGNED", "UNAVAILABLE", "INVALID_RESPONSE", "INVALID_SIGNATURE"]
        }
      }
    },
    "ceremonyOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ceremonyId", "bundle", "signingAttempts"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootCeremonyOutcome.v1"
        },
        "ceremonyId": { "$ref": "#/$defs/identifier" },
        "bundle": {
          "$ref": "external-sequence-anchor-bootstrap-root-bundle-v1.schema.json#/$defs/bundle"
        },
        "signingAttempts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signingAttempt" }
        }
      }
    }
  }
}
