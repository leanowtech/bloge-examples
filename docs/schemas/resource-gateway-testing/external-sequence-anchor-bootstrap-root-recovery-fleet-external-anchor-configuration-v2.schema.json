{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/external-sequence-anchor-bootstrap-root-recovery-fleet-external-anchor-configuration-v2.schema.json",
  "title": "Resource Gateway Recovery Fleet External Anchor Configuration v2",
  "description": "Public-only challenge-bound notary quorum, managed receipt trust, complete bootstrap-root chain, and identity-bound transport configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "required", "transport", "managed-trust"],
  "properties": {
    "enabled": { "type": "boolean" },
    "required": { "type": "boolean" },
    "trust-domain": { "$ref": "#/$defs/optionalIdentifier" },
    "anchor-set-id": { "$ref": "#/$defs/optionalIdentifier" },
    "signature-threshold": { "type": "integer", "minimum": 0, "maximum": 32 },
    "maximum-faults": { "type": "integer", "minimum": 0, "maximum": 10 },
    "minimum-faults": { "type": "integer", "minimum": 0, "maximum": 10 },
    "authority-keys-json": { "$ref": "#/$defs/keyArrayJson" },
    "endpoints-json": { "$ref": "#/$defs/endpointArrayJson" },
    "request-timeout-millis": { "type": "integer", "minimum": 100, "maximum": 30000 },
    "clock-skew-seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "maximum-receipt-lifetime-seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "allow-insecure-loopback": { "type": "boolean" },
    "transport": { "$ref": "#/$defs/publicationTransport" },
    "managed-trust": { "$ref": "#/$defs/managedTrust" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "optionalIdentifier": {
      "type": "string",
      "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254})$"
    },
    "fingerprintList": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(,sha256:[a-f0-9]{64}){0,31}$"
    },
    "keyArrayJson": {
      "type": "string",
      "description": "Strict JSON array string containing only public Ed25519 authority keys.",
      "pattern": "^\\s*\\[.*\\]\\s*$",
      "maxLength": 524288
    },
    "endpointArrayJson": {
      "type": "string",
      "description": "Strict JSON array string containing independent public notary endpoints and failure domains.",
      "pattern": "^\\s*\\[.*\\]\\s*$",
      "maxLength": 524288
    },
    "sourceUri": {
      "type": "string",
      "pattern": "^(https://[^?#]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?/[^?#]*)$",
      "maxLength": 2048
    },
    "secretReference": {
      "type": "string",
      "pattern": "^(|[a-z][a-z0-9+.-]{1,31}:[^#\\s]{1,480})$",
      "maxLength": 512
    },
    "publicationTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "required", "trust-store-path", "trust-store-password-ref",
        "client-key-store-path", "client-key-store-password-ref", "server-spki-pins",
        "certificate-identity-required", "expected-client-subject-dn",
        "expected-client-uri-san", "client-issuer-spki-pins",
        "expected-server-uri-san", "server-issuer-spki-pins"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "trust-store-path": { "type": "string", "pattern": "^(|/.*)$", "maxLength": 4096 },
        "trust-store-password-ref": { "$ref": "#/$defs/secretReference" },
        "client-key-store-path": { "type": "string", "pattern": "^(|/.*)$", "maxLength": 4096 },
        "client-key-store-password-ref": { "$ref": "#/$defs/secretReference" },
        "server-spki-pins": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64}(,sha256:[a-f0-9]{64}){0,15})$",
          "maxLength": 1151
        },
        "certificate-identity-required": { "type": "boolean" },
        "expected-client-subject-dn": { "type": "string", "maxLength": 2048 },
        "expected-client-uri-san": { "$ref": "#/$defs/workloadUri" },
        "client-issuer-spki-pins": { "$ref": "#/$defs/optionalPinList" },
        "expected-server-uri-san": { "$ref": "#/$defs/workloadUri" },
        "server-issuer-spki-pins": { "$ref": "#/$defs/optionalPinList" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": { "properties": { "enabled": { "const": true } } }
        },
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "required": { "const": false },
              "trust-store-path": { "const": "" },
              "trust-store-password-ref": { "const": "" },
              "client-key-store-path": { "const": "" },
              "client-key-store-password-ref": { "const": "" },
              "server-spki-pins": { "const": "" },
              "certificate-identity-required": { "const": false },
              "expected-client-subject-dn": { "const": "" },
              "expected-client-uri-san": { "const": "" },
              "client-issuer-spki-pins": { "const": "" },
              "expected-server-uri-san": { "const": "" },
              "server-issuer-spki-pins": { "const": "" }
            }
          }
        },
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "client-key-store-path": { "minLength": 2 },
              "client-key-store-password-ref": { "minLength": 4 },
              "server-spki-pins": { "minLength": 71 }
            },
            "oneOf": [
              {
                "properties": {
                  "trust-store-path": { "const": "" },
                  "trust-store-password-ref": { "const": "" }
                }
              },
              {
                "properties": {
                  "trust-store-path": { "minLength": 2 },
                  "trust-store-password-ref": { "minLength": 4 }
                }
              }
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "certificate-identity-required": { "const": true } }, "required": ["certificate-identity-required"] },
              { "properties": { "expected-client-subject-dn": { "minLength": 1 } }, "required": ["expected-client-subject-dn"] },
              { "properties": { "expected-client-uri-san": { "minLength": 1 } }, "required": ["expected-client-uri-san"] },
              { "properties": { "client-issuer-spki-pins": { "minLength": 1 } }, "required": ["client-issuer-spki-pins"] },
              { "properties": { "expected-server-uri-san": { "minLength": 1 } }, "required": ["expected-server-uri-san"] },
              { "properties": { "server-issuer-spki-pins": { "minLength": 1 } }, "required": ["server-issuer-spki-pins"] }
            ]
          },
          "then": {
            "properties": {
              "expected-client-subject-dn": { "minLength": 3 },
              "expected-client-uri-san": { "minLength": 4 },
              "client-issuer-spki-pins": { "minLength": 71 },
              "expected-server-uri-san": { "minLength": 4 },
              "server-issuer-spki-pins": { "minLength": 71 }
            }
          }
        }
      ]
    },
    "workloadUri": {
      "type": "string",
      "pattern": "^(|[a-z][a-z0-9+.-]{1,31}:[^\\s]{1,2040})$",
      "maxLength": 2048
    },
    "optionalPinList": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64}(,sha256:[a-f0-9]{64}){0,15})$",
      "maxLength": 1151
    },
    "managedTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "transport", "bootstrap-roots"],
      "properties": {
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "publication-uri": { "$ref": "#/$defs/sourceUri" },
        "trust-root-set-id": { "$ref": "#/$defs/optionalIdentifier" },
        "bootstrap-trust-domain": { "$ref": "#/$defs/optionalIdentifier" },
        "accepted-policy-fingerprints": { "type": "string", "maxLength": 2144 },
        "bootstrap-signature-threshold": { "type": "integer", "minimum": 0, "maximum": 32 },
        "bootstrap-authority-keys-json": { "$ref": "#/$defs/keyArrayJson" },
        "refresh-interval-seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "request-timeout-millis": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "unknown-key-refresh-interval-seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximum-snapshot-age-seconds": { "type": "integer", "minimum": 2, "maximum": 86400 },
        "maximum-publication-lifetime-seconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
        "clock-skew-seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "minimum-remaining-validity-seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "allow-insecure-loopback": { "type": "boolean" },
        "transport": { "$ref": "#/$defs/publicationTransport" },
        "bootstrap-roots": { "$ref": "#/$defs/bootstrapRoots" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": { "properties": { "enabled": { "const": true } } }
        },
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": [
              "publication-uri", "trust-root-set-id", "bootstrap-trust-domain",
              "accepted-policy-fingerprints", "refresh-interval-seconds",
              "request-timeout-millis", "unknown-key-refresh-interval-seconds",
              "maximum-snapshot-age-seconds", "maximum-publication-lifetime-seconds",
              "clock-skew-seconds", "minimum-remaining-validity-seconds",
              "allow-insecure-loopback", "transport", "bootstrap-roots"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "bootstrap-roots": {
                "properties": { "enabled": { "const": false } },
                "required": ["enabled"]
              }
            },
            "required": ["bootstrap-roots"]
          },
          "then": {
            "required": ["bootstrap-signature-threshold", "bootstrap-authority-keys-json"],
            "properties": { "bootstrap-signature-threshold": { "minimum": 1 } }
          }
        },
        {
          "if": {
            "properties": {
              "bootstrap-roots": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["bootstrap-roots"]
          },
          "then": {
            "properties": {
              "bootstrap-signature-threshold": { "const": 0 },
              "bootstrap-authority-keys-json": { "enum": ["", "[]"] }
            }
          }
        }
      ]
    },
    "bootstrapRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "transport"],
      "properties": {
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "genesis-json": { "type": "string", "maxLength": 1048576 },
        "accepted-policy-fingerprints": { "type": "string", "maxLength": 2144 },
        "bundle-uri": { "$ref": "#/$defs/sourceUri" },
        "refresh-interval-seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "request-timeout-millis": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "unknown-key-refresh-interval-seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximum-snapshot-age-seconds": { "type": "integer", "minimum": 2, "maximum": 86400 },
        "maximum-root-lifetime-seconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "clock-skew-seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "minimum-remaining-validity-seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maximum-transitions": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "allow-insecure-loopback": { "type": "boolean" },
        "transport": { "$ref": "#/$defs/publicationTransport" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": { "properties": { "enabled": { "const": true } } }
        },
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": [
              "genesis-json", "accepted-policy-fingerprints", "bundle-uri",
              "refresh-interval-seconds", "request-timeout-millis",
              "unknown-key-refresh-interval-seconds", "maximum-snapshot-age-seconds",
              "maximum-root-lifetime-seconds", "clock-skew-seconds",
              "minimum-remaining-validity-seconds", "maximum-transitions",
              "allow-insecure-loopback", "transport"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
      "then": { "properties": { "enabled": { "const": true } } }
    },
    {
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "required": [
          "trust-domain", "anchor-set-id", "signature-threshold", "maximum-faults",
          "minimum-faults", "endpoints-json", "request-timeout-millis",
          "clock-skew-seconds", "maximum-receipt-lifetime-seconds",
          "allow-insecure-loopback", "transport", "managed-trust"
        ],
        "properties": { "signature-threshold": { "minimum": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "managed-trust": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          }
        },
        "required": ["managed-trust"]
      },
      "then": { "required": ["authority-keys-json"] }
    },
    {
      "if": {
        "properties": {
          "managed-trust": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["managed-trust"]
      },
      "then": { "properties": { "authority-keys-json": { "enum": ["", "[]"] } } }
    }
  ]
}
