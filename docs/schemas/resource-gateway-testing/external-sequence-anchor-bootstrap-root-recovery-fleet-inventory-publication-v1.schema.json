{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/external-sequence-anchor-bootstrap-root-recovery-fleet-inventory-publication-v1.schema.json",
  "title": "Resource Gateway External Sequence-Anchor Bootstrap-Root Recovery Fleet Inventory Publication v1",
  "description": "Witnessed ACTIVE or REVOKED publication for one exact signed recovery-fleet inventory.",
  "$ref": "#/$defs/publication",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "materialFingerprint hashes UTF-8 minified JSON with object keys sorted lexicographically and UTC RFC 3339 whole-second instants.",
      "required": [
        "schemaVersion", "trustDomain", "publicationId", "deploymentScopeId",
        "fleetId", "sequence", "inventoryMaterialFingerprint", "state",
        "policyFingerprint", "previousPublicationFingerprint", "issuedAt",
        "notBefore", "expiresAt", "reasonCode"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryPublicationMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "publicationId": { "$ref": "#/$defs/identifier" },
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "fleetId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "inventoryMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "state": { "enum": ["ACTIVE", "REVOKED"] },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "previousPublicationFingerprint": { "type": "string", "maxLength": 71 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "reasonCode": { "type": "string", "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "sequence": { "const": 1 } } },
          "then": { "properties": { "previousPublicationFingerprint": { "const": "" } } },
          "else": { "properties": { "previousPublicationFingerprint": { "$ref": "#/$defs/fingerprint" } } }
        },
        {
          "if": { "properties": { "state": { "const": "ACTIVE" } } },
          "then": { "properties": { "reasonCode": { "const": "" } } },
          "else": { "properties": { "reasonCode": { "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$" } } }
        }
      ]
    },
    "witnessMaterial": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "materialFingerprint uses the same canonical JSON rules as publication material.",
      "required": [
        "schemaVersion", "witnessDomain", "checkpointId", "deploymentScopeId",
        "fleetId", "sequence", "publicationMaterialFingerprint",
        "previousWitnessFingerprint", "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryWitnessMaterial.v1"
        },
        "witnessDomain": { "$ref": "#/$defs/identifier" },
        "checkpointId": { "$ref": "#/$defs/identifier" },
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "fleetId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "publicationMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "previousWitnessFingerprint": { "type": "string", "maxLength": 71 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "sequence": { "const": 1 } } },
          "then": { "properties": { "previousWitnessFingerprint": { "const": "" } } },
          "else": { "properties": { "previousWitnessFingerprint": { "$ref": "#/$defs/fingerprint" } } }
        }
      ]
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryWitness.v1"
        },
        "material": { "$ref": "#/$defs/witnessMaterial" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "inventory", "material", "materialFingerprint",
        "signatures", "witness"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryPublication.v1"
        },
        "inventory": {
          "$ref": "external-sequence-anchor-bootstrap-root-recovery-fleet-inventory-v1.schema.json"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        },
        "witness": { "$ref": "#/$defs/witness" }
      }
    }
  }
}
