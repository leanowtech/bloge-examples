{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/external-sequence-anchor-bootstrap-root-recovery-fleet-inventory-v1.schema.json",
  "title": "Resource Gateway External Sequence-Anchor Bootstrap-Root Recovery Fleet Inventory v1",
  "description": "Deployment-owned exact recovery-lane inventory signed by distinct Ed25519 authorities.",
  "$ref": "#/$defs/attestation",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expectedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId", "rootSetId", "trustDomain", "signatureThreshold",
        "maximumFaults", "maximumRootLifetime", "clockSkew",
        "minimumRemainingValidity", "maximumTransitionCount"
      ],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "rootSetId": { "$ref": "#/$defs/identifier" },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "signatureThreshold": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maximumFaults": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maximumRootLifetime": { "type": "string", "format": "duration" },
        "clockSkew": { "type": "string", "format": "duration" },
        "minimumRemainingValidity": { "type": "string", "format": "duration" },
        "maximumTransitionCount": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "laneDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedBinding", "runtimeBindingFingerprint"],
      "properties": {
        "expectedBinding": { "$ref": "#/$defs/expectedBinding" },
        "runtimeBindingFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "materialFingerprint hashes UTF-8 minified JSON with object keys sorted lexicographically, canonical laneDescriptors ordered by scopeId/rootSetId, and UTC RFC 3339 whole-second instants.",
      "required": [
        "schemaVersion", "trustDomain", "inventoryId", "generation",
        "deploymentScopeId", "fleetId", "artifactFingerprint", "partitionCount",
        "laneDescriptors", "policyFingerprint", "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "inventoryId": { "$ref": "#/$defs/identifier" },
        "generation": { "type": "integer", "minimum": 1 },
        "deploymentScopeId": { "$ref": "#/$defs/identifier" },
        "fleetId": { "$ref": "#/$defs/identifier" },
        "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
        "partitionCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "laneDescriptors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/laneDescriptor" }
        },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.externalSequenceAnchorBootstrapRootRecoveryFleetInventoryAttestation.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    }
  }
}
