{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/resource-gateway-testing/physical-attempt-provider-inventory-publication-v1.schema.json",
  "title": "Physical Attempt Provider Inventory Publication v1",
  "$ref": "#/$defs/publication",
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "$ref": "#/$defs/instant" },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 88,
          "maxLength": 88
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "trustDomain", "publicationId", "sequence", "scopeId",
        "cohortId", "inventoryMaterialFingerprint", "expectedReplicaIds", "state",
        "policyFingerprint", "previousPublicationFingerprint", "issuedAt", "notBefore",
        "expiresAt", "reasonCode"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventoryPublicationMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "publicationId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "cohortId": { "$ref": "#/$defs/identifier" },
        "inventoryMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "expectedReplicaIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "state": { "enum": ["ACTIVE", "REVOKED"] },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "previousPublicationFingerprint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "issuedAt": { "$ref": "#/$defs/instant" },
        "notBefore": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "reasonCode": {
          "type": "string",
          "pattern": "^(|[A-Z][A-Z0-9_.-]{0,127})$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "sequence": { "const": 1 } } },
          "then": { "properties": { "previousPublicationFingerprint": { "const": "" } } },
          "else": { "properties": { "previousPublicationFingerprint": { "$ref": "#/$defs/fingerprint" } } }
        },
        {
          "if": { "properties": { "state": { "const": "ACTIVE" } } },
          "then": { "properties": { "reasonCode": { "const": "" } } },
          "else": { "properties": { "reasonCode": { "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$" } } }
        }
      ]
    },
    "witnessMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "witnessDomain", "checkpointId", "sequence",
        "publicationMaterialFingerprint", "previousWitnessFingerprint", "issuedAt",
        "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventoryWitnessMaterial.v1"
        },
        "witnessDomain": { "$ref": "#/$defs/identifier" },
        "checkpointId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "publicationMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "previousWitnessFingerprint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "issuedAt": { "$ref": "#/$defs/instant" },
        "notBefore": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" }
      },
      "if": { "properties": { "sequence": { "const": 1 } } },
      "then": { "properties": { "previousWitnessFingerprint": { "const": "" } } },
      "else": { "properties": { "previousWitnessFingerprint": { "$ref": "#/$defs/fingerprint" } } }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventoryWitness.v1"
        },
        "material": { "$ref": "#/$defs/witnessMaterial" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "inventory", "material", "materialFingerprint", "signatures",
        "witness"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventoryPublication.v1"
        },
        "inventory": {
          "$ref": "physical-attempt-provider-inventory-v1.schema.json"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        },
        "witness": { "$ref": "#/$defs/witness" }
      }
    }
  }
}
