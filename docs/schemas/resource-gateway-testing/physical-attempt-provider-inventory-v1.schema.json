{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/physical-attempt-provider-inventory-v1.schema.json",
  "title": "Resource Gateway Physical Attempt Provider Inventory v1",
  "description": "Complete provider/deployment resolver inventory signed by distinct Ed25519 authorities.",
  "$ref": "#/$defs/inventory",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "providerIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,210}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "providerId", "deploymentId", "runtimeArtifactFingerprint",
        "observationKeyId", "isolationModes", "maximumObservationLatencyMillis",
        "minimumStateRetentionMillis"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderBinding.v1"
        },
        "providerId": { "$ref": "#/$defs/providerIdentifier" },
        "deploymentId": { "$ref": "#/$defs/providerIdentifier" },
        "runtimeArtifactFingerprint": { "$ref": "#/$defs/fingerprint" },
        "observationKeyId": { "$ref": "#/$defs/providerIdentifier" },
        "isolationModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["CONTAINER", "PROCESS", "VM"] }
        },
        "maximumObservationLatencyMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "minimumStateRetentionMillis": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 2592000000
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Bindings must be sorted by providerId then deploymentId. materialFingerprint hashes canonical JSON with object keys sorted and array order preserved.",
      "required": [
        "schemaVersion", "trustDomain", "inventoryId", "revision", "scopeId",
        "cohortId", "protocolVersion", "policyFingerprint", "bindings",
        "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventoryMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "inventoryId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "cohortId": { "$ref": "#/$defs/identifier" },
        "protocolVersion": { "$ref": "#/$defs/identifier" },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/binding" }
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityPhysicalAttemptProviderInventory.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    }
  }
}
