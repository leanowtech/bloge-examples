{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/suite-stability-observation-external-archive-v1.schema.json",
  "title": "Resource Gateway Suite Stability Observation External Archive v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/conflictReceipt" },
    { "$ref": "#/$defs/receiptSet" },
    { "$ref": "#/$defs/inventoryRequest" },
    { "$ref": "#/$defs/inventoryItem" },
    { "$ref": "#/$defs/inventoryPage" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "wholeSecondInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestFingerprint", "trustDomain", "archiveSetId",
        "retirement", "retainUntil", "challenge", "requestedAt", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveRequest.v1"
        },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "archiveSetId": { "$ref": "#/$defs/identifier" },
        "retirement": {
          "$ref": "testing-control-plane-v1.schema.json#/$defs/testSuiteStabilityObservationFloorRetirement"
        },
        "retainUntil": { "type": "string", "format": "date-time" },
        "challenge": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "requestedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "receiptFingerprint", "requestFingerprint", "trustDomain",
        "archiveSetId", "authorityId", "failureDomain", "keyId", "objectId",
        "retirementId", "retirementFingerprint", "segmentId", "segmentFingerprint",
        "retentionPolicyFingerprint", "retainUntil", "storedAt", "issuedAt",
        "expiresAt", "retentionMode", "externallyDurable", "writeOnce",
        "deleteBeforeRetentionDenied", "algorithm", "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveReceipt.v1"
        },
        "receiptFingerprint": { "$ref": "#/$defs/fingerprint" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "archiveSetId": { "$ref": "#/$defs/identifier" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "failureDomain": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "objectId": {
          "type": "string",
          "pattern": "^stability-observation-worm-[a-f0-9]{64}$"
        },
        "retirementId": {
          "type": "string",
          "pattern": "^stability-observation-retirement-[a-f0-9]{64}$"
        },
        "retirementFingerprint": { "$ref": "#/$defs/fingerprint" },
        "segmentId": {
          "type": "string",
          "pattern": "^stability-observation-archive-[a-f0-9]{64}$"
        },
        "segmentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retentionPolicyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retainUntil": { "type": "string", "format": "date-time" },
        "storedAt": { "type": "string", "format": "date-time" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "retentionMode": { "const": "COMPLIANCE" },
        "externallyDurable": { "const": true },
        "writeOnce": { "const": true },
        "deleteBeforeRetentionDenied": { "const": true },
        "algorithm": { "const": "Ed25519" },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "conflictReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "conflictFingerprint", "requestFingerprint", "trustDomain",
        "archiveSetId", "authorityId", "failureDomain", "keyId", "objectId",
        "expectedObjectCommitment", "observedObjectCommitment", "issuedAt",
        "expiresAt", "algorithm", "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveConflictReceipt.v1"
        },
        "conflictFingerprint": { "$ref": "#/$defs/fingerprint" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "archiveSetId": { "$ref": "#/$defs/identifier" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "failureDomain": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "objectId": {
          "type": "string",
          "pattern": "^stability-observation-worm-[a-f0-9]{64}$"
        },
        "expectedObjectCommitment": { "$ref": "#/$defs/fingerprint" },
        "observedObjectCommitment": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "algorithm": { "const": "Ed25519" },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "receiptSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "receiptSetId", "request", "requiredCopies", "receipts",
        "confirmedAt", "receiptSetFingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveReceiptSet.v1"
        },
        "receiptSetId": {
          "type": "string",
          "pattern": "^stability-observation-external-archive-receipts-[a-f0-9]{64}$"
        },
        "request": { "$ref": "#/$defs/request" },
        "requiredCopies": { "type": "integer", "minimum": 1, "maximum": 16 },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/receipt" }
        },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "receiptSetFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "inventoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestFingerprint", "trustDomain", "archiveSetId",
        "authorityId", "snapshotId", "afterObjectId", "pageSequence",
        "maximumItems", "challenge", "requestedAt", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveInventoryRequest.v1"
        },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "archiveSetId": { "$ref": "#/$defs/identifier" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "snapshotId": {
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^stability-observation-external-inventory-[a-f0-9]{64}$" }
          ]
        },
        "afterObjectId": {
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^stability-observation-worm-[a-f0-9]{64}$" }
          ]
        },
        "pageSequence": { "type": "integer", "minimum": 0 },
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 500 },
        "challenge": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "requestedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" }
      },
      "oneOf": [
        {
          "properties": {
            "snapshotId": { "const": "" },
            "afterObjectId": { "const": "" },
            "pageSequence": { "const": 0 }
          }
        },
        {
          "properties": {
            "snapshotId": { "type": "string", "pattern": "^stability-observation-external-inventory-[a-f0-9]{64}$" },
            "afterObjectId": { "type": "string", "pattern": "^stability-observation-worm-[a-f0-9]{64}$" },
            "pageSequence": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "itemFingerprint", "objectId", "objectCommitment",
        "retirementId", "retirementFingerprint", "segmentId", "segmentFingerprint",
        "retentionPolicyFingerprint", "retainUntil", "storedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveInventoryItem.v1"
        },
        "itemFingerprint": { "$ref": "#/$defs/fingerprint" },
        "objectId": {
          "type": "string",
          "pattern": "^stability-observation-worm-[a-f0-9]{64}$"
        },
        "objectCommitment": { "$ref": "#/$defs/fingerprint" },
        "retirementId": {
          "type": "string",
          "pattern": "^stability-observation-retirement-[a-f0-9]{64}$"
        },
        "retirementFingerprint": { "$ref": "#/$defs/fingerprint" },
        "segmentId": {
          "type": "string",
          "pattern": "^stability-observation-archive-[a-f0-9]{64}$"
        },
        "segmentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retentionPolicyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retainUntil": { "type": "string", "format": "date-time" },
        "storedAt": { "type": "string", "format": "date-time" }
      }
    },
    "inventoryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "pageFingerprint", "request", "authorityId",
        "failureDomain", "keyId", "snapshotId", "snapshotAt",
        "snapshotObjectCount", "snapshotRoot", "items", "nextAfterObjectId",
        "complete", "issuedAt", "expiresAt", "algorithm", "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityObservationExternalArchiveInventoryPage.v1"
        },
        "pageFingerprint": { "$ref": "#/$defs/fingerprint" },
        "request": { "$ref": "#/$defs/inventoryRequest" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "failureDomain": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "snapshotId": {
          "type": "string",
          "pattern": "^stability-observation-external-inventory-[a-f0-9]{64}$"
        },
        "snapshotAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "snapshotObjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "snapshotRoot": { "$ref": "#/$defs/fingerprint" },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/inventoryItem" }
        },
        "nextAfterObjectId": {
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^stability-observation-worm-[a-f0-9]{64}$" }
          ]
        },
        "complete": { "type": "boolean" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "algorithm": { "const": "Ed25519" },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "complete": { "const": true },
            "nextAfterObjectId": { "const": "" }
          }
        },
        {
          "properties": {
            "complete": { "const": false },
            "nextAfterObjectId": {
              "type": "string",
              "pattern": "^stability-observation-worm-[a-f0-9]{64}$"
            },
            "items": { "minItems": 1 }
          }
        }
      ]
    }
  }
}
