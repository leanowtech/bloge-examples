{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/suite-stability-serving-inventory-v1.schema.json",
  "title": "Resource Gateway Suite Stability Serving Inventory Protocol v1",
  "description": "Deployment-owned exact serving inventory signed by distinct Ed25519 authorities.",
  "$ref": "#/$defs/inventory",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "materialFingerprint hashes UTF-8 minified JSON with object keys sorted lexicographically, arrays preserved, and UTC RFC 3339 instant strings.",
      "required": [
        "schemaVersion", "trustDomain", "inventoryId", "revision", "scopeId",
        "cohortId", "artifactFingerprint", "protocolVersion", "expectedInstanceIds",
        "policyFingerprint", "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityServingInventoryMaterial.v1"
        },
        "trustDomain": { "$ref": "#/$defs/identifier" },
        "inventoryId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "cohortId": { "$ref": "#/$defs/identifier" },
        "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
        "protocolVersion": { "$ref": "#/$defs/identifier" },
        "expectedInstanceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "authoritySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "keyId", "algorithm", "signedAt", "signature"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "material", "materialFingerprint", "signatures"],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSuiteStabilityServingInventory.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    }
  }
}
