{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/test-secret-authority-serving-inventory-trust-root-publication-v1.schema.json",
  "title": "Resource Gateway Test Secret Authority Serving Inventory Trust Root Publication v1",
  "$ref": "#/$defs/publication",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,254}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "optionalFingerprint": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/fingerprint" }
      ]
    },
    "wholeSecondInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authoritySignature": {
      "$ref": "test-secret-authority-serving-inventory-v1.schema.json#/$defs/authoritySignature"
    },
    "authorityKeyMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId", "keyId", "publicKeyBase64", "notBefore", "expiresAt",
        "enabled", "revoked"
      ],
      "properties": {
        "authorityId": { "$ref": "#/$defs/identifier" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 60,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "notBefore": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "enabled": { "type": "boolean" },
        "revoked": { "type": "boolean" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "trustRootSetId", "sequence", "previousMaterialFingerprint",
        "scopeId", "protocolVersion", "deploymentRootTrustDomain",
        "witnessRootTrustDomain", "deploymentTrustDomain", "witnessTrustDomain",
        "deploymentSignatureThreshold", "witnessSignatureThreshold", "deploymentKeys",
        "witnessKeys", "policyFingerprint", "issuedAt", "notBefore", "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSecretAuthorityServingInventoryTrustRootMaterial.v1"
        },
        "trustRootSetId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "previousMaterialFingerprint": { "$ref": "#/$defs/optionalFingerprint" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "protocolVersion": { "$ref": "#/$defs/identifier" },
        "deploymentRootTrustDomain": { "$ref": "#/$defs/identifier" },
        "witnessRootTrustDomain": { "$ref": "#/$defs/identifier" },
        "deploymentTrustDomain": { "$ref": "#/$defs/identifier" },
        "witnessTrustDomain": { "$ref": "#/$defs/identifier" },
        "deploymentSignatureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "witnessSignatureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "deploymentKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityKeyMaterial" }
        },
        "witnessKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityKeyMaterial" }
        },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "issuedAt": { "$ref": "#/$defs/wholeSecondInstant" },
        "notBefore": { "$ref": "#/$defs/wholeSecondInstant" },
        "expiresAt": { "$ref": "#/$defs/wholeSecondInstant" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sequence": { "const": 1 } },
            "required": ["sequence"]
          },
          "then": {
            "properties": { "previousMaterialFingerprint": { "const": "" } }
          },
          "else": {
            "properties": {
              "previousMaterialFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "material", "materialFingerprint",
        "deploymentRootSignatures", "witnessRootSignatures"
      ],
      "properties": {
        "schemaVersion": {
          "const": "bloge.testSecretAuthorityServingInventoryTrustRootPublication.v1"
        },
        "material": { "$ref": "#/$defs/material" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "deploymentRootSignatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authoritySignature" }
        },
        "witnessRootSignatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authoritySignature" }
        }
      }
    }
  }
}
