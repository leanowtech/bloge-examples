{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/test-secret-authority-v1.schema.json",
  "title": "Resource Gateway Test Secret Authority Protocol v1",
  "description": "Private credential-free, challenge-bound and Ed25519-signed test-secret resolution protocol.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/trustDescriptor" },
    { "$ref": "#/$defs/trustRefreshSnapshot" },
    { "$ref": "#/$defs/trustCohortSnapshot" },
    { "$ref": "#/$defs/trustCohortDescriptor" },
    { "$ref": "#/$defs/authorityDescriptor" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,254}$"
    },
    "optionalIdentifier": {
      "type": "string",
      "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,254})$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43,128}$"
    },
    "secretReference": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 1024
    },
    "resolutionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "tenantId", "organizationId", "projectId", "environmentId",
        "region", "actorType", "actorId", "delegatedBy", "purpose", "groups",
        "clearance", "delegationGrantId", "authorizedPurpose",
        "executionTargetFingerprint", "fixtureTargetFingerprint", "fixtureBundleId",
        "fixtureRevision", "fixtureFingerprint", "secretRefs"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretResolutionContext.v1" },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "organizationId": { "type": "string", "maxLength": 255 },
        "projectId": { "type": "string", "maxLength": 255 },
        "environmentId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "region": { "type": "string", "maxLength": 128 },
        "actorType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "delegatedBy": { "type": "string", "maxLength": 255 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groups": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "clearance": { "type": "string", "minLength": 1, "maxLength": 64 },
        "delegationGrantId": { "type": "string", "maxLength": 255 },
        "authorizedPurpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executionTargetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "fixtureTargetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "fixtureBundleId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fixtureRevision": { "type": "integer", "minimum": 1 },
        "fixtureFingerprint": { "$ref": "#/$defs/fingerprint" },
        "secretRefs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9._:/-]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/secretReference" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "challenge", "requestedAt", "action", "context",
        "contextFingerprint", "requestFingerprint"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityRequest.v1" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "action": { "const": "RESOLVE_TEST_SECRET_CLOSURE" },
        "context": { "$ref": "#/$defs/resolutionContext" },
        "contextFingerprint": { "$ref": "#/$defs/fingerprint" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "secretMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "reference", "version", "bindingFingerprint", "value"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9._:/-]{0,127}$" },
        "reference": { "$ref": "#/$defs/secretReference" },
        "version": { "$ref": "#/$defs/identifier" },
        "bindingFingerprint": { "$ref": "#/$defs/fingerprint" },
        "value": { "type": "string", "maxLength": 65536 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "challenge", "requestFingerprint",
        "contextFingerprint", "decision", "failureCode", "authorityId",
        "authorityGeneration", "decisionId", "issuedAt", "expiresAt", "secrets",
        "materialFingerprint", "signature"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityResponse.v1" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "contextFingerprint": { "$ref": "#/$defs/fingerprint" },
        "decision": { "enum": ["AUTHORIZED", "DENIED"] },
        "failureCode": { "type": "string", "pattern": "^(|[A-Z][A-Z0-9_.-]{0,127})$" },
        "authorityId": { "$ref": "#/$defs/identifier" },
        "authorityGeneration": { "$ref": "#/$defs/identifier" },
        "decisionId": { "$ref": "#/$defs/identifier" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "secrets": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9._:/-]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/secretMaterial" }
        },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "signature": { "$ref": "#/$defs/signature" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "AUTHORIZED" } } },
          "then": {
            "properties": {
              "failureCode": { "const": "" },
              "secrets": { "minProperties": 1, "maxProperties": 100 }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "DENIED" } } },
          "then": {
            "properties": {
              "failureCode": { "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$" },
              "secrets": { "maxProperties": 0 }
            }
          }
        }
      ]
    },
    "trustProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "signedResponses": { "type": "boolean" },
        "challengeBound": { "type": "boolean" },
        "privateMaterialPresent": { "const": false },
        "activeKeyCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "maximumResponseLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "minimumRemainingValidityMillis": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "refreshMode": { "$ref": "#/$defs/identifier" },
        "refreshState": { "$ref": "#/$defs/identifier" },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximumSnapshotAgeSeconds": { "type": "integer", "minimum": 2, "maximum": 86400 },
        "unknownKeyRefreshIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "failClosedOnRefreshFailure": { "const": true },
        "conditionalRequests": { "const": true },
        "automaticRefresh": { "type": "boolean" }
      }
    },
    "trustDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "available", "providerType", "expectedAuthorityId", "keyCount",
        "properties"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityTrustDescriptor.v1" },
        "available": { "type": "boolean" },
        "providerType": { "$ref": "#/$defs/identifier" },
        "expectedAuthorityId": { "$ref": "#/$defs/optionalIdentifier" },
        "keyCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "properties": { "$ref": "#/$defs/trustProperties" }
      }
    },
    "trustRefreshSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "available", "refreshState", "trustedKeyCount",
        "activeKeyCount", "lastSuccessfulRefreshAt", "refreshSuccessCount",
        "refreshFailureCount", "lastFailureCode", "refreshIntervalSeconds",
        "maximumSnapshotAgeSeconds"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityTrustRefreshSnapshot.v1" },
        "available": { "type": "boolean" },
        "refreshState": {
          "enum": ["BOOTSTRAPPING", "HEALTHY", "UNAVAILABLE", "EXPIRED", "CLOSED"]
        },
        "trustedKeyCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "activeKeyCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "lastSuccessfulRefreshAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "refreshSuccessCount": { "type": "integer", "minimum": 0 },
        "refreshFailureCount": { "type": "integer", "minimum": 0 },
        "lastFailureCode": { "type": "string", "pattern": "^(|[A-Z][A-Z0-9_.-]{0,127})$" },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximumSnapshotAgeSeconds": { "type": "integer", "minimum": 2, "maximum": 86400 }
      }
    },
    "trustCohortSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "converged", "status", "expectedReplicaCount",
        "liveReplicaCount", "healthyReplicaCount", "distinctTrustGenerationCount",
        "missingReplicaCount", "unexpectedReplicaCount", "duplicateReplicaCount",
        "divergentArtifactCount", "divergentPolicyCount", "divergentProtocolCount",
        "divergentAuthorityCount", "observedAt", "nextLeaseExpiryAt", "blockers"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityTrustCohortSnapshot.v1" },
        "converged": { "type": "boolean" },
        "status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "expectedReplicaCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "liveReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "healthyReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "distinctTrustGenerationCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "missingReplicaCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "unexpectedReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "duplicateReplicaCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "divergentArtifactCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "divergentPolicyCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "divergentProtocolCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "divergentAuthorityCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "observedAt": { "type": "string", "format": "date-time" },
        "nextLeaseExpiryAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "blockers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        }
      }
    },
    "trustCohortDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "configured", "available", "status", "expectedReplicaCount",
        "liveReplicaCount", "healthyReplicaCount", "distinctTrustGenerationCount",
        "leaseDurationSeconds", "databaseAuthority", "exactConfiguredInventory"
      ],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityTrustCohortDescriptor.v1" },
        "configured": { "type": "boolean" },
        "available": { "type": "boolean" },
        "status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "expectedReplicaCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "liveReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "healthyReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "distinctTrustGenerationCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "leaseDurationSeconds": { "type": "integer", "minimum": 0, "maximum": 900 },
        "databaseAuthority": { "type": "boolean" },
        "exactConfiguredInventory": { "type": "boolean" }
      }
    },
    "authorityProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": "bloge.testSecretAuthorityRequest.v1" },
        "responseProtocolVersion": { "const": "bloge.testSecretAuthorityResponse.v1" },
        "signedResponses": { "type": "boolean" },
        "challengeBound": { "type": "boolean" },
        "credentialFree": { "type": "boolean" },
        "redirectsFollowed": { "const": false },
        "automaticRetries": { "const": false },
        "privateMaterialPresent": { "const": false },
        "requestTimeoutMillis": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "trustProviderType": { "$ref": "#/$defs/identifier" },
        "trustAvailable": { "type": "boolean" },
        "trustRefreshState": { "$ref": "#/$defs/identifier" },
        "trustAutomaticRefresh": { "type": "boolean" },
        "trustRefreshIntervalSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "trustMaximumSnapshotAgeSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "trustConditionalRequests": { "type": "boolean" },
        "trustFailClosedOnRefreshFailure": { "type": "boolean" },
        "trustCohortConfigured": { "type": "boolean" },
        "trustCohortAvailable": { "type": "boolean" },
        "trustCohortStatus": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "trustCohortExpectedReplicaCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "trustCohortLiveReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "trustCohortHealthyReplicaCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "trustCohortDistinctGenerationCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "trustCohortLeaseDurationSeconds": { "type": "integer", "minimum": 0, "maximum": 900 },
        "trustCohortDatabaseAuthority": { "type": "boolean" },
        "trustCohortExactConfiguredInventory": { "type": "boolean" }
      }
    },
    "authorityDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "available", "providerType", "authorityId", "properties"],
      "properties": {
        "schemaVersion": { "const": "bloge.testSecretAuthorityDescriptor.v1" },
        "available": { "type": "boolean" },
        "providerType": { "$ref": "#/$defs/identifier" },
        "authorityId": { "$ref": "#/$defs/optionalIdentifier" },
        "properties": { "$ref": "#/$defs/authorityProperties" }
      }
    }
  }
}
