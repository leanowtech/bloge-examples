{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.example/schemas/resource-gateway-testing/testing-control-plane-v1.schema.json",
  "title": "Resource Gateway Testing Control Plane v1",
  "description": "Wire contracts for target discovery, immutable fixtures, controlled execution, plans, and sanitized evidence.",
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "fingerprint"],
      "properties": {
        "kind": {"const": "GRAPH"},
        "id": {"type": "string", "minLength": 1, "maxLength": 255},
        "fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"const": ""}]}
      }
    },
    "fixtureBundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureBundleId", "revision", "fingerprint"],
      "properties": {
        "fixtureBundleId": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "integer", "minimum": 1},
        "fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"const": ""}]}
      }
    },
    "resolvedFixtureBundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fixtureBundleId", "revision", "fingerprint"],
      "properties": {
        "source": {"enum": ["INLINE", "STORED"]},
        "fixtureBundleId": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "integer", "minimum": 0},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalInput", "pathEquals", "pathsExist", "pathsAbsent", "schema", "correlationKey", "boundedRegex"],
      "properties": {
        "canonicalInput": true,
        "pathEquals": {"type": "object"},
        "pathsExist": {"type": "array", "items": {"type": "string"}, "maxItems": 100},
        "pathsAbsent": {"type": "array", "items": {"type": "string"}, "maxItems": 100},
        "schema": {"type": "object"},
        "correlationKey": {"type": "string", "maxLength": 512},
        "boundedRegex": {
          "type": "object",
          "additionalProperties": {"type": "string", "maxLength": 256},
          "maxProperties": 100
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphPath", "nodeId", "operatorRef", "resourceRef", "functionRef", "capabilities", "tags", "invocationKind", "attempts", "occurrences", "correlationKey", "match"],
      "properties": {
        "graphPath": {"type": "string", "maxLength": 512},
        "nodeId": {"type": "string", "maxLength": 255},
        "operatorRef": {"type": "string", "maxLength": 512},
        "resourceRef": {"type": "string", "maxLength": 512},
        "functionRef": {"type": "string", "maxLength": 512},
        "capabilities": {"type": "array", "items": {"type": "string"}, "maxItems": 100},
        "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 100},
        "invocationKind": {"enum": ["PRIMARY", "COMPENSATION", "FUNCTION", "RESOURCE", "SUBGRAPH"]},
        "attempts": {"type": "array", "items": {"type": "integer", "minimum": 1}, "maxItems": 100},
        "occurrences": {"type": "array", "items": {"type": "integer", "minimum": 1}, "maxItems": 100},
        "correlationKey": {"type": "string", "maxLength": 512},
        "match": {"$ref": "#/$defs/match"}
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "boundary", "value", "rawBody", "statusCode", "headers", "errorCode", "errorType", "errorMessage", "after", "sequence", "replayRef"],
      "properties": {
        "kind": {"enum": ["REAL", "RETURN", "THROW", "DELAY", "TIMEOUT", "STREAM", "REPLAY", "SPY", "DENY"]},
        "boundary": {"enum": ["NODE", "TRANSPORT"]},
        "value": true,
        "rawBody": {"type": "string", "maxLength": 1048576},
        "statusCode": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}, "maxProperties": 100},
        "errorCode": {"type": "string", "maxLength": 160},
        "errorType": {"type": "string", "maxLength": 160},
        "errorMessage": {"type": "string", "maxLength": 4096},
        "after": {"type": ["string", "null"], "format": "duration"},
        "sequence": {"type": "array", "maxItems": 100},
        "replayRef": {"type": "string", "maxLength": 512}
      }
    },
    "fixtureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ruleId", "selector", "behavior", "consumption", "schemaCheck"],
      "properties": {
        "schemaVersion": {"const": "bloge.fixtureRule.v1"},
        "ruleId": {"type": "string", "minLength": 1, "maxLength": 255},
        "selector": {"$ref": "#/$defs/selector"},
        "behavior": {"$ref": "#/$defs/behavior"},
        "consumption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "minUses", "maxUses", "onExhausted", "onUnmatched"],
          "properties": {
            "required": {"type": "boolean"},
            "minUses": {"type": "integer", "minimum": 0},
            "maxUses": {"type": "integer", "minimum": 0},
            "onExhausted": {"enum": ["FAIL", "FALLBACK_TO_REAL"]},
            "onUnmatched": {"enum": ["FAIL", "WARN", "ALLOW_REAL"]}
          }
        },
        "schemaCheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "waiverReason"],
          "properties": {
            "mode": {"enum": ["STRICT", "WAIVED"]},
            "waiverReason": {"type": "string", "maxLength": 4096}
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "nodeId", "path", "operator", "expected", "numericTolerance"],
      "properties": {
        "scope": {"type": "string", "minLength": 1, "maxLength": 96},
        "nodeId": {"type": "string", "maxLength": 255},
        "path": {"type": "string", "maxLength": 1024},
        "operator": {"type": "string", "minLength": 1, "maxLength": 96},
        "expected": true,
        "numericTolerance": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "fixtureBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "fixtureBundleId", "revision", "targetFingerprint", "classification", "logicalClock", "randomSeed", "rules", "assertions", "metadata"],
      "properties": {
        "schemaVersion": {"const": "bloge.fixtureBundle.v1"},
        "fixtureBundleId": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "integer", "minimum": 1},
        "targetFingerprint": {"$ref": "#/$defs/fingerprint"},
        "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "logicalClock": {"type": ["string", "null"], "format": "date-time"},
        "randomSeed": {"type": ["integer", "null"]},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/fixtureRule"}, "maxItems": 1000},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}, "maxItems": 1000},
        "metadata": {"type": "object", "maxProperties": 100}
      }
    },
    "fixtureBundleRegistrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "fixtureBundle"],
      "properties": {
        "schemaVersion": {"const": "bloge.fixtureBundleRegistrationRequest.v1"},
        "target": {"$ref": "#/$defs/target"},
        "fixtureBundle": {"$ref": "#/$defs/fixtureBundle"}
      }
    },
    "storedFixtureBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tenantId", "environmentId", "fixtureBundleId", "revision", "fingerprint", "bundle", "createdAt", "createdBy"],
      "properties": {
        "schemaVersion": {"const": "bloge.storedFixtureBundle.v1"},
        "tenantId": {"type": "string", "minLength": 1},
        "environmentId": {"type": "string", "minLength": 1},
        "fixtureBundleId": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "integer", "minimum": 1},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "bundle": {"$ref": "#/$defs/fixtureBundle"},
        "createdAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": "string", "minLength": 1}
      }
    },
    "testExecutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "executionPurpose", "context", "fixtureBundle", "fixtureBundleRef", "verbosity", "metadata"],
      "properties": {
        "schemaVersion": {"const": "bloge.testExecutionRequest.v1"},
        "target": {"$ref": "#/$defs/target"},
        "executionPurpose": {"const": "GRAPH_CONTRACT_TEST"},
        "context": {"type": "object"},
        "fixtureBundle": {"oneOf": [{"$ref": "#/$defs/fixtureBundle"}, {"type": "null"}]},
        "fixtureBundleRef": {"oneOf": [{"$ref": "#/$defs/fixtureBundleRef"}, {"type": "null"}]},
        "verbosity": {"enum": ["SUMMARY", "STANDARD", "FULL"]},
        "metadata": {"type": "object", "maxProperties": 100}
      },
      "oneOf": [
        {"properties": {"fixtureBundle": {"$ref": "#/$defs/fixtureBundle"}, "fixtureBundleRef": {"type": "null"}}},
        {"properties": {"fixtureBundle": {"type": "null"}, "fixtureBundleRef": {"$ref": "#/$defs/fixtureBundleRef"}}}
      ]
    },
    "testExecutionBatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executions"],
      "properties": {
        "schemaVersion": {"const": "bloge.testExecutionBatchRequest.v1"},
        "executions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/testExecutionRequest"}
        }
      }
    },
    "runStatus": {
      "enum": ["PASSED", "ASSERTION_FAILED", "EXECUTION_FAILED", "CONTROL_PLAN_REJECTED", "FIXTURE_UNMATCHED", "FIXTURE_UNUSED", "CONTROL_PLAN_UNAVAILABLE", "EVIDENCE_INCOMPLETE", "CANCELLED", "TIMED_OUT"]
    },
    "attemptTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "status", "fidelity", "input", "output", "errorCode", "durationMs"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 0},
        "status": {"enum": ["SUCCESS", "FAILED", "TIMEOUT", "MOCKED"]},
        "fidelity": {"enum": ["REAL", "OUTPUT_LEVEL", "PROTOCOL_DERIVED", "TRANSPORT_LEVEL", "REPLAYED"]},
        "input": {},
        "output": {},
        "errorCode": {"type": "string"},
        "durationMs": {"type": "integer", "minimum": 0}
      }
    },
    "nodeTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "operatorRef", "status", "fidelity", "input", "output", "errorCode", "durationMs", "invocationSiteId", "graphPath", "correlationKey", "occurrence", "graphOccurrence", "attempts"],
      "properties": {
        "nodeId": {"type": "string"},
        "operatorRef": {"type": "string"},
        "status": {"enum": ["SUCCESS", "FAILED", "TIMEOUT", "SKIPPED", "MOCKED"]},
        "fidelity": {"enum": ["REAL", "OUTPUT_LEVEL", "PROTOCOL_DERIVED", "TRANSPORT_LEVEL", "REPLAYED"]},
        "input": {},
        "output": {},
        "errorCode": {"type": "string"},
        "durationMs": {"type": "integer", "minimum": 0},
        "invocationSiteId": {"type": "string"},
        "graphPath": {"type": "string"},
        "correlationKey": {"type": "string"},
        "occurrence": {"type": "integer", "minimum": 0},
        "graphOccurrence": {"type": "integer", "minimum": 0},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attemptTrace"}}
      }
    },
    "edgeTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "status", "value", "graphPath", "correlationKey", "graphOccurrence", "fromInvocationSiteId", "toInvocationSiteId"],
      "properties": {
        "edgeId": {"type": "string"},
        "status": {"enum": ["TRANSFERRED", "SKIPPED", "NOT_TRANSFERRED"]},
        "value": {},
        "graphPath": {"type": "string"},
        "correlationKey": {"type": "string"},
        "graphOccurrence": {"type": "integer", "minimum": 0},
        "fromInvocationSiteId": {"type": "string"},
        "toInvocationSiteId": {"type": "string"}
      }
    },
    "effectivePlan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "planId", "planFingerprint", "authorizedPurpose", "targetFingerprint", "fixtureBundleFingerprint", "resolvedSites", "defaultPolicies", "diagnostics"],
      "properties": {
        "schemaVersion": {"const": "bloge.effectiveExecutionPlan.v1"},
        "planId": {"type": "string"},
        "planFingerprint": {"$ref": "#/$defs/fingerprint"},
        "authorizedPurpose": {"const": "GRAPH_CONTRACT_TEST"},
        "targetFingerprint": {"$ref": "#/$defs/fingerprint"},
        "fixtureBundleFingerprint": {"$ref": "#/$defs/fingerprint"},
        "resolvedSites": {"type": "array"},
        "defaultPolicies": {"type": "object"},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "testRunEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "status", "evidenceClass", "executionPurpose", "targetFingerprint", "fixtureBundleFingerprint", "planFingerprint", "startedAt", "completedAt", "nodeTrace", "edgeTrace", "fixtureConsumptions", "assertionResults", "diagnostics", "metadata"],
      "properties": {
        "schemaVersion": {"const": "bloge.testRunEvidence.v1"},
        "runId": {"type": "string"},
        "status": {"$ref": "#/$defs/runStatus"},
        "evidenceClass": {"enum": ["EXPLORATORY", "CERTIFIABLE"]},
        "executionPurpose": {"const": "GRAPH_CONTRACT_TEST"},
        "targetFingerprint": {"$ref": "#/$defs/fingerprint"},
        "fixtureBundleFingerprint": {"$ref": "#/$defs/fingerprint"},
        "planFingerprint": {"type": "string"},
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "nodeTrace": {"type": "array", "items": {"$ref": "#/$defs/nodeTrace"}},
        "edgeTrace": {"type": "array", "items": {"$ref": "#/$defs/edgeTrace"}},
        "fixtureConsumptions": {"type": "array"},
        "assertionResults": {"type": "array"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "metadata": {"type": "object"}
      }
    },
    "testExecutionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "target", "fixtureBundleRef", "plan", "evidence"],
      "properties": {
        "schemaVersion": {"const": "bloge.testExecutionResponse.v1"},
        "runId": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "fixtureBundleRef": {"$ref": "#/$defs/resolvedFixtureBundleRef"},
        "plan": {"$ref": "#/$defs/effectivePlan"},
        "evidence": {"$ref": "#/$defs/testRunEvidence"}
      }
    },
    "testExecutionBatchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executions"],
      "properties": {
        "schemaVersion": {"const": "bloge.testExecutionBatchResponse.v1"},
        "executions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/testExecutionResponse"}
        }
      }
    },
    "testGraphTargetDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "contract", "resourceDependencyFingerprints", "dependencyPolicy", "certificationEligible", "certificationGaps"],
      "properties": {
        "schemaVersion": {"const": "bloge.testGraphTargetDescriptor.v1"},
        "target": {"$ref": "#/$defs/target"},
        "contract": {"type": "object"},
        "resourceDependencyFingerprints": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/fingerprint"}
        },
        "dependencyPolicy": {"const": "CONSERVATIVE_ALL_REGISTERED"},
        "certificationEligible": {"type": "boolean"},
        "certificationGaps": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
