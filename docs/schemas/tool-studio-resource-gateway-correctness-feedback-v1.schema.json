{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanowtech.com/schemas/tool-studio-resource-gateway-correctness-feedback-v1.schema.json",
  "title": "Tool Studio Resource Gateway Correctness Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feedbackId", "scope", "publicationRef", "sourceSystem", "sourceProtocolVersion", "sourceDecisionId", "sourceDecisionRevision", "sourceDecisionFingerprint", "decision", "workbookStatus", "ownerApprovalStatus", "breakingMigrationStatus", "findings", "producedAt", "expiresAt", "receivedAt", "receivedBy", "correlationId"],
  "properties": {
    "schemaVersion": { "const": "toolStudio.resourceGateway.correctnessFeedback.v1" },
    "feedbackId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "scope": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/enterpriseScope" },
    "publicationRef": { "$ref": "bloge-correctness-run-protocol-v1.schema.json#/$defs/publicationRef" },
    "sourceSystem": { "const": "ANEKE_TOOL_STUDIO" },
    "sourceProtocolVersion": { "enum": ["1.1.0", "1.0.0"] },
    "sourceDecisionId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "sourceDecisionRevision": { "type": "integer", "minimum": 1 },
    "sourceDecisionFingerprint": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/fingerprint" },
    "decision": { "enum": ["ACCEPTED", "BLOCKED", "REVIEW_REQUIRED", "NOT_EVALUATED"] },
    "workbookStatus": { "enum": ["CURRENT", "STALE", "MISSING", "NOT_EVALUATED"] },
    "ownerApprovalStatus": { "enum": ["APPROVED", "REQUIRED", "REJECTED", "NOT_EVALUATED"] },
    "breakingMigrationStatus": { "enum": ["NONE", "DETECTED", "REVIEW_REQUIRED", "NOT_EVALUATED"] },
    "findings": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/finding" } },
    "producedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "receivedBy": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
    "correlationId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "severity", "category", "code", "message", "remediation", "deepLink"],
      "properties": {
        "findingId": { "$ref": "bloge-correctness-authoring-v1.schema.json#/$defs/identifier" },
        "severity": { "enum": ["BLOCKING", "WARNING", "INFO"] },
        "category": { "enum": ["CONTRACT", "WORKBOOK", "OWNER", "MIGRATION", "RUNTIME", "POLICY"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "deepLink": { "type": "string", "maxLength": 2048, "pattern": "^(?:$|/|https://)" }
      }
    }
  }
}
