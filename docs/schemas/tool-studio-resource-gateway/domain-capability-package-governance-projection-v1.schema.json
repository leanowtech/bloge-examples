{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/domain-capability-package-governance-projection-v1.schema.json",
  "title": "Tool Studio Domain Capability Package Governance Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectionFingerprint", "projectionId", "revision",
    "externalGeneration", "scope", "packageSnapshotRef", "registryIngestBundleRef",
    "evidenceIndexRef", "registryRecordRef", "status", "gateDecisionRef",
    "sourceCursorFingerprint", "producedAt", "validFrom", "expiresAt", "issuer",
    "projectionSeal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "toolStudio.domainCapabilityPackageGovernanceProjection.v1"
    },
    "projectionFingerprint": { "$ref": "#/$defs/fingerprint" },
    "projectionId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "externalGeneration": { "type": "integer", "minimum": 1 },
    "scope": {
      "$ref": "https://bloge.dev/schemas/resource-gateway-business-mirror/business-mirror-common-v1.schema.json#/$defs/scope"
    },
    "packageSnapshotRef": { "$ref": "#/$defs/packageRef" },
    "registryIngestBundleRef": { "$ref": "#/$defs/ingestRef" },
    "evidenceIndexRef": { "$ref": "#/$defs/evidenceRef" },
    "registryRecordRef": { "$ref": "#/$defs/registryRef" },
    "status": {
      "type": "string",
      "enum": ["UNDER_REVIEW", "ACCEPTED", "REJECTED", "CERTIFIED", "SUSPENDED", "REVOKED"]
    },
    "gateDecisionRef": {
      "oneOf": [{ "$ref": "#/$defs/gateRef" }, { "type": "null" }]
    },
    "sourceCursorFingerprint": { "$ref": "#/$defs/fingerprint" },
    "producedAt": { "type": "string", "format": "date-time" },
    "validFrom": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "issuer": { "$ref": "#/$defs/identifier" },
    "projectionSeal": { "$ref": "#/$defs/seal" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "UNDER_REVIEW" } } },
      "then": { "properties": { "gateDecisionRef": { "type": "null" } } },
      "else": { "properties": { "gateDecisionRef": { "$ref": "#/$defs/gateRef" } } }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/#-]{0,511}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "fingerprint"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "packageRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "DOMAIN_CAPABILITY_PACKAGE" } } }
      ]
    },
    "ingestRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "PACKAGE_REGISTRY_INGEST_BUNDLE" } } }
      ]
    },
    "evidenceRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "PACKAGE_EVIDENCE_INDEX" } } }
      ]
    },
    "registryRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "ANEKE_PACKAGE_REGISTRY_RECORD" } } }
      ]
    },
    "gateRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "ANEKE_PACKAGE_GATE_DECISION" } } }
      ]
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "materialFingerprint", "algorithm", "keyId", "signedAt", "signature"],
      "properties": {
        "schemaVersion": { "const": "bloge.visualRunEvidenceSeal.v1" },
        "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "keyId": { "$ref": "#/$defs/identifier" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    }
  }
}
