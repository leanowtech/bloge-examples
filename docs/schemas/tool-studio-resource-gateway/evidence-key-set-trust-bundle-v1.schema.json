{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/evidence-key-set-trust-bundle-v1.schema.json",
  "title": "Resource Gateway Evidence Key Set Trust Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "trustDomain", "logId", "afterSequence",
    "throughSequence", "highWaterSequence", "headPublicationFingerprint", "hasMore",
    "headPublication", "publications", "keySet"],
  "properties": {
    "schemaVersion": {"const": "toolStudio.resourceGateway.evidenceKeySetTrustBundle.v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "trustDomain": {"type": "string", "minLength": 1, "maxLength": 255},
    "logId": {"type": "string", "minLength": 1, "maxLength": 255},
    "afterSequence": {"type": "integer", "minimum": 0},
    "throughSequence": {"type": "integer", "minimum": 0},
    "highWaterSequence": {"type": "integer", "minimum": 1},
    "headPublicationFingerprint": {"$ref": "#/$defs/fingerprint"},
    "headPublication": {"$ref": "#/$defs/publication"},
    "hasMore": {"type": "boolean"},
    "publications": {"type": "array", "maxItems": 256,
      "items": {"$ref": "#/$defs/publication"}},
    "keySet": {"$ref": "#/$defs/keySet"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotFingerprint", "state", "validFrom", "validUntil", "revokedAt", "reasonCode"],
      "properties": {
        "snapshotFingerprint": {"$ref": "#/$defs/fingerprint"},
        "state": {"enum": ["ACTIVE", "OVERLAP", "REVOKED"]},
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": ["string", "null"], "format": "date-time"},
        "revokedAt": {"type": ["string", "null"], "format": "date-time"},
        "reasonCode": {"type": "string", "maxLength": 128, "pattern": "^$|^[A-Z][A-Z0-9_.-]{0,127}$"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityId", "algorithm", "signature"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1, "maxLength": 255},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "publicationFingerprint", "trustDomain", "logId", "sequence",
        "previousPublicationFingerprint", "recoveryEpoch", "publishedAt", "expiresAt", "pins", "signatures"],
      "properties": {
        "schemaVersion": {"const": "toolStudio.resourceGateway.evidenceKeySetTrustPublication.v1"},
        "publicationFingerprint": {"$ref": "#/$defs/fingerprint"},
        "trustDomain": {"type": "string", "minLength": 1, "maxLength": 255},
        "logId": {"type": "string", "minLength": 1, "maxLength": 255},
        "sequence": {"type": "integer", "minimum": 1},
        "previousPublicationFingerprint": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "recoveryEpoch": {"type": "integer", "minimum": 0},
        "publishedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "pins": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/pin"}},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/signature"}}
      }
    },
    "keySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotFingerprint", "provider", "generatedAt", "expiresAt",
        "activeKeyId", "policyCompleteness", "keys", "events", "attestation"],
      "properties": {
        "schemaVersion": {"const": "toolStudio.resourceGateway.evidenceVerificationKeySet.v1"},
        "snapshotFingerprint": {"$ref": "#/$defs/fingerprint"},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "generatedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "activeKeyId": {"type": "string", "minLength": 1, "maxLength": 255},
        "policyCompleteness": {"enum": ["COMPLETE", "CURRENT_STATE_ONLY"]},
        "keys": {"type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/key"}},
        "events": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/event"}},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["keyId", "algorithm", "encodedPublicKey", "createdAt", "notBefore", "notAfter",
        "state", "providerKeyVersion"],
      "properties": {
        "keyId": {"type": "string", "minLength": 1, "maxLength": 255},
        "algorithm": {"const": "Ed25519"},
        "encodedPublicKey": {"type": "string", "minLength": 1, "maxLength": 2048},
        "createdAt": {"type": "string", "format": "date-time"},
        "notBefore": {"type": "string", "format": "date-time"},
        "notAfter": {"type": ["string", "null"], "format": "date-time"},
        "state": {"enum": ["ACTIVE", "VERIFY_ONLY", "DISABLED", "REVOKED"]},
        "providerKeyVersion": {"type": "string", "maxLength": 255}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "eventId", "keyId", "type", "occurredAt", "effectiveAt",
        "revocationMode", "invalidFrom", "reasonCode"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "eventId": {"type": "string", "minLength": 1, "maxLength": 255},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 255},
        "type": {"enum": ["CREATED", "ACTIVATED", "RETIRED", "DISABLED", "REVOKED", "COMPROMISE_DECLARED"]},
        "occurredAt": {"type": "string", "format": "date-time"},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "revocationMode": {"type": ["string", "null"], "enum": ["PROSPECTIVE", "RETROACTIVE", null]},
        "invalidFrom": {"type": ["string", "null"], "format": "date-time"},
        "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "materialFingerprint", "algorithm", "keyId", "signedAt", "signature"],
      "properties": {
        "schemaVersion": {"const": "bloge.visualRunEvidenceSeal.v1"},
        "materialFingerprint": {"$ref": "#/$defs/fingerprint"},
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 255},
        "signedAt": {"type": "string", "format": "date-time"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
