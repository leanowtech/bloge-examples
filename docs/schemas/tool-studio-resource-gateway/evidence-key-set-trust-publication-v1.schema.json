{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/evidence-key-set-trust-publication-v1.schema.json",
  "title": "Resource Gateway Evidence Key Set Trust Publication v1",
  "$ref": "#/$defs/publication",
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotFingerprint", "state", "validFrom", "validUntil", "revokedAt", "reasonCode"],
      "properties": {
        "snapshotFingerprint": {"$ref": "#/$defs/fingerprint"},
        "state": {"enum": ["ACTIVE", "OVERLAP", "REVOKED"]},
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": ["string", "null"], "format": "date-time"},
        "revokedAt": {"type": ["string", "null"], "format": "date-time"},
        "reasonCode": {"type": "string", "maxLength": 128, "pattern": "^$|^[A-Z][A-Z0-9_.-]{0,127}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "algorithm", "signature"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1, "maxLength": 255},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "publicationFingerprint", "trustDomain", "logId", "sequence",
        "previousPublicationFingerprint", "recoveryEpoch", "publishedAt", "expiresAt", "pins", "signatures"],
      "properties": {
        "schemaVersion": {"const": "toolStudio.resourceGateway.evidenceKeySetTrustPublication.v1"},
        "publicationFingerprint": {"$ref": "#/$defs/fingerprint"},
        "trustDomain": {"type": "string", "minLength": 1, "maxLength": 255},
        "logId": {"type": "string", "minLength": 1, "maxLength": 255},
        "sequence": {"type": "integer", "minimum": 1},
        "previousPublicationFingerprint": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "recoveryEpoch": {"type": "integer", "minimum": 0},
        "publishedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "pins": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/pin"}},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/signature"}}
      }
    }
  }
}
