{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/managed-evidence-sign-response-v1.schema.json",
  "title": "Resource Gateway Managed Evidence Sign Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requestId", "keyId", "algorithm", "materialFingerprint", "signedAt", "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.managedEvidenceSignResponse.v1" },
    "requestId": { "type": "string", "format": "uuid" },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "algorithm": { "const": "Ed25519" },
    "materialFingerprint": { "$ref": "#/$defs/fingerprint" },
    "signedAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
