{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/managed-evidence-signing-keys-v1.schema.json",
  "title": "Resource Gateway Managed Evidence Signing Keys v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "expiresAt", "activeKeyId", "keys"],
  "properties": {
    "schemaVersion": { "const": "resourceGateway.managedEvidenceSigningKeys.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "activeKeyId": { "$ref": "#/$defs/keyId" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId", "algorithm", "encodedPublicKey", "createdAt", "state", "providerKeyVersion"
      ],
      "properties": {
        "keyId": { "$ref": "#/$defs/keyId" },
        "algorithm": { "const": "Ed25519" },
        "encodedPublicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "state": { "enum": ["ACTIVE", "VERIFY_ONLY", "DISABLED", "REVOKED"] },
        "providerKeyVersion": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    }
  }
}
