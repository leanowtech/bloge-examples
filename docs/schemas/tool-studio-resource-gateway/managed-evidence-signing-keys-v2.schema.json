{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/managed-evidence-signing-keys-v2.schema.json",
  "title": "Resource Gateway Managed Evidence Signing Keys v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "expiresAt", "activeKeyId", "keys",
    "policyCompleteness", "lifecycleEvents"],
  "properties": {
    "schemaVersion": {"const": "resourceGateway.managedEvidenceSigningKeys.v2"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "activeKeyId": {"$ref": "#/$defs/keyId"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/key"}
    },
    "policyCompleteness": {"enum": ["COMPLETE", "CURRENT_STATE_ONLY"]},
    "lifecycleEvents": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/lifecycleEvent"}
    }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "encodedPublicKey", "createdAt", "state",
        "providerKeyVersion", "notBefore", "notAfter"],
      "properties": {
        "keyId": {"$ref": "#/$defs/keyId"},
        "algorithm": {"const": "Ed25519"},
        "encodedPublicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "state": {"enum": ["ACTIVE", "VERIFY_ONLY", "DISABLED", "REVOKED"]},
        "providerKeyVersion": {"type": "string", "minLength": 1, "maxLength": 255},
        "notBefore": {"type": "string", "format": "date-time"},
        "notAfter": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "eventId", "keyId", "type", "occurredAt", "effectiveAt",
        "revocationMode", "invalidFrom", "reasonCode"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "eventId": {"type": "string", "minLength": 1, "maxLength": 255},
        "keyId": {"$ref": "#/$defs/keyId"},
        "type": {"enum": ["CREATED", "ACTIVATED", "RETIRED", "DISABLED", "REVOKED",
          "COMPROMISE_DECLARED"]},
        "occurredAt": {"type": "string", "format": "date-time"},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "revocationMode": {"type": "string", "enum": ["", "PROSPECTIVE", "RETROACTIVE"]},
        "invalidFrom": {"type": ["string", "null"], "format": "date-time"},
        "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"}
      }
    }
  }
}
