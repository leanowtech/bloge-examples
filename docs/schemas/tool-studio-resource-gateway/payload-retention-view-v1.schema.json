{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloge.dev/schemas/tool-studio-resource-gateway/payload-retention-view-v1.schema.json",
  "title": "Tool Studio Resource Gateway Payload Retention View v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "events"],
  "properties": {
    "schemaVersion": { "const": "toolStudio.resourceGateway.payloadRetentionView.v1" },
    "status": { "$ref": "payload-replay-bundle-v2.schema.json#/$defs/status" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "payload-replay-bundle-v2.schema.json#/$defs/event" }
    }
  }
}
