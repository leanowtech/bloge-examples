/// Long-running patient consent collection with an absolute deadline.
///
/// Before a scheduled procedure, the hospital must receive the patient's signed
/// consent form.  The workflow sends the form and then suspends until either:
///   (a) the patient submits the signed form (signal received), or
///   (b) the admission deadline passes (cron/deadline timer fires).
///
/// Key DSL concepts demonstrated:
///   wait <id> = deadline("...") after <node>
///                      — deadline-based timer: fires at a specific ISO-8601 instant
///                        rather than a relative duration; useful for calendar-driven
///                        processes where the hard cut-off is a known business date
///   signal_key         — key that the consent portal calls to resume (patient signs
///                        online and the portal POSTs to a resume endpoint)
///   on_timeout         — payload injected when the deadline passes without consent;
///                        the downstream branch handles rescheduling or cancellation
///
/// Lifecycle:
///   1. execute()        → graph suspends at waitConsent
///   2. Patient signs    → portal POSTs; handler calls signal(executionId, "waitConsent", data)
///                        → save NodeCheckpoint for "waitConsent" then call resume()
///   3. OR deadline hits → InMemoryTimerService fires → signal() called automatically
///   4. resume()         → branch routes to proceedWithProcedure or reschedule
///
/// Context variables:
///   ctx.patientId      — patient medical record number
///   ctx.procedureId    — scheduled procedure identifier
///   ctx.procedureDate  — ISO-8601 date of the procedure (used by surrounding systems to choose the deadline)
graph patientConsentWait {

  /// Retrieve patient demographics and procedure details from the EHR.
  node loadPatientRecord : LoadPatientRecordOperator {
    input {
      patientId   = ctx.patientId
      procedureId = ctx.procedureId
    }
    timeout = 5s
  }

  /// Generate a personalised consent form PDF and store it in the document vault.
  node generateConsentForm : GenerateConsentFormOperator {
    depends_on = [loadPatientRecord]
    input {
      patientId   = ctx.patientId
      procedureId = ctx.procedureId
      patient     = loadPatientRecord.output
    }
    timeout = 10s
  }

  /// Send the consent form link to the patient via email and SMS.
  node sendConsentRequest : SendConsentRequestOperator {
    depends_on = [generateConsentForm]
    input {
      patientId  = ctx.patientId
      formUrl    = generateConsentForm.output.formUrl
      email      = loadPatientRecord.output.email
      phone      = loadPatientRecord.output.phone
    }
  }

  /// Suspend until the patient signs (signal) OR the admission deadline passes.
  ///
  /// deadline("...") fires at the ISO-8601 instant embedded in the DSL;
  /// the engine converts it to a TimerSpec with type=DEADLINE and schedules it through
  /// InMemoryTimerService (or any pluggable TimerService implementation).
  ///
  /// When the patient signs online, the consent portal calls:
  ///   engine.signal(executionId, "waitConsent", { consentStatus: "signed", signedAt: "..." })
  /// followed by checkpointStore.saveNodeCheckpoint(...) and engine.resume().
  wait waitConsent = deadline("2099-12-31T23:59:59Z") after sendConsentRequest {
    signal_key = ctx.patientId
    on_timeout {
      consentStatus = "not-received"
      reason        = "Patient did not sign before the admission deadline"
    }
  }

  /// Branch on consent outcome.
  branch on waitConsent.output.consentStatus {
    "signed"    -> proceedWithProcedure
    otherwise   -> rescheduleProcedure
  }

  /// Confirm the OR booking and notify surgical team.
  node proceedWithProcedure : ProceedWithProcedureOperator {
    depends_on = [waitConsent]
    input {
      patientId   = ctx.patientId
      procedureId = ctx.procedureId
      signedAt    = waitConsent.output.signedAt
    }
  }

  /// Cancel the OR slot and place the patient back on the waitlist.
  node rescheduleProcedure : RescheduleProcedureOperator {
    depends_on = [waitConsent]
    input {
      patientId   = ctx.patientId
      procedureId = ctx.procedureId
      reason      = waitConsent.output.reason
    }
  }
}
