/// Voice tutoring: iterative pronunciation coaching loop with carry state and convergence condition.
///
/// Demonstrates the loop construct — the only way in bloge DSL to express repeated execution
/// with evolving state; suitable for any adaptive, feedback-driven voice workflow.
///
/// Key DSL concepts demonstrated:
///   loop <name> { }     — repeats the inner sub-graph up to max_iterations times;
///                         the engine checks the until condition after every iteration and
///                         exits early when it evaluates to true
///   max_iterations      — hard upper bound on iteration count; protects against infinite loops
///   delay = Ns          — minimum wait between iterations; gives the student time to
///                         listen to the TTS feedback before the next recording starts
///   depends_on on loop  — the loop starts only after pronunciationScoring completes
///   loopIteration       — built-in counter (0-based) injected into every inner-node input;
///                         read it like any other field: iteration = loopIteration
///   carry { }           — state that is forwarded from the current iteration to the next;
///                         fields are injected into the inner ctx as ctx.__carry__.<key>;
///                         in this example: attempts and lastScore accumulate across rounds
///   until <expr>        — convergence predicate evaluated after each iteration completes;
///                         the loop exits when generateFeedback.output.suggestedScore >= 0.8,
///                         meaning a near-perfect score was achieved
///   <loop>.output.<node>.<field> — dot-path to access the last iteration's inner-node output
///                                  from nodes downstream of the loop
///
/// Context variables:
///   studentId    — learner identifier for report generation
///   referenceId  — pronunciation reference model identifier
///   targetPhrase — the phrase the student is practicing (e.g., "The quick brown fox")
///   language     — BCP-47 language code for TTS feedback delivery
graph voiceTutoring {

  /// Captures student's spoken response.
  stream node audioCapture : AudioCapture {
    buffer = 64
  }

  /// Transcribes audio to text for pronunciation analysis.
  stream node speechToText : SpeechToText {
    input {
      audio = audioCapture.output
    }
    buffer = 32
  }

  /// Scores the student's pronunciation accuracy against the reference phrase.
  /// Returns { transcript, score [0..1], errors[] } used by the loop as the
  /// initial baseline; carry.lastScore seeds the first loop iteration.
  node pronunciationScoring : PronunciationScorer {
    depends_on = [speechToText]
    input {
      transcript  = speechToText.output
      referenceId = ctx.referenceId
      targetPhrase = ctx.targetPhrase
    }
    timeout = 5s
  }

  /// Iterative coaching loop: generate feedback → speak it aloud → check score.
  /// Runs up to 3 rounds with a 2-second pause between rounds (delay = 2s).
  /// Exits early if the student's projected score reaches 0.8 or above.
  loop feedbackLoop {
    max_iterations = 3
    delay = 2s
    depends_on = [pronunciationScoring]

    /// Generates a targeted coaching message based on the current score and iteration.
    /// Reads iteration = loopIteration (built-in counter) and
    ///       score     = pronunciationScoring.output.score (initial baseline from pre-loop node).
    /// Returns { feedbackText, suggestedScore } — suggestedScore is used in the until condition.
    node generateFeedback : FeedbackGenerator {
      input {
        score        = pronunciationScoring.output.score
        transcript   = pronunciationScoring.output.transcript
        targetPhrase = ctx.targetPhrase
        iteration    = loopIteration
      }
    }

    /// Converts the coaching text to speech so the student hears the feedback.
    /// Depends on generateFeedback so TTS starts after the message is composed.
    node textToSpeech : TtsOperator {
      depends_on = [generateFeedback]
      input {
        text     = generateFeedback.output.feedbackText
        language = ctx.language
      }
    }

    /// Carry state passed into the next iteration as ctx.__carry__.
    /// attempts  — cumulative round count (mirrors loopIteration for reporting)
    /// lastScore — most recent score so inner nodes can show progress deltas
    carry {
      attempts:  loopIteration
      lastScore: pronunciationScoring.output.score
    }

    /// Exit condition: loop stops early when the projected score hits 0.8.
    /// Evaluated after each full iteration (generateFeedback + textToSpeech complete).
    until pronunciationScoring.output.score >= 0.8
  }

  /// Generates a final session report for the student after the loop finishes.
  /// feedbackLoop.output.generateFeedback.* navigates into the last iteration's
  /// generateFeedback output to extract the final score and iteration count.
  node generateReport : SessionReportGenerator {
    depends_on = [feedbackLoop]
    input {
      studentId    = ctx.studentId
      targetPhrase = ctx.targetPhrase
      finalScore   = feedbackLoop.output.generateFeedback.suggestedScore
      iterations   = feedbackLoop.output.generateFeedback.iteration
    }
  }
}
