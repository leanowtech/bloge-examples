<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.leanowtech.bloge</groupId>
    <artifactId>bloge-examples</artifactId>
    <version>0.3.1</version>

    <name>BLOGE Examples</name>
    <description>Example orchestration graphs</description>

    <properties>
        <bloge.version>0.3.1</bloge.version>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.11.4</junit.version>
        <jmh.version>1.37</jmh.version>
        <spring-boot.version>3.4.2</spring-boot.version>
        <micrometer.version>1.5.0-M1</micrometer.version>
        <micrometer-tracing.version>1.5.0-M1</micrometer-tracing.version>
        <opentelemetry.version>1.46.0</opentelemetry.version>
        <slf4j.version>2.0.16</slf4j.version>
        <mybatis-plus.version>3.5.11</mybatis-plus.version>
        <flyway.version>11.5.0</flyway.version>
        <jackson.version>2.18.2</jackson.version>
        <jacoco.version>0.8.14</jacoco.version>
        <maven.enforcer.version>3.5.0</maven.enforcer.version>
        <extra.enforcer.rules.version>1.8.0</extra.enforcer.rules.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
        <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
        <checkstyle.version>13.3.0</checkstyle.version>
        <spotbugs.maven.plugin.version>4.9.8.2</spotbugs.maven.plugin.version>
        <minimum.java.version>25</minimum.java.version>
        <minimum.maven.version>3.9.0</minimum.maven.version>
        <jacoco.check.skip>true</jacoco.check.skip>
        <jacoco.check.line.minimum>0.55</jacoco.check.line.minimum>
        <jacoco.check.branch.minimum>0.40</jacoco.check.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-core</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-dsl</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-core-ext</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-durable</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-common-operators</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-spring</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-metrics-otel</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-bpmn-transformer</artifactId>
            <version>${bloge.version}</version>
        </dependency>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-lint</artifactId>
            <version>${bloge.version}</version>
        </dependency>

        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-test</artifactId>
            <version>${bloge.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>1.16.3</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <version>1.6.3</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>aopalliance</groupId>
                    <artifactId>aopalliance</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>1.59.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <excludes>
                                <exclude>com/leanowtech/bloge/examples/integration/spring/**/*.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-spring-integration-java21</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>21</release>
                            <compilerArgs combine.self="override"/>
                            <includes>
                                <include>com/leanowtech/bloge/examples/integration/spring/**/*.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>bloge-plugin-example</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.leanowtech.bloge</groupId>
                        <artifactId>bloge-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>export-example-metadata</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>export-metadata</goal>
                                </goals>
                                <configuration>
                                    <packages>
                                        <package>com.leanowtech.bloge.examples.integration.maven</package>
                                    </packages>
                                    <outputFile>${project.build.directory}/bloge-examples/operator-metadata.json</outputFile>
                                    <includeSpringOperators>true</includeSpringOperators>
                                </configuration>
                            </execution>
                            <execution>
                                <id>lint-example-dsl</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>lint</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${project.basedir}/src/main/resources/bloge/integration/plugin</sourceDirectory>
                                    <configFile>${project.basedir}/plugin-example.blogerc.json</configFile>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
