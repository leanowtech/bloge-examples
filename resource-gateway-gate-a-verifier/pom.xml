<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.leanowtech.bloge</groupId>
    <artifactId>resource-gateway-gate-a-verifier</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BLOGE Resource Gateway Gate A Archive Verifier</name>
    <description>
        Standalone ZIP/JAR archive kernel for A1.3-02 Gate A verification.
        Standalone implementation; no Spring Boot, no business runtime dependencies.
    </description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.18.2</jackson.version>
        <networknt.version>2.0.4</networknt.version>
        <ethlo-time.version>1.14.0</ethlo-time.version>
        <slf4j.version>2.0.17</slf4j.version>
    </properties>

    <dependencies>
        <!-- Jackson 2.18.2 databind: core and annotations transitively included -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- networknt JSON Schema Validator 2.0.4 (Authority-allowed) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${networknt.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- com.ethlo.time:itu 1.14.0 (Authority-allowed) -->
        <dependency>
            <groupId>com.ethlo.time</groupId>
            <artifactId>itu</artifactId>
            <version>${ethlo-time.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- slf4j-api 2.0.17 (Authority-allowed) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- slf4j-nop 2.0.17 (Authority-allowed) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5: test scope only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <gate.a.authority.path>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/gate-a-protocol-authority-v1.json</gate.a.authority.path>
                        <gate.a.dependency.jars>${project.build.directory}/dependency-jars</gate.a.dependency.jars>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
                Copies the 7 Authority-allowed nested JAR dependencies to
                target/dependency-jars/ so RealVerifierFixtureFactory can load
                their raw bytes via classpath resources without hardcoding paths.
                Runs during the validate phase so artifacts are available before
                any test-compile or test execution.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-nested-jar-fixtures</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency-jars</outputDirectory>
                            <includeArtifactIds>
                                jackson-databind,
                                jackson-core,
                                jackson-annotations,
                                json-schema-validator,
                                itu,
                                slf4j-api,
                                slf4j-nop
                            </includeArtifactIds>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Top-level plugin declaration: rules live here so
                'mvn enforcer:enforce' fires them regardless of profile.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <rules>
                        <requireProperty>
                            <property>gate.a.slice</property>
                            <message>
                                gate-a-verifier requires -Dgate.a.slice=&lt;value&gt;
                            </message>
                            <regex>^A1\.3$</regex>
                            <regexMessage>
                                gate.a.slice must be exactly A1.3, got: ${org.apache.maven.enforcer.rule.EnforceRule.value}
                            </regexMessage>
                        </requireProperty>
                        <bannedDependencies>
                            <excludes combine.children="append">
                                <exclude>com.leanowtech.bloge:bloge-resource-gateway-test-kit</exclude>
                                <exclude>com.leanowtech.bloge:resource-gateway-examples</exclude>
                                <exclude>com.leanowtech.bloge:bloge-resource-gateway-runtime</exclude>
                                <exclude>com.leanowtech.bloge:bloge-resource-gateway-harness</exclude>
                                <exclude>com.leanowtech.bloge:bloge-resource-gateway-admission</exclude>
                            </excludes>
                            <message>
                                Banned business artifact found in dependency tree.
                                Archive kernel must not depend on runtime or test-kit artifacts.
                            </message>
                        </bannedDependencies>
                    </rules>
                    <fail>true</fail>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Profile gate-a-verifier: activates on -Dgate.a.slice=A1.3.
        Adds the execution block that binds to the validate phase, so
        any lifecycle goal (test, verify, ...) that runs after validate
        automatically enforces the rules.  The plugin-level declaration
        above makes 'mvn enforcer:enforce' work directly in any context.
    -->
    <profiles>
        <profile>
            <id>gate-a-verifier</id>
            <activation>
                <property>
                    <name>gate.a.slice</name>
                    <value>A1.3</value>
                </property>
            </activation>
            <properties>
                <gate.a.slice>A1.3</gate.a.slice>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.4.1</version>
                        <!-- No <configuration> here — rules are inherited from the
                             top-level plugin declaration above.  Only <executions>
                             is needed to bind the goal to the validate phase. -->
                        <executions>
                            <execution>
                                <id>enforce-gate-a</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <phase>validate</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Profile gate-a-a1-3-development-binding: specialized development gate binding.
            NOT auto-activated; explicitly enabled via -Pgate-a-a1-3-development-binding.
            Enforcer: exact testSet property; absolute binding/repo path.
            RequireFilesExist removed; antrun type=file/type=dir is the validate-phase
            existence+type authority (validate-binding-is-file, validate-repo-root-is-dir).
            Surefire: OVERRIDE default-test to run ONLY R03DevelopmentGate*Test (18 tests).
            Failsafe: integration-test and verify, only NegativeProcessIT (5 tests).
        -->
        <profile>
            <id>gate-a-a1-3-development-binding</id>
            <properties>
                <gate.a.slice>A1.3</gate.a.slice>
            </properties>
            <build>
                <plugins>
                    <!--
                        Consolidated Enforcer: one plugin, three executions.
                        Removed RequireFilesExist rules entirely; antrun type=file/type=dir
                        (validate-binding-is-file, validate-repo-root-is-dir) is the
                        validate-phase existence+type authority.
                        NOTE: Each <rules combine.self="override"> prevents inheritance of
                        the top-level enforcer's gate.a.slice requireProperty, which would
                        otherwise cause duplicate-rule failures in all three executions.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <!-- gate.a.testSet must be exactly A1_3_ROLE_PACKAGING -->
                            <execution>
                                <id>enforce-exact-testset</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <!-- Override prevents top-level gate.a.slice rule from leaking in -->
                                    <rules combine.self="override">
                                        <requireProperty>
                                            <property>gate.a.testSet</property>
                                            <regex>^A1_3_ROLE_PACKAGING$</regex>
                                            <regexMessage>
                                                gate.a.testSet must be exactly A1_3_ROLE_PACKAGING
                                            </regexMessage>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                            <!-- gate.a.binding.path must be an absolute path (starts with /) -->
                            <execution>
                                <id>enforce-absolute-binding-path</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <!-- Override prevents top-level gate.a.slice rule from leaking in -->
                                    <rules combine.self="override">
                                        <requireProperty>
                                            <property>gate.a.binding.path</property>
                                            <regex>^/.+</regex>
                                            <regexMessage>
                                                gate.a.binding.path must be an absolute path starting with /: ${gate.a.binding.path}
                                            </regexMessage>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                            <!-- gate.a.repo.root must be an absolute path (starts with /) -->
                            <execution>
                                <id>enforce-absolute-repo-root</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <!-- Override prevents top-level gate.a.slice rule from leaking in -->
                                    <rules combine.self="override">
                                        <requireProperty>
                                            <property>gate.a.repo.root</property>
                                            <regex>^/.+</regex>
                                            <regexMessage>
                                                gate.a.repo.root must be an absolute path starting with /: ${gate.a.repo.root}
                                            </regexMessage>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Antrun 3.1.0 validate: native Ant available type=file/type=dir, NO shell exec.
                         Antrun evaluates ${property} from Maven property stack natively. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>validate-binding-is-file</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <target>
                                        <fail message="gate.a.binding.path is not a regular file: ${gate.a.binding.path}">
                                            <condition>
                                                <not>
                                                    <available file="${gate.a.binding.path}" type="file"/>
                                                </not>
                                            </condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>validate-repo-root-is-dir</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <target>
                                        <fail message="gate.a.repo.root is not a directory: ${gate.a.repo.root}">
                                            <condition>
                                                <not>
                                                    <available file="${gate.a.repo.root}" type="dir"/>
                                                </not>
                                            </condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Surefire: OVERRIDE default-test execution to run ONLY R03DevelopmentGate*Test -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.2</version>
                        <executions>
                            <execution>
                                <id>default-test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                                <configuration>
                                    <includes>
                                        <include>**/R03DevelopmentGate*Test.java</include>
                                    </includes>
                                    <excludes combine.self="override"/>
                                    <forkCount>1</forkCount>
                                    <reuseForks>false</reuseForks>
                                    <systemPropertyVariables>
                                        <gate.a.authority.path>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/gate-a-protocol-authority-v1.json</gate.a.authority.path>
                                        <gate.a.dependency.jars>${project.build.directory}/dependency-jars</gate.a.dependency.jars>
                                        <gate.a.binding.path>${gate.a.binding.path}</gate.a.binding.path>
                                        <gate.a.repo.root>${gate.a.repo.root}</gate.a.repo.root>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Failsafe: integration-test and verify executions for NegativeProcessIT -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <executions>
                            <execution>
                                <id>integration-test</id>
                                <goals>
                                    <goal>integration-test</goal>
                                </goals>
                                <phase>integration-test</phase>
                                <configuration>
                                    <includes>
                                        <include>**/R03DevelopmentGateNegativeProcessIT.java</include>
                                    </includes>
                                    <forkCount>1</forkCount>
                                    <reuseForks>false</reuseForks>
                                    <systemPropertyVariables>
                                        <gate.a.authority.path>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/gate-a-protocol-authority-v1.json</gate.a.authority.path>
                                        <gate.a.dependency.jars>${project.build.directory}/dependency-jars</gate.a.dependency.jars>
                                        <gate.a.binding.path>${gate.a.binding.path}</gate.a.binding.path>
                                        <gate.a.repo.root>${gate.a.repo.root}</gate.a.repo.root>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                                <phase>verify</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
