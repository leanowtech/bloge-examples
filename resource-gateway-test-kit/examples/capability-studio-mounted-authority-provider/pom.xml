<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.leanowtech.bloge</groupId>
    <artifactId>bloge-capability-studio-mounted-authority-provider</artifactId>
    <version>1.0.0</version>

    <name>BLOGE Capability Studio mounted authority provider</name>
    <description>Reference formal ServiceLoader provider with immutable authority mounts and durable lease state.</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.1</assertj.version>
        <test-kit.version>1.0.0</test-kit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.leanowtech.bloge</groupId>
            <artifactId>bloge-resource-gateway-test-kit</artifactId>
            <version>${test-kit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-resolved-test-kit-artifacts</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.leanowtech.bloge</groupId>
                                    <artifactId>bloge-resource-gateway-test-kit</artifactId>
                                    <version>${test-kit.version}</version>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/resolved-test-kit</outputDirectory>
                                    <destFileName>bloge-resource-gateway-test-kit-${test-kit.version}.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.leanowtech.bloge</groupId>
                                    <artifactId>bloge-resource-gateway-test-kit</artifactId>
                                    <version>${test-kit.version}</version>
                                    <classifier>cli</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/resolved-test-kit</outputDirectory>
                                    <destFileName>bloge-resource-gateway-test-kit-${test-kit.version}-cli.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-test-only-crash-instrumentation</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/src/test/instrumentation/CrashInstrumentationGenerator.java</argument>
                                <argument>generate</argument>
                                <argument>${project.basedir}</argument>
                                <argument>${project.build.directory}/generated-crash-sources</argument>
                                <argument>${project.build.directory}/crash-instrumented-classes</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>compile-test-only-crash-instrumentation</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/crash-instrumented-classes"/>
                                <javac destdir="${project.build.directory}/crash-instrumented-classes"
                                       release="${java.version}"
                                       encoding="${project.build.sourceEncoding}"
                                       includeantruntime="false">
                                    <src path="${project.build.directory}/generated-crash-sources/src/main/java"/>
                                    <src path="${project.basedir}/src/test/instrumentation"/>
                                    <classpath>
                                        <pathelement location="${project.build.outputDirectory}"/>
                                        <path refid="maven.test.classpath"/>
                                    </classpath>
                                    <exclude name="CrashInstrumentationGenerator.java"/>
                                </javac>
                                <exec executable="${java.home}/bin/java" failonerror="true">
                                    <arg value="${project.basedir}/src/test/instrumentation/CrashInstrumentationGenerator.java"/>
                                    <arg value="finalize"/>
                                    <arg value="${project.basedir}"/>
                                    <arg value="${project.build.directory}/generated-crash-sources"/>
                                    <arg value="${project.build.directory}/crash-instrumented-classes"/>
                                </exec>
                                <copy todir="${project.build.directory}/crash-instrumented-classes/META-INF/bloge">
                                    <fileset dir="${project.build.directory}/generated-crash-sources/META-INF/bloge"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/child-harness-classes"/>
                                <copy todir="${project.build.directory}/child-harness-classes">
                                    <fileset dir="${project.build.testOutputDirectory}"/>
                                </copy>
                                <copy todir="${project.build.directory}/child-harness-classes"
                                      overwrite="true">
                                    <fileset dir="${project.build.directory}/crash-instrumented-classes"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>provider-runtime-under-test</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>runtime-under-test</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>child-harness-under-test</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>child-harness</classifier>
                            <classesDirectory>${project.build.directory}/child-harness-classes</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>verify-public-api-documentation</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                        <configuration>
                            <doclint>all</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <encoding>${project.build.sourceEncoding}</encoding>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
