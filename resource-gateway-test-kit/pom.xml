<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.leanowtech.bloge</groupId>
    <artifactId>bloge-resource-gateway-test-kit</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BLOGE Resource Gateway Test Kit</name>
    <description>Standalone HTTP client and JUnit adapter for governed Resource Gateway tests.</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.11.4</junit.version>
        <opentest4j.version>1.3.0</opentest4j.version>
        <json-schema-validator.version>2.0.4</json-schema-validator.version>
        <slf4j.version>2.0.17</slf4j.version>
        <assertj.version>3.27.1</assertj.version>
        <testing.protocol.version>bloge.testing.v1</testing.protocol.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opentest4j</groupId>
            <artifactId>opentest4j</artifactId>
            <version>${opentest4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-yaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>../docs/schemas/resource-gateway-testing</directory>
                <targetPath>schemas/resource-gateway-testing</targetPath>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>../docs/schemas/tool-studio-resource-gateway</directory>
                <targetPath>schemas/tool-studio-resource-gateway</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>semantic-correctness-workbook-bundle-v1.schema.json</include>
                    <include>governance-gate-result-v3.schema.json</include>
                    <include>evidence-verification-key-set-v1.schema.json</include>
                    <include>evidence-key-set-trust-publication-v1.schema.json</include>
                    <include>evidence-key-set-trust-bundle-v1.schema.json</include>
                    <include>package-registry-ingest-bundle-v1.schema.json</include>
                    <include>package-registry-ingest-bundle-v1.fixture.json</include>
                    <include>domain-capability-package-governance-projection-v1.schema.json</include>
                    <include>domain-capability-package-governance-projection-v1.fixture.json</include>
                    <include>domain-capability-package-governance-view-v1.schema.json</include>
                    <include>package-governance-projection-receipt-v1.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../docs/schemas/resource-gateway-mirror</directory>
                <targetPath>schemas/resource-gateway-mirror</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.schema.json</include>
                    <include>*.fixture.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../docs/schemas/resource-gateway-business-mirror</directory>
                <targetPath>schemas/resource-gateway-business-mirror</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.schema.json</include>
                    <include>*.fixture.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../docs/schemas/resource-gateway-capability-studio</directory>
                <targetPath>schemas/resource-gateway-capability-studio</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../docs/acceptance/capability-studio/acceptance-engine-v1</directory>
                <targetPath>acceptance-engine-v1</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>builtin-contract-catalog.json</include>
                    <include>builtin-compiler-profile-formal-v1.json</include>
                    <include>rg-cs-felt-v1.acceptance.plan.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>../docs/schemas/resource-gateway-capability-studio-a1</directory>
                <targetPath>schemas/resource-gateway-capability-studio-a1</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.schema.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-a1-protocol-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/a1-protocol-classes/schemas/resource-gateway-capability-studio-a1</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../docs/schemas/resource-gateway-capability-studio-a1</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>*.schema.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-evidence-cli-build-identity</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/src/build/CapabilityStudioEvidenceCliBuildIdentityGenerator.java</argument>
                                <argument>${project.basedir}/src/main/java/com/leanowtech/bloge/gateway/testkit/CapabilityStudioExecutionLeaseEvidenceCli.java</argument>
                                <argument>${project.build.outputDirectory}/com/leanowtech/bloge/gateway/testkit/CapabilityStudioExecutionLeaseEvidenceCli.class</argument>
                                <argument>${project.build.outputDirectory}/META-INF/bloge/capability-studio-execution-lease-evidence-cli-build-identity-v1.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-step0</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/src/build/CapabilityStudioA1ReleaseArchiveVerifier.java</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}.jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-cli.jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-a1-protocol.jar</argument>
                                <argument>${project.basedir}/../docs/schemas/resource-gateway-capability-studio</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>verify-public-api-documentation</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                        <configuration>
                            <doclint>all</doclint>
                            <failOnWarnings>true</failOnWarnings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Resource-Gateway-Testing-Protocol>${testing.protocol.version}</Resource-Gateway-Testing-Protocol>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>a1-protocol-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>a1-protocol</classifier>
                            <classesDirectory>${project.build.directory}/a1-protocol-classes</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>cli</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.leanowtech.bloge.gateway.testkit.ResourceGatewaySuiteCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Gate A Candidate Selective Archive Profile -->
    <!-- Activated with: mvn -Pgate-a-candidate -Dgate.a.slice=A1.1 clean verify -->
    <!-- Default build (jar, cli, a1-protocol) is NOT affected -->
    <profiles>
        <profile>
            <id>gate-a-candidate</id>
            <properties>
                <gate.a.candidate.output>${project.build.directory}/bloge-resource-gateway-test-kit-${project.version}-gate-a-candidate.jar</gate.a.candidate.output>
            </properties>
            <build>
                <!-- Add src/build as additional source directory -->
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>add-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/build</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>attach-gate-a-candidate</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attach-artifact</goal>
                                </goals>
                                <configuration>
                                    <artifacts>
                                        <artifact>
                                            <type>jar</type>
                                            <classifier>gate-a-candidate</classifier>
                                            <file>${gate.a.candidate.output}</file>
                                        </artifact>
                                    </artifacts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Run packager during process-classes -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-gate-a-candidate</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>com.leanowtech.bloge.gateway.testkit.CapabilityStudioGateACandidatePackager</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>${gate.a.candidate.output}</argument>
                                        <argument>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/gate-a-protocol-authority-v1.json</argument>
                                        <argument>${settings.localRepository}</argument>
                                        <argument>${project.basedir}/../docs/schemas/resource-gateway-capability-studio</argument>
                                        <argument>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/canonicalization</argument>
                                        <argument>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/compiled</argument>
                                        <argument>${gate.a.slice}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-gate-a-candidate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>com.leanowtech.bloge.gateway.testkit.CapabilityStudioGateACandidateArchiveVerifier</argument>
                                        <argument>${gate.a.candidate.output}</argument>
                                        <argument>${project.basedir}/../docs/acceptance/capability-studio/gate-a-wire-v1/protocol-compiler/gate-a-protocol-authority-v1.json</argument>
                                        <argument>${project.build.directory}/verify-working</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
