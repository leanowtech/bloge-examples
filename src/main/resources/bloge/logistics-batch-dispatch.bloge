/// Assigns delivery routes to a batch of parcels then polls until all are delivered.
///
/// Fetches all pending parcels for a warehouse, processes each in parallel through route
/// planning and dispatch using foreach, then enters a timed polling loop to monitor
/// aggregate delivery status until every parcel in the batch is confirmed delivered.
///
/// Key DSL concepts demonstrated:
///   foreach              — processes each parcel in parallel; parcel and idx are loop variables
///   depends_on = [a, b]  — pollAllDispatched loop waits for the foreach to complete (cross-construct fan-in)
///   loop                 — repeats checkAllStatus up to max_iterations with a delay between rounds
///   until <expr>         — loop exits early when allDelivered is true
///   loopIteration        — built-in 0-based counter passed to checkAllStatus for progress tracking
///
/// Context variables:
///   ctx.warehouseId — identifier of the warehouse whose parcels are being dispatched
///   ctx.batchId     — identifier of the dispatch batch used when querying aggregate status
graph logisticsBatchDispatch {

  /// Fetches pending parcels for dispatch
  node fetchParcels : ParcelFetcherOperator {
    input { warehouseId = ctx.warehouseId }
  }

  /// foreach: assign delivery routes to each parcel in parallel
  /// parcel — the current parcel object
  /// idx — the parcel's position in the batch
  foreach assignRoutes : (parcel, idx) in fetchParcels.output.parcels {
    /// Plans the optimal delivery route for the current parcel
    node planRoute : RoutePlannerOperator {
      input { parcel = parcel, index = idx }
    }
    /// Dispatches the parcel using the planned route; depends on planRoute completing first
    node dispatchParcel : ParcelDispatcherOperator {
      depends_on = [planRoute]
      input { parcel = parcel, route = planRoute.output }
    }
  }

  /// loop: poll dispatch status until all parcels are delivered
  /// Demonstrates foreach output flowing into a loop via depends_on
  loop pollAllDispatched {
    max_iterations = 30
    delay = 10s
    depends_on = [assignRoutes]
    /// Queries aggregate delivery status for the batch; loopIteration tracks the poll round number
    node checkAllStatus : BatchStatusCheckerOperator {
      input {
        batchId   = ctx.batchId
        iteration = loopIteration
      }
    }
    until checkAllStatus.output.allDelivered == true
  }

  /// Final dispatch report
  node dispatchReport : DispatchReportOperator {
    depends_on = [pollAllDispatched]
    input {
      batchStatus = pollAllDispatched.output.checkAllStatus
      routeResults = assignRoutes.output
    }
  }
}
